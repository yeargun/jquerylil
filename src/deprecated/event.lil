extern JsValue arguments;
extern JsValue this;
import { jQuery, each } from "../core";
import { fn } from "../event";

JsValue fnBind(JsValue types, JsValue data, JsValue fn) {
  return JS.invoke(this, "on", types, null, data, fn);
}

JsValue fnUnbind(JsValue types, JsValue fn) {
  return JS.invoke(this, "off", types, null, fn);
}

JsValue fnDelegate(JsValue selector, JsValue types, JsValue data, JsValue fn) {
  return JS.invoke(this, "on", types, selector, data, fn);
}

JsValue fnUndelegate(JsValue selector, JsValue types, JsValue fn) {
  // ( namespace ) or ( selector, types [, fn] )
  return if (arguments.length == 1.0) {
    JS.invoke(this, "off", selector, "**")
  } else {
    JS.invoke(this, "off", types, JS.or(selector, "**"), fn)
  };
}

JsValue fnHover(JsValue fnOver, JsValue fnOut) {
  return JS.invoke(JS.invoke(this, "on", "mouseenter", fnOver), "on", "mouseleave", JS.or(fnOut, fnOver));
}

fn["bind"] = fnBind;
fn["unbind"] = fnUnbind;
fn["delegate"] = fnDelegate;
fn["undelegate"] = fnUndelegate;
fn["hover"] = fnHover;

each(
  JS.invoke(
    "blur focus focusin focusout resize scroll click dblclick " +
    "mousedown mouseup mousemove mouseover mouseout mouseenter mouseleave " +
    "change select submit keydown keypress keyup contextmenu",
    "split",
    " "
  ),
  (JsValue _i, JsValue name) => {
    // Handle event binding
    fn[name] = JS.methodRest((JsValue self, JsValue args) => {
      return if (args.length > 0.0) {
        JS.invoke(self, "on", name, null, args[0], args[1])
      } else {
        JS.invoke(self, "trigger", name)
      };
    });
    return JS.undefined();
  }
);

export { jQuery };
