import { jQuery, wrap } from "../core";
import { document } from "../var/document";

// Prevent auto-execution of scripts when no explicit dataType was provided.
JS.invoke(jQuery, "ajaxPrefilter", (JsValue s) => {
  if (s["crossDomain"].truthy()) {
    s["contents"]["script"] = false;
  }
  return JS.undefined();
});

// Install script dataType
JS.invoke(jQuery, "ajaxSetup", object {
  accepts: object {
    script: "text/javascript, application/javascript, application/ecmascript, application/x-ecmascript"
  },
  contents: object {
    script: new Regex("\\b(?:java|ecma)script\\b")
  },
  converters: object {
    "text script": (JsValue text) => {
      JS.invoke(jQuery, "globalEval", text);
      return text;
    }
  }
});

// Handle cache's special case and crossDomain
JS.invoke(jQuery, "ajaxPrefilter", "script", (JsValue s) => {
  if (JS.isUndefined(s["cache"])) {
    s["cache"] = false;
  }
  if (s["crossDomain"].truthy()) {
    s["type"] = "GET";
  }
  return JS.undefined();
});

// Bind script tag hack transport
JS.invoke(jQuery, "ajaxTransport", "script", (JsValue s) => {
  // This transport only deals with cross domain or forced-by-attrs requests
  if (s["crossDomain"].truthy() || s["scriptAttrs"].truthy()) {
    JsValue script = JS.undefined();
    JsValue callback = JS.undefined();
    return object {
      send: (JsValue _headers, JsValue complete) => {
        callback = (JsValue evt) => {
          JS.invoke(script, "remove");
          callback = null;
          if (evt.truthy()) {
            complete(if (JS.strictEqual(evt["type"], "error")) { 404.0 } else { 200.0 }, evt["type"]);
          }
          return JS.undefined();
        };
        JsValue attrs = JS.invoke(wrap("<script>"), "attr", JS.or(s["scriptAttrs"], JS.object()));
        JsValue props = JS.invoke(attrs, "prop", object { charset: s["scriptCharset"], src: s["url"] });
        script = JS.invoke(props, "on", "load error", callback);

        // Use native DOM manipulation to avoid our domManip AJAX trickery
        JS.invoke(document["head"], "appendChild", script[0]);
        return JS.undefined();
      },
      abort: () => {
        if (callback.truthy()) {
          callback();
        }
        return JS.undefined();
      }
    };
  }
  return JS.undefined();
});

export { jQuery };
