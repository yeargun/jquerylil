extern JsValue this;
import { jQuery, each, wrap } from "../core";
import { stripAndCollapse } from "../core/stripAndCollapse";
import { isFunction } from "../var/isFunction";
import { parseHTML } from "../core/parseHTML";

/**
 * Load a url into a page
 */
JsValue fnLoad(JsValue url, JsValue params, JsValue callback) {
  JsValue selector = JS.undefined();
  JsValue type = JS.undefined();
  JsValue response = JS.undefined();
  JsValue self = this;
  JsValue off = JS.invoke(url, "indexOf", " ");

  if (JS.greaterThan(off, -1.0)) {
    selector = stripAndCollapse(JS.assume(JS.invoke(url, "slice", off)));
    url = JS.invoke(url, "slice", 0.0, off);
  }

  // If it's a function
  if (isFunction(params)) {

    // We assume that it's the callback
    callback = params;
    params = JS.undefined();

  // Otherwise, build a param string
  } else if (params.truthy() && JS.typeOf(params) == "object") {
    type = "POST";
  }

  // If we have elements to modify, make the request
  if (JS.greaterThan(self["length"], 0.0)) {
    JsValue request = JS.invoke(jQuery, "ajax", object {
      url: url,

      // If "type" variable is undefined, then "GET" method will be used.
      // Make value of this field explicit since
      // user can override it through ajaxSetup method
      type: JS.or(type, "GET"),
      dataType: "html",
      data: params
    });
    JsValue afterDone = JS.invoke(request, "done", JS.staticRest((JsValue args) => {

      // Save response for use in complete callback
      response = args;

      JsValue responseText = args[0];
      JS.invoke(self, "html", if (selector.truthy()) {
        // If a selector was specified, locate the right elements in a dummy div
        // Exclude scripts to avoid IE 'Permission Denied' errors
        JS.invoke(JS.invoke(wrap("<div>"), "append", parseHTML(responseText, null, null)), "find", selector)
      } else {
        // Otherwise use the full result
        responseText
      });
      return JS.undefined();
    }));

    // If the request succeeds, this function gets "data", "status", "jqXHR"
    // but they are ignored because response was set above.
    // If it fails, this function gets "jqXHR", "status", "error"
    if (callback.truthy()) {
      JS.invoke(afterDone, "always", (JsValue jqXHR, JsValue status) => {
        each(self, (JsValue _i, JsValue el) => {
          JS.invoke(callback, "apply", el, JS.or(response, [jqXHR["responseText"], status, jqXHR]));
          return JS.undefined();
        });
        return JS.undefined();
      });
    }
  }

  return self;
}

jQuery["fn"]["load"] = fnLoad;

export { jQuery };
