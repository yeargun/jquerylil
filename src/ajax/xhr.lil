import { jQuery } from "../core";
import { support } from "../var/support";
import {
  newXMLHttpRequest,
  scheduleTimeoutMs
} from "../js-host.lil";

/*
 * Port of upstream ajax/xhr.js. The nested send handlers share `callback`
 * and `errorCallback` through ordinary lexical captures, as upstream does.
 */

enum XhrCb {
  Success,
  Abort,
  Error
}

jQuery["ajaxSettings"]["xhr"] = newXMLHttpRequest;

JsValue xhrSuccessStatus = object { "0": 200.0, "1223": 204.0 };
JsValue xhrProbe = JS.invoke(jQuery["ajaxSettings"], "xhr");
bool xhrSupported = xhrProbe.truthy();

support.cors = xhrSupported && JS.in("withCredentials", xhrProbe);
support.ajax = xhrSupported;

JS.invoke(jQuery, "ajaxTransport", (JsValue options) => {
  JsValue callback = JS.undefined();
  JsValue errorCallback = JS.undefined();

  if (support.cors || xhrSupported && !options["crossDomain"].truthy()) {
    return object {
      send: (JsValue headers, JsValue complete) => {
        JsValue xhr = JS.invoke(options, "xhr");

        JS.invoke(xhr, "open", options["type"], options["url"], options["async"], options["username"], options["password"]);

        if (options["xhrFields"].truthy()) {
          for (string i in options["xhrFields"]) {
            xhr[i] = options["xhrFields"][i];
          }
        }

        if (options["mimeType"].truthy() && xhr["overrideMimeType"].truthy()) {
          JS.invoke(xhr, "overrideMimeType", options["mimeType"]);
        }

        if (!options["crossDomain"].truthy() && !headers["X-Requested-With"].truthy()) {
          headers["X-Requested-With"] = "XMLHttpRequest";
        }

        for (string i in headers) {
          JS.invoke(xhr, "setRequestHeader", i, headers[i]);
        }

        func(XhrCb)->JsValue makeCallback = (XhrCb type) => {
          return () => {
            if (callback.truthy()) {
              callback = errorCallback = xhr["onload"] = xhr["onerror"] = xhr["onabort"] = xhr["ontimeout"] = xhr["onreadystatechange"] = null;

              if (type == XhrCb.Abort) {
                JS.invoke(xhr, "abort");
              } else if (type == XhrCb.Error) {
                if (JS.typeOf(xhr["status"]) != "number") {
                  complete(0.0, "error");
                } else {
                  complete(xhr["status"], xhr["statusText"]);
                }
              } else {
                complete(
                  JS.or(xhrSuccessStatus[xhr["status"]], xhr["status"]),
                  xhr["statusText"],
                  if (!JS.strictEqual(JS.or(xhr["responseType"], "text"), "text") || !(xhr["responseText"] is string)) {
                    object { binary: xhr["response"] }
                  } else {
                    object { text: xhr["responseText"] }
                  },
                  JS.invoke(xhr, "getAllResponseHeaders")
                );
              }
            }
            return JS.undefined();
          };
        };

        xhr["onload"] = makeCallback(XhrCb.Success);
        errorCallback = xhr["onerror"] = xhr["ontimeout"] = makeCallback(XhrCb.Error);

        if (!JS.isUndefined(xhr["onabort"])) {
          xhr["onabort"] = errorCallback;
        } else {
          xhr["onreadystatechange"] = () => {
            if (JS.strictEqual(xhr["readyState"], 4.0)) {
              scheduleTimeoutMs(() => {
                if (callback.truthy()) {
                  errorCallback();
                }
                return JS.undefined();
              }, 0.0);
            }
            return JS.undefined();
          };
        }

        callback = makeCallback(XhrCb.Abort);

        try {
          JS.invoke(xhr, "send", JS.or(JS.and(options["hasContent"], options["data"]), null));
        } catch (JsValue e) {
          if (callback.truthy()) {
            throw e;
          }
        }
        return JS.undefined();
      },

      abort: () => {
        if (callback.truthy()) {
          callback();
        }
        return JS.undefined();
      }
    };
  }
  return JS.undefined();
});

export { jQuery };
