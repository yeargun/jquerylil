import { jQuery, each, inArray, isPlainObject, wrap } from "./core";
import { Deferred } from "./deferred";
import { trigger } from "./event/trigger";
import { newCallbacksOnceMemory } from "./callbacks";
import { document } from "./var/document";
import { isFunction } from "./var/isFunction";
import { rnothtmlwhite } from "./var/rnothtmlwhite";
import { param } from "./serialize";
import { location } from "./ajax/var/location";
import { nextGuid } from "./ajax/var/nonce";
import { rquery } from "./ajax/var/rquery";
import { parseXML } from "./core/parseXML";
import {
  scheduleTimeoutMs,
  clearTimeoutId
} from "./js-host.lil";

/*
 * Port of upstream ajax.js. Per-request state lives in locals captured by the
 * jqXHR methods and by done(); jqXHR and the settings object stay plain
 * JavaScript objects because they are the public API.
 */

extern JsValue String;
extern JsValue JSON;

Regex r20 = new Regex("%20", "g");
Regex rhash = new Regex("#.*$");
Regex rantiCache = new Regex("([?&])_=[^&]*");
Regex rheaders = new Regex("^(.*?):[ \\t]*([^\\r\\n]*)$", "mg");
Regex rnoContent = new Regex("^(?:GET|HEAD)$");
Regex rprotocol = new Regex("^//");

JsValue prefilters = JS.object();
JsValue transports = JS.object();
string allTypes = "*/*";

JsValue originAnchor = JS.invoke(document, "createElement", "a");
originAnchor["href"] = location["href"];

JsValue addToPrefiltersOrTransports(JsValue structure) {
  return (JsValue dataTypeExpression, JsValue fn) => {
    if (!(dataTypeExpression is string)) {
      fn = dataTypeExpression;
      dataTypeExpression = "*";
    }
    if (isFunction(fn)) {
      JsValue dataTypes = JS.or(JS.invoke(JS.invoke(dataTypeExpression, "toLowerCase"), "match", rnothtmlwhite), JS.array());
      each(dataTypes, (JsValue _i, JsValue dataType) => {
        bool prepend = JS.strictEqual(dataType[0], "+");
        if (prepend) {
          dataType = JS.or(JS.invoke(dataType, "slice", 1.0), "*");
        }
        structure[dataType] = JS.or(structure[dataType], JS.array());
        structure[dataType][if (prepend) { "unshift" } else { "push" }](fn);
        return JS.undefined();
      });
    }
    return JS.undefined();
  };
}

JsValue inspectPrefiltersOrTransports(JsValue structure, JsValue options, JsValue originalOptions, JsValue jqXHR) {
  JsValue inspected = JS.object();
  bool seekingTransport = structure == transports;

  func(JsValue)->JsValue inspect = (JsValue _dataType) => JS.undefined();
  inspect = (JsValue dataType) => {
    JsValue selected = JS.undefined();
    inspected[dataType] = true;
    each(JS.or(structure[dataType], JS.array()), (JsValue _i, JsValue prefilterOrFactory) => {
      JsValue dataTypeOrTransport = prefilterOrFactory(options, originalOptions, jqXHR);
      if (dataTypeOrTransport is string && !seekingTransport && !inspected[dataTypeOrTransport].truthy()) {
        JS.invoke(options["dataTypes"], "unshift", dataTypeOrTransport);
        inspect(dataTypeOrTransport);
        return false;
      }
      if (seekingTransport) {
        selected = dataTypeOrTransport;
        return !selected.truthy();
      }
      return JS.undefined();
    });
    return selected;
  };

  return JS.or(inspect(options["dataTypes"][0]), JS.and(!inspected["*"].truthy(), inspect("*")));
}

JsValue ajaxExtend(JsValue target, JsValue src) {
  JsValue deep = JS.undefined();
  JsValue flatOptions = JS.or(jQuery["ajaxSettings"]["flatOptions"], JS.object());
  for (string key in src) {
    if (!JS.isUndefined(src[key])) {
      if (flatOptions[key].truthy()) {
        target[key] = src[key];
      } else {
        deep = JS.or(deep, JS.object());
        deep[key] = src[key];
      }
    }
  }
  if (deep.truthy()) {
    JS.invoke(jQuery, "extend", true, target, deep);
  }
  return target;
}

JsValue ajaxHandleResponses(JsValue s, JsValue jqXHR, JsValue responses) {
  JsValue ct = JS.undefined();
  JsValue finalDataType = JS.undefined();
  JsValue firstDataType = JS.undefined();
  JsValue contents = s["contents"];
  JsValue dataTypes = s["dataTypes"];

  while (JS.strictEqual(dataTypes[0], "*")) {
    JS.invoke(dataTypes, "shift");
    if (JS.isUndefined(ct)) {
      ct = JS.or(s["mimeType"], JS.invoke(jqXHR, "getResponseHeader", "Content-Type"));
    }
  }

  if (ct.truthy()) {
    for (string type in contents) {
      if (contents[type].truthy() && JS.invoke(contents[type], "test", ct).truthy()) {
        JS.invoke(dataTypes, "unshift", type);
        break;
      }
    }
  }

  if (JS.in(dataTypes[0], responses)) {
    finalDataType = dataTypes[0];
  } else {
    for (string type in responses) {
      if (!dataTypes[0].truthy() || s["converters"][JS.add(type + " ", dataTypes[0])].truthy()) {
        finalDataType = type;
        break;
      }
      if (!firstDataType.truthy()) {
        firstDataType = type;
      }
    }
    finalDataType = JS.or(finalDataType, firstDataType);
  }

  if (finalDataType.truthy()) {
    if (!JS.strictEqual(finalDataType, dataTypes[0])) {
      JS.invoke(dataTypes, "unshift", finalDataType);
    }
    return responses[finalDataType];
  }
  return JS.undefined();
}

JsValue ajaxConvert(JsValue s, JsValue response, JsValue jqXHR, bool isSuccess) {
  JsValue conv = JS.undefined();
  JsValue prev = JS.undefined();
  JsValue converters = JS.object();
  JsValue dataTypes = JS.invoke(s["dataTypes"], "slice");

  if (dataTypes[1].truthy()) {
    for (string key in s["converters"]) {
      converters[key.toLowerCase()] = s["converters"][key];
    }
  }

  JsValue current = JS.invoke(dataTypes, "shift");

  while (current.truthy()) {
    if (s["responseFields"][current].truthy()) {
      jqXHR[s["responseFields"][current]] = response;
    }

    if (!prev.truthy() && isSuccess && s["dataFilter"].truthy()) {
      response = JS.invoke(s, "dataFilter", response, s["dataType"]);
    }

    prev = current;
    current = JS.invoke(dataTypes, "shift");

    if (current.truthy()) {
      if (JS.strictEqual(current, "*")) {
        current = prev;
      } else if (!JS.strictEqual(prev, "*") && !JS.strictEqual(prev, current)) {
        conv = JS.or(converters[JS.add(JS.add(prev, " "), current)], converters[JS.add("* ", current)]);

        if (!conv.truthy()) {
          for (string conv2 in converters) {
            JsValue tmp = JS.invoke(conv2, "split", " ");
            if (JS.strictEqual(tmp[1], current)) {
              conv = JS.or(converters[JS.add(JS.add(prev, " "), tmp[0])], converters[JS.add("* ", tmp[0])]);
              if (conv.truthy()) {
                if (conv == true) {
                  conv = converters[conv2];
                } else if (converters[conv2] != true) {
                  current = tmp[0];
                  JS.invoke(dataTypes, "unshift", tmp[1]);
                }
                break;
              }
            }
          }
        }

        if (conv != true) {
          if (conv.truthy() && s["throws"].truthy()) {
            response = conv(response);
          } else {
            try {
              response = conv(response);
            } catch (JsValue e) {
              return object {
                state: "parsererror",
                error: if (conv.truthy()) { e } else { JS.add(JS.add(JS.add("No conversion from ", prev), " to "), current) }
              };
            }
          }
        }
      }
    }
  }

  return object { state: "success", data: response };
}

JsValue ajaxSetup(JsValue target, JsValue settings) {
  return if (settings.truthy()) {
    ajaxExtend(ajaxExtend(target, jQuery["ajaxSettings"]), settings)
  } else {
    ajaxExtend(jQuery["ajaxSettings"], target)
  };
}

JsValue ajax(JsValue url, JsValue options) {
  if (JS.typeOf(url) == "object") {
    options = url;
    url = JS.undefined();
  }
  options = JS.or(options, JS.object());

  JsValue transport = JS.undefined();
  JsValue cacheURL = JS.undefined();
  JsValue responseHeadersString = JS.undefined();
  JsValue responseHeaders = JS.undefined();
  JsValue timeoutTimer = JS.undefined();
  JsValue completed = JS.undefined();
  JsValue fireGlobals = JS.undefined();
  JsValue uncached = JS.undefined();
  JsValue done = JS.undefined();
  JsValue s = ajaxSetup(JS.object(), options);
  JsValue callbackContext = JS.or(s["context"], s);
  JsValue globalEventContext = if (JS.and(s["context"], JS.or(callbackContext["nodeType"], callbackContext["jquery"])).truthy()) {
    wrap(callbackContext)
  } else {
    jQuery["event"]
  };
  JsValue deferred = Deferred();
  JsValue completeDeferred = newCallbacksOnceMemory();
  JsValue statusCode = JS.or(s["statusCode"], JS.object());
  JsValue requestHeaders = JS.object();
  JsValue requestHeadersNames = JS.object();
  JsValue strAbort = "canceled";
  JsValue jqXHR = object {
    readyState: 0.0,

    getResponseHeader: (JsValue key) => {
      JsValue found = JS.undefined();
      if (completed.truthy()) {
        if (!responseHeaders.truthy()) {
          responseHeaders = JS.object();
          JsValue header = JS.invoke(rheaders, "exec", responseHeadersString);
          while (header.truthy()) {
            JsValue name = JS.add(JS.invoke(header[1], "toLowerCase"), " ");
            responseHeaders[name] = JS.invoke(JS.or(responseHeaders[name], JS.array()), "concat", header[2]);
            header = JS.invoke(rheaders, "exec", responseHeadersString);
          }
        }
        found = responseHeaders[JS.add(JS.invoke(key, "toLowerCase"), " ")];
      }
      return if (JS.isNullish(found)) { null } else { JS.invoke(found, "join", ", ") };
    },

    getAllResponseHeaders: () => if (completed.truthy()) { responseHeadersString } else { null },

    setRequestHeader: JS.method2((JsValue self, JsValue name, JsValue value) => {
      if (JS.isNullish(completed)) {
        JsValue lower = JS.invoke(name, "toLowerCase");
        requestHeadersNames[lower] = JS.or(requestHeadersNames[lower], name);
        requestHeaders[requestHeadersNames[lower]] = value;
      }
      return self;
    }),

    overrideMimeType: JS.method1((JsValue self, JsValue type) => {
      if (JS.isNullish(completed)) {
        s["mimeType"] = type;
      }
      return self;
    }),

    statusCode: JS.method1((JsValue self, JsValue map) => {
      if (map.truthy()) {
        if (completed.truthy()) {
          JS.invoke(self, "always", map[self["status"]]);
        } else {
          for (string code in map) {
            statusCode[code] = [statusCode[code], map[code]];
          }
        }
      }
      return self;
    }),

    abort: JS.method1((JsValue self, JsValue statusText) => {
      JsValue finalText = JS.or(statusText, strAbort);
      if (transport.truthy()) {
        JS.invoke(transport, "abort", finalText);
      }
      done(0.0, finalText);
      return self;
    })
  };

  done = (JsValue status, JsValue nativeStatusText, JsValue responses, JsValue headers) => {
    JsValue success = JS.undefined();
    JsValue error = JS.undefined();
    JsValue response = JS.undefined();
    JsValue statusText = nativeStatusText;

    if (completed.truthy()) {
      return JS.undefined();
    }
    completed = true;

    if (timeoutTimer.truthy()) {
      clearTimeoutId(timeoutTimer);
    }

    transport = JS.undefined();
    responseHeadersString = JS.or(headers, "");
    jqXHR["readyState"] = if (JS.greaterThan(status, 0.0)) { 4.0 } else { 0.0 };

    bool isSuccess = JS.greaterThanOrEqual(status, 200.0) && JS.lessThan(status, 300.0) || JS.strictEqual(status, 304.0);

    if (responses.truthy()) {
      response = ajaxHandleResponses(s, jqXHR, responses);
    }

    if (!isSuccess && inArray("script", s["dataTypes"]) > -1.0 && inArray("json", s["dataTypes"]) < 0.0) {
      s["converters"]["text script"] = () => JS.undefined();
    }

    response = ajaxConvert(s, response, jqXHR, isSuccess);

    if (isSuccess) {
      if (s["ifModified"].truthy()) {
        JsValue modified = JS.invoke(jqXHR, "getResponseHeader", "Last-Modified");
        if (modified.truthy()) {
          jQuery["lastModified"][cacheURL] = modified;
        }
        modified = JS.invoke(jqXHR, "getResponseHeader", "etag");
        if (modified.truthy()) {
          jQuery["etag"][cacheURL] = modified;
        }
      }

      if (JS.strictEqual(status, 204.0) || JS.strictEqual(s["type"], "HEAD")) {
        statusText = "nocontent";
      } else if (JS.strictEqual(status, 304.0)) {
        statusText = "notmodified";
      } else {
        statusText = response["state"];
        success = response["data"];
        error = response["error"];
        isSuccess = !error.truthy();
      }
    } else {
      error = statusText;
      if (status.truthy() || !statusText.truthy()) {
        statusText = "error";
        if (JS.lessThan(status, 0.0)) {
          status = 0.0;
        }
      }
    }

    jqXHR["status"] = status;
    jqXHR["statusText"] = JS.string(JS.or(nativeStatusText, statusText));

    if (isSuccess) {
      JS.invoke(deferred, "resolveWith", callbackContext, [success, statusText, jqXHR]);
    } else {
      JS.invoke(deferred, "rejectWith", callbackContext, [jqXHR, statusText, error]);
    }

    JS.invoke(jqXHR, "statusCode", statusCode);
    statusCode = JS.undefined();

    if (fireGlobals.truthy()) {
      JS.invoke(globalEventContext, "trigger", if (isSuccess) { "ajaxSuccess" } else { "ajaxError" }, [jqXHR, s, if (isSuccess) { success } else { error }]);
    }

    JS.invoke(completeDeferred, "fireWith", callbackContext, [jqXHR, statusText]);

    if (fireGlobals.truthy()) {
      JS.invoke(globalEventContext, "trigger", "ajaxComplete", [jqXHR, s]);
      jQuery["active"] = JS.number(jQuery["active"]) - 1.0;
      if (!jQuery["active"].truthy()) {
        trigger("ajaxStop");
      }
    }
    return JS.undefined();
  };

  JS.invoke(deferred, "promise", jqXHR);

  s["url"] = JS.invoke(JS.string(JS.or(JS.or(url, s["url"]), location["href"])), "replace", rprotocol, JS.add(location["protocol"], "//"));
  s["type"] = JS.or(JS.or(JS.or(options["method"], options["type"]), s["method"]), s["type"]);
  s["dataTypes"] = JS.or(JS.invoke(JS.invoke(JS.or(s["dataType"], "*"), "toLowerCase"), "match", rnothtmlwhite), [""]);

  if (JS.isNullish(s["crossDomain"])) {
    JsValue urlAnchor = JS.invoke(document, "createElement", "a");
    try {
      urlAnchor["href"] = s["url"];
      urlAnchor["href"] = urlAnchor["href"];
      s["crossDomain"] = JS.strictNotEqual(
        JS.add(JS.add(originAnchor["protocol"], "//"), originAnchor["host"]),
        JS.add(JS.add(urlAnchor["protocol"], "//"), urlAnchor["host"])
      );
    } catch {
      s["crossDomain"] = true;
    }
  }

  if (s["data"].truthy() && s["processData"].truthy() && !(s["data"] is string)) {
    s["data"] = param(s["data"], s["traditional"]);
  }

  inspectPrefiltersOrTransports(prefilters, s, options, jqXHR);

  if (completed.truthy()) {
    return jqXHR;
  }

  fireGlobals = JS.and(jQuery["event"], s["global"]);
  if (fireGlobals.truthy()) {
    float active = JS.number(jQuery["active"]);
    jQuery["active"] = active + 1.0;
    if (active == 0.0) {
      trigger("ajaxStart");
    }
  }

  s["type"] = JS.invoke(s["type"], "toUpperCase");
  s["hasContent"] = !JS.invoke(rnoContent, "test", s["type"]).truthy();
  cacheURL = JS.invoke(s["url"], "replace", rhash, "");

  if (!s["hasContent"].truthy()) {
    uncached = JS.invoke(s["url"], "slice", cacheURL.length);

    if (s["data"].truthy() && (s["processData"].truthy() || s["data"] is string)) {
      cacheURL = JS.add(JS.add(cacheURL, if (JS.invoke(rquery, "test", cacheURL).truthy()) { "&" } else { "?" }), s["data"]);
      JS.delete(s, "data");
    }

    if (JS.strictEqual(s["cache"], false)) {
      cacheURL = JS.invoke(cacheURL, "replace", rantiCache, "$1");
      uncached = JS.add(JS.add(JS.add(if (JS.invoke(rquery, "test", cacheURL).truthy()) { "&" } else { "?" }, "_="), nextGuid()), uncached);
    }

    s["url"] = JS.add(cacheURL, uncached);
  } else if (s["data"].truthy() && s["processData"].truthy() && JS.strictEqual(JS.invoke(JS.or(s["contentType"], ""), "indexOf", "application/x-www-form-urlencoded"), 0.0)) {
    s["data"] = JS.invoke(s["data"], "replace", r20, "+");
  }

  if (s["ifModified"].truthy()) {
    if (jQuery["lastModified"][cacheURL].truthy()) {
      JS.invoke(jqXHR, "setRequestHeader", "If-Modified-Since", jQuery["lastModified"][cacheURL]);
    }
    if (jQuery["etag"][cacheURL].truthy()) {
      JS.invoke(jqXHR, "setRequestHeader", "If-None-Match", jQuery["etag"][cacheURL]);
    }
  }

  if (s["data"].truthy() && s["hasContent"].truthy() && !JS.strictEqual(s["contentType"], false) || options["contentType"].truthy()) {
    JS.invoke(jqXHR, "setRequestHeader", "Content-Type", s["contentType"]);
  }

  JS.invoke(jqXHR, "setRequestHeader", "Accept",
    if (JS.and(s["dataTypes"][0], s["accepts"][s["dataTypes"][0]]).truthy()) {
      JS.add(s["accepts"][s["dataTypes"][0]], if (JS.strictEqual(s["dataTypes"][0], "*")) { "" } else { ", " + allTypes + "; q=0.01" })
    } else {
      s["accepts"]["*"]
    }
  );

  for (string i in s["headers"]) {
    JS.invoke(jqXHR, "setRequestHeader", i, s["headers"][i]);
  }

  if (s["beforeSend"].truthy() && (JS.isFalse(JS.call(s["beforeSend"], callbackContext, jqXHR, s)) || completed.truthy())) {
    return JS.invoke(jqXHR, "abort");
  }

  strAbort = "abort";

  JS.invoke(completeDeferred, "add", s["complete"]);
  JS.invoke(jqXHR, "done", s["success"]);
  JS.invoke(jqXHR, "fail", s["error"]);

  transport = inspectPrefiltersOrTransports(transports, s, options, jqXHR);

  if (!transport.truthy()) {
    done(-1.0, "No Transport");
  } else {
    jqXHR["readyState"] = 1.0;

    if (fireGlobals.truthy()) {
      JS.invoke(globalEventContext, "trigger", "ajaxSend", [jqXHR, s]);
    }

    if (completed.truthy()) {
      return jqXHR;
    }

    if (s["async"].truthy() && JS.greaterThan(s["timeout"], 0.0)) {
      timeoutTimer = scheduleTimeoutMs(() => {
        JS.invoke(jqXHR, "abort", "timeout");
        return JS.undefined();
      }, JS.number(s["timeout"]));
    }

    try {
      completed = false;
      JS.invoke(transport, "send", requestHeaders, done);
    } catch (JsValue e) {
      if (completed.truthy()) {
        throw e;
      }
      done(-1.0, e);
    }
  }

  return jqXHR;
}

JsValue statics = object {
  active: 0.0,
  lastModified: JS.object(),
  etag: JS.object(),
  ajaxSettings: object {
    url: location["href"],
    type: "GET",
    isLocal: JS.invoke(new Regex("^(?:about|app|app-storage|.+-extension|file|res|widget):$"), "test", location["protocol"]),
    global: true,
    processData: true,
    async: true,
    contentType: "application/x-www-form-urlencoded; charset=UTF-8",
    accepts: object {
      "*": allTypes,
      text: "text/plain",
      html: "text/html",
      xml: "application/xml, text/xml",
      json: "application/json, text/javascript"
    },
    contents: object {
      xml: new Regex("\\bxml\\b"),
      html: new Regex("\\bhtml"),
      json: new Regex("\\bjson\\b")
    },
    responseFields: object {
      xml: "responseXML",
      text: "responseText",
      json: "responseJSON"
    },
    converters: object {
      "* text": String,
      "text html": true,
      "text json": JSON["parse"],
      "text xml": parseXML
    },
    flatOptions: object {
      url: true,
      context: true
    }
  },
  ajaxSetup: ajaxSetup,
  ajaxPrefilter: addToPrefiltersOrTransports(prefilters),
  ajaxTransport: addToPrefiltersOrTransports(transports),
  ajax: ajax,
  getJSON: (JsValue url, JsValue data, JsValue callback) => JS.invoke(jQuery, "get", url, data, callback, "json"),
  getScript: (JsValue url, JsValue callback) => JS.invoke(jQuery, "get", url, JS.undefined(), callback, "script")
};
JS.invoke(jQuery, "extend", statics);

each(["get", "post"], (JsValue _i, JsValue method) => {
  jQuery[method] = (JsValue url, JsValue data, JsValue callback, JsValue type) => {
    if (isFunction(data)) {
      type = JS.or(type, callback);
      callback = data;
      data = JS.undefined();
    }
    return JS.invoke(jQuery, "ajax", JS.invoke(jQuery, "extend", object {
      url: url,
      type: method,
      dataType: type,
      data: data,
      success: callback
    }, JS.and(isPlainObject(url), url)));
  };
  return JS.undefined();
});

JS.invoke(jQuery, "ajaxPrefilter", (JsValue s) => {
  for (string i in s["headers"]) {
    if (i.toLowerCase() == "content-type") {
      s["contentType"] = JS.or(s["headers"][i], "");
    }
  }
  return JS.undefined();
});

export { jQuery, ajax };
