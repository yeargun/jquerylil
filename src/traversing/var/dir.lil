import { wrap } from "../../core";

export JsValue dir(JsValue start, string direction, JsValue until = null) {
  JsValue[] matched = [];
  bool truncate = !JS.isNullish(until);
  JsValue elem = start[direction];
  while (elem.truthy() && elem["nodeType"] != 9.0) {
    if (elem["nodeType"] == 1.0) {
      if (truncate && JS.invoke(wrap(elem), "is", until).truthy()) {
        break;
      }
      matched.push(elem);
    }
    elem = elem[direction];
  }
  return matched;
}
