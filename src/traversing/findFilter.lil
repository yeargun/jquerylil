extern JsValue this;
import { jQuery, grep, wrap, inArray } from "../core";
import { isFunction } from "../var/isFunction";
import { rneedsContext } from "./var/rneedsContext";
import { find, uniqueSortImpl } from "../selector";
import { containsImpl } from "../selector/contains";

JsValue winnow(JsValue elements, JsValue qualifier, bool not) {
  if (isFunction(qualifier)) {
    return grep(elements, (JsValue elem, JsValue i) => JS.call(qualifier, elem, i, elem).truthy() != not);
  }

  if (qualifier["nodeType"].truthy()) {
    return grep(elements, (JsValue elem, JsValue _i) => (elem == qualifier) != not);
  }

  if (!(qualifier is string)) {
    return grep(elements, (JsValue elem, JsValue _i) => (inArray(elem, qualifier) > -1.0) != not);
  }

  return filterImpl(qualifier, elements, not);
}

export JsValue filterImpl(JsValue expr, JsValue elems, JsValue not) {
  JsValue elem = elems[0];

  if (not.truthy()) {
    expr = ":not(" + expr + ")";
  }

  if (elems.length == 1.0 && elem["nodeType"] == 1.0) {
    if (JS.invoke(find, "matchesSelector", elem, expr).truthy()) {
      return JS.array(elem);
    }
    return JS.array();
  }

  return JS.invoke(find, "matches", expr, grep(elems, (JsValue e, JsValue _i) => e["nodeType"] == 1.0));
}

export JsValue fnFind(JsValue selector) {
  JsValue self = this;
  float len = self.length;

  if (!(selector is string)) {
    return JS.invoke(self, "pushStack", JS.invoke(wrap(selector), "filter", (JsValue _i, JsValue elem) => {
      for (float i = 0.0; i < len; i++) {
        if (containsImpl(self[i], elem)) {
          return true;
        }
      }
      return false;
    }));
  }

  JsValue ret = JS.invoke(self, "pushStack", JS.array());
  for (float i = 0.0; i < len; i++) {
    find(selector, self[i], ret);
  }

  if (len > 1.0) {
    return uniqueSortImpl(ret);
  }
  return ret;
}

export JsValue fnFilter(JsValue selector) {
  return JS.invoke(this, "pushStack", winnow(this, JS.or(selector, JS.array()), false));
}

export JsValue fnNot(JsValue selector) {
  return JS.invoke(this, "pushStack", winnow(this, JS.or(selector, JS.array()), true));
}

export JsValue fnIs(JsValue selector) {
  return winnow(this, if (selector is string && JS.regexTest(rneedsContext, selector)) { wrap(selector) } else { JS.or(selector, JS.array()) }, false).length > 0.0;
}

jQuery["filter"] = filterImpl;
JS.invoke(jQuery["fn"], "extend", JS.object(
  "find", fnFind,
  "filter", fnFilter,
  "not", fnNot,
  "is", fnIs
));

export { jQuery };
