extern JsValue this;
import { jQuery } from "../core";
import {
  scheduleTimeoutMs,
  clearTimeoutId
} from "../js-host.lil";

// Based off of the plugin by Clint Helfers, with permission.
JsValue fnDelay(JsValue time, JsValue type) {
  JsValue fx = jQuery["fx"];
  time = JS.or(JS.and(fx, fx["speeds"][time]), time);

  return JS.invoke(this, "queue", JS.or(type, "fx"), (JsValue next, JsValue hooks) => {
    JsValue timeout = scheduleTimeoutMs(next, JS.number(time));
    hooks["stop"] = () => clearTimeoutId(timeout);
  });
}

jQuery["fn"]["delay"] = fnDelay;

export { jQuery };
