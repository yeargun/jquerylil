extern JsValue TypeError;
import { jQuery, each, slice } from "./core";
import { isFunction } from "./var/isFunction";
import "./callbacks";
import { scheduleTimeout } from "./js-host.lil";

struct PromiseApi {
  JsValue state;
  JsValue always;
  JsValue catch;
  JsValue pipe;
  JsValue then;
  JsValue promise;
}

struct DeferredStatics {
  JsValue Deferred;
  JsValue when;
}

JsValue Identity = (JsValue v) => {
  return v;
};

JsValue Thrower = (JsValue ex) => {
  throw ex;
};

void adoptValue(JsValue value, JsValue resolve, JsValue reject, JsValue noValue = JS.undefined()) {
  try {
    if (value.truthy()) {
      JsValue method = value["promise"];
      if (isFunction(method)) {
        JS.invoke(JS.invoke(JS.call(method, value), "done", resolve), "fail", reject);
        return;
      }
      method = value["then"];
      if (isFunction(method)) {
        JS.call(method, value, resolve, reject);
        return;
      }
    }
    JS.apply(resolve, JS.undefined(), JS.invoke(JS.array(value), "slice", noValue));
  } catch (JsValue error) {
    JS.apply(reject, JS.undefined(), JS.array(error));
  }
}

export JsValue Deferred(JsValue fn = JS.undefined()) {
  JsValue tuples = JS.array(
    JS.array("notify", "progress", JS.invoke(jQuery, "Callbacks", "memory"), JS.invoke(jQuery, "Callbacks", "memory"), 2.0),
    JS.array("resolve", "done", JS.invoke(jQuery, "Callbacks", "once memory"), JS.invoke(jQuery, "Callbacks", "once memory"), 0.0, "resolved"),
    JS.array("reject", "fail", JS.invoke(jQuery, "Callbacks", "once memory"), JS.invoke(jQuery, "Callbacks", "once memory"), 1.0, "rejected")
  );

  JsValue state = "pending";
  JsValue deferred = JS.object();
  JsValue promise = JS.undefined();

  promise = PromiseApi{
    () => {
      return state;
    },
    JS.methodRest((JsValue thisArg, JsValue args) => {
      JS.invoke(JS.invoke(deferred, "done", args), "fail", args);
      return thisArg;
    }),
    (JsValue catchFn) => {
      return JS.invoke(promise, "then", null, catchFn);
    },
    JS.staticRest((JsValue fns) => {
      return JS.invoke(JS.invoke(jQuery, "Deferred", (JsValue newDefer) => {
        each(tuples, (JsValue _i, JsValue tuple) => {
          JsValue fn = JS.and(isFunction(fns[tuple[4]]), fns[tuple[4]]);
          JS.invoke(deferred, JS.assume(tuple[1]), JS.methodRest((JsValue thisArg, JsValue args) => {
            JsValue returned = JS.and(fn, JS.apply(fn, thisArg, args));
            if (returned.truthy() && isFunction(returned["promise"])) {
              JS.invoke(JS.invoke(JS.invoke(JS.invoke(returned, "promise"), "progress", newDefer["notify"]), "done", newDefer["resolve"]), "fail", newDefer["reject"]);
            } else {
              JS.invoke(newDefer, JS.string(tuple[0]) + "With", thisArg, if (fn.truthy()) { JS.array(returned) } else { args });
            }
            return JS.undefined();
          }));
          return JS.undefined();
        });
        fns = null;
        return JS.undefined();
      }), "promise");
    }),
    (JsValue onFulfilled, JsValue onRejected, JsValue onProgress) => {
      float maxDepth = 0.0;

      JsValue resolve = (float depth, JsValue newDefer, JsValue handler, JsValue special = JS.undefined()) => {
        return JS.methodRest((JsValue that, JsValue args) => {
          func()->JsValue mightThrow = () => {
            if (depth < maxDepth) {
              return JS.undefined();
            }
            JsValue returned = JS.apply(handler, that, args);
            if (returned == JS.invoke(newDefer, "promise")) {
              throw JS.construct(TypeError, "Thenable self-resolution");
            }
            JsValue then = JS.and(JS.and(returned, JS.typeOf(returned) == "object" || JS.typeOf(returned) == "function"), returned["then"]);
            if (isFunction(then)) {
              if (special.truthy()) {
                JS.call(then, returned, resolve(maxDepth, newDefer, Identity, special), resolve(maxDepth, newDefer, Thrower, special));
              } else {
                maxDepth++;
                JS.call(then, returned,
                  resolve(maxDepth, newDefer, Identity, special),
                  resolve(maxDepth, newDefer, Thrower, special),
                  resolve(maxDepth, newDefer, Identity, newDefer["notifyWith"]));
              }
            } else {
              if (!(handler == Identity)) {
                that = JS.undefined();
                args = JS.array(returned);
              }
              JS.call(JS.or(special, newDefer["resolveWith"]), JS.undefined(), that, args);
            }
            return JS.undefined();
          };

          JsValue asyncError = JS.undefined();
          JsValue process = mightThrow;
          if (!special.truthy()) {
            process = () => {
              try {
                mightThrow();
              } catch (JsValue e) {
                if (jQuery["Deferred"]["exceptionHook"].truthy()) {
                  JS.invoke(jQuery["Deferred"], "exceptionHook", e, asyncError);
                }
                if (depth + 1.0 >= maxDepth) {
                  if (!(handler == Thrower)) {
                    that = JS.undefined();
                    args = JS.array(e);
                  }
                  JS.invoke(newDefer, "rejectWith", that, args);
                }
              }
              return JS.undefined();
            };
          }

          if (depth != 0.0) {
            process();
          } else {
            if (jQuery["Deferred"]["getErrorHook"].truthy()) {
              asyncError = JS.invoke(jQuery["Deferred"], "getErrorHook");
            } else if (jQuery["Deferred"]["getStackHook"].truthy()) {
              asyncError = JS.invoke(jQuery["Deferred"], "getStackHook");
            }
            scheduleTimeout(process);
          }
          return JS.undefined();
        });
      };

      return JS.invoke(JS.invoke(jQuery, "Deferred", (JsValue newDefer) => {
        JS.invoke(tuples[0][3], "add", resolve(0.0, newDefer, if (isFunction(onProgress)) { onProgress } else { Identity }, newDefer["notifyWith"]));
        JS.invoke(tuples[1][3], "add", resolve(0.0, newDefer, if (isFunction(onFulfilled)) { onFulfilled } else { Identity }));
        JS.invoke(tuples[2][3], "add", resolve(0.0, newDefer, if (isFunction(onRejected)) { onRejected } else { Thrower }));
        return JS.undefined();
      }), "promise");
    },
    (JsValue obj) => {
      return if (JS.isNullish(obj)) { promise } else { JS.invoke(jQuery, "extend", obj, promise) };
    }
  };

  each(tuples, (float i, JsValue tuple) => {
    JsValue list = tuple[2];
    JsValue stateString = tuple[5];
    promise[tuple[1]] = list["add"];

    if (stateString.truthy()) {
      JS.invoke(list, "add",
        () => {
          state = stateString;
          return JS.undefined();
        },
        tuples[3.0 - i][2]["disable"],
        tuples[3.0 - i][3]["disable"],
        tuples[0][2]["lock"],
        tuples[0][3]["lock"]
      );
    }

    JS.invoke(list, "add", tuple[3]["fire"]);

    deferred[tuple[0]] = JS.methodRest((JsValue thisArg, JsValue args) => {
      JS.invoke(deferred, JS.string(tuple[0]) + "With", if (thisArg == deferred) { JS.undefined() } else { thisArg }, args);
      return thisArg;
    });
    deferred[JS.string(tuple[0]) + "With"] = list["fireWith"];
    return JS.undefined();
  });

  JS.invoke(promise, "promise", deferred);

  if (fn.truthy()) {
    JS.call(fn, deferred, deferred);
  }

  return deferred;
}

JsValue when = JS.staticRest((JsValue args) => {
  float remaining = args.length;
  float i = remaining;
  JsValue resolveContexts = JS.array();
  JsValue resolveValues = JS.invoke(slice, "call", args);
  JsValue primary = JS.invoke(jQuery, "Deferred");

  func(float)->JsValue updateFunc = (float index) => {
    return JS.methodRest((JsValue thisArg, JsValue args) => {
      resolveContexts[index] = thisArg;
      resolveValues[index] = if (args.length > 1.0) { JS.invoke(slice, "call", args) } else { args[0] };
      remaining--;
      if (remaining == 0.0) {
        JS.invoke(primary, "resolveWith", resolveContexts, resolveValues);
      }
      return JS.undefined();
    });
  };

  if (remaining <= 1.0) {
    adoptValue(args[0], JS.invoke(primary, "done", updateFunc(i))["resolve"], primary["reject"], remaining == 0.0);
    if (JS.invoke(primary, "state") == "pending" || isFunction(JS.and(resolveValues[i], resolveValues[i]["then"]))) {
      return JS.invoke(primary, "then");
    }
  }

  while (i > 0.0) {
    i--;
    adoptValue(resolveValues[i], updateFunc(i), primary["reject"]);
  }

  return JS.invoke(primary, "promise");
});

JS.invoke(jQuery, "extend", DeferredStatics{
  Deferred,
  when
});

export { jQuery, when };
