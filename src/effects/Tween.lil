extern JsValue this;
import { jQuery } from "../core";
import { css, style } from "../css";
import { finalPropName } from "../css/finalPropName";
import {
  mathCos,
  mathPI
} from "../js-host.lil";

// View of the merged animation options bag effects.lil allocates (`jQuery.speed()` output
// deep-extended over the {specialEasing, easing} seed by jQuery.extend, which copies data
// values only), so reads are typed field reads (finer/hypotheses/042).
export extern class AnimOptsView {
  JsValue duration;
  JsValue easing;
  JsValue queue;
  JsValue specialEasing;
  JsValue step;
  JsValue progress;
  JsValue complete;
  JsValue start;
  JsValue done;
  JsValue fail;
  JsValue always;
  JsValue overflow;
  JsValue old;
}

// View of a jQuery.Tween instance: Tween.prototype.init writes every field; propHooks
// and step callbacks receive the same object, so reads are typed field reads.
export extern class TweenView {
  JsValue elem;
  JsValue prop;
  JsValue options;
  JsValue end;
  JsValue pos;
  JsValue easing;
  JsValue unit;
  JsValue start;
  JsValue now;
}

struct TweenGetSet {
  JsValue get;
  JsValue set;
}

struct TweenSetOnly {
  JsValue set;
}

struct TweenHooks {
  JsValue _default;
  JsValue scrollLeft;
  JsValue scrollTop;
}

struct TweenProto {
  JsValue constructor;
  JsValue init;
  JsValue cur;
  JsValue run;
}

struct EasingMap {
  JsValue linear;
  JsValue swing;
  string _default;
}

JsValue scrollHooks = TweenSetOnly{scrollSet};
JsValue propHooks = TweenHooks{TweenGetSet{defaultGet, defaultSet}, scrollHooks, scrollHooks};

JsValue initFn = tweenInit;

JsValue Tween(JsValue elem, JsValue options, JsValue prop, JsValue end, JsValue easing) {
  return JS.construct(tweenInit, elem, options, prop, end, easing);
}

void tweenInit(JsValue elem, JsValue options, JsValue prop, JsValue end, JsValue easing, JsValue unit) {
  TweenView tween = JS.assume(this);
  tween.elem = elem;
  tween.prop = prop;
  tween.easing = JS.or(easing, jQuery["easing"]["_default"]);
  tween.options = options;
  JsValue current = JS.invoke(tween, "cur");
  tween.now = current;
  tween.start = current;
  tween.end = end;
  tween.unit = JS.or(unit, if (jQuery["cssNumber"][prop].truthy()) { "" } else { "px" });
}

JsValue tweenCur() {
  JsValue hooks = propHooks[this["prop"]];
  return JS.invoke(if (JS.and(hooks, hooks["get"]).truthy()) { hooks } else { propHooks["_default"] }, "get", this);
}

JsValue tweenRun(float percent) {
  TweenView tween = JS.assume(this);
  AnimOptsView options = JS.assume(tween.options);
  JsValue hooks = propHooks[tween.prop];
  // Raw values typed as numbers so the arithmetic prints as upstream's own operators
  // (`( end - start ) * eased + start` still concatenates a string start, as upstream does).
  float duration = JS.assume(options.duration);
  float eased = if (options.duration.truthy()) {
    JS.assume(JS.invoke(jQuery["easing"], JS.assume(tween.easing),
      percent, duration * percent, 0.0, 1.0, duration))
  } else {
    percent
  };
  float start = JS.assume(tween.start);
  float end = JS.assume(tween.end);
  tween.pos = eased;
  tween.now = (end - start) * eased + start;

  if (options.step.truthy()) {
    JS.call(options.step, tween.elem, tween.now, this);
  }

  JS.invoke(if (JS.and(hooks, hooks["set"]).truthy()) { hooks } else { propHooks["_default"] }, "set", this);
  return this;
}

JsValue defaultGet(TweenView tween) {
  JsValue elem = tween.elem;
  JsValue prop = tween.prop;

  // Use a property on the element directly when it is not a DOM element,
  // or when there is no matching style property that exists.
  if (elem["nodeType"] != 1.0 ||
      !JS.isNullish(elem[prop]) && JS.isNullish(elem["style"][prop])) {
    return elem[prop];
  }

  // Passing an empty string as a 3rd parameter to .css will automatically
  // attempt a parseFloat and fallback to a string if the parse fails.
  // Simple values such as "10px" are parsed to Float;
  // complex values such as "rotate(1rad)" are returned as-is.
  JsValue result = css(elem, JS.assume(prop), "");

  // Empty strings, null, undefined and "auto" are converted to 0.
  return if (!result.truthy() || result == "auto") { 0.0 } else { result };
}

void defaultSet(TweenView tween) {
  JsValue elem = tween.elem;
  JsValue prop = tween.prop;

  // Use step hook for back compat.
  // Use cssHook if its there.
  // Use .style if available and use plain properties where available.
  if (initFn["step"][prop].truthy()) {
    JS.invoke(initFn["step"], JS.assume(prop), tween);
  } else if (elem["nodeType"] == 1.0 && (jQuery["cssHooks"][prop].truthy() ||
      !JS.isNullish(elem["style"][finalPropName(JS.assume(prop))]))) {
    style(elem, JS.assume(prop), JS.add(tween.now, tween.unit));
  } else {
    elem[prop] = tween.now;
  }
}

// Support: IE <=9 only
// Panic based approach to setting things on disconnected nodes
void scrollSet(TweenView tween) {
  JsValue elem = tween.elem;
  if (elem["nodeType"].truthy() && elem["parentNode"].truthy()) {
    elem[tween.prop] = tween.now;
  }
}

float easingLinear(float p) {
  return p;
}

float easingSwing(float p) {
  return 0.5 - mathCos(p * mathPI()) / 2.0;
}


JsValue tweenFn = Tween;
JsValue proto = TweenProto{tweenFn, initFn, tweenCur, tweenRun};
tweenFn["prototype"] = proto;
initFn["prototype"] = proto;
tweenFn["propHooks"] = propHooks;

jQuery["Tween"] = tweenFn;
jQuery["easing"] = EasingMap{easingLinear, easingSwing, "swing"};
jQuery["fx"] = initFn;

// Back compat <1.8 extension point
initFn["step"] = JS.object();

export { jQuery };
