import { jQuery } from "../core";
import { css, style } from "../css";
import { finalPropName } from "../css/finalPropName";
import {
  objectCreate,
  mathCos,
  mathPI
} from "../js-host.lil";

// View of the merged animation options bag effects.lil allocates (`jQuery.speed()` output
// deep-extended over the {specialEasing, easing} seed by jQuery.extend, which copies data
// values only), so reads are typed field reads (finer/hypotheses/042).
export struct AnimOptsView {
  JsValue duration;
  JsValue easing;
  JsValue queue;
  JsValue specialEasing;
  JsValue step;
  JsValue progress;
  JsValue complete;
  JsValue start;
  JsValue done;
  JsValue fail;
  JsValue always;
  JsValue overflow;
  JsValue old;
}

// View of a jQuery.Tween instance: createTween / Tween.prototype.init allocate it
// (Object.create(Tween.prototype) or new) and write every field; propHooks and step
// callbacks receive the same object, so reads are typed field reads (finer/hypotheses/042).
export struct TweenView {
  JsValue elem;
  JsValue prop;
  JsValue options;
  JsValue end;
  JsValue pos;
  JsValue easing;
  JsValue unit;
  JsValue start;
  JsValue now;
}

JsValue tweenPrototype = JS.undefined();
JsValue tweenPropHooks = JS.undefined();

JsValue tweenDefaultGet(TweenView tween) {
  JsValue elem = tween.elem;
  JsValue prop = tween.prop;

  bool useElemDirect = JS.and(elem, elem["nodeType"]) != 1.0;
  if (!useElemDirect) {
    useElemDirect = !JS.isNullish(elem[prop]) && JS.isNullish(elem["style"][prop]);
  }
  if (useElemDirect) {
    return elem[prop];
  }

  JsValue result = css(elem, JS.string(prop), "");
  if (!result.truthy() || result == "auto") {
    return 0.0;
  }
  return result;
}

void tweenDefaultSet(TweenView tween) {
  JsValue prop = tween.prop;
  JsValue elem = tween.elem;
  JsValue fxStep = jQuery["fx"]["step"][prop];
  if (fxStep.truthy()) {
    JS.call(fxStep, jQuery["fx"]["step"], tween);
    return;
  }

  bool useStyle = JS.and(elem, elem["nodeType"]) == 1.0 &&
    (jQuery["cssHooks"][prop].truthy() || !JS.isNullish(elem["style"][finalPropName(JS.string(prop))]));
  if (useStyle) {
    style(elem, JS.string(prop), JS.add(tween.now, tween.unit));
  } else {
    elem[prop] = tween.now;
  }
}

void tweenScrollSet(TweenView tween) {
  JsValue elem = tween.elem;
  if (JS.and(elem, elem["nodeType"]).truthy() && elem["parentNode"].truthy()) {
    elem[tween.prop] = tween.now;
  }
}

export JsValue tweenCur(TweenView tween) {
  JsValue prop = tween.prop;
  JsValue hooks = tweenPropHooks[prop];
  if (!hooks.truthy()) {
    hooks = tweenPropHooks["_default"];
  }
  if (hooks["get"].truthy()) {
    return JS.invoke(hooks, "get", tween);
  }
  return 0.0;
}

void initializeTween(
  TweenView tween,
  JsValue elem,
  JsValue options,
  JsValue propArg,
  JsValue endArg,
  JsValue easingArg,
  JsValue unitArg
) {
  tween.elem = elem;
  tween.prop = propArg;
  tween.options = options;
  tween.end = endArg;
  tween.pos = 0.0;

  JsValue easing = easingArg;
  if (!easing.truthy()) {
    easing = jQuery["easing"]["_default"];
  }
  tween.easing = easing;

  JsValue unit = "";
  if (unitArg.truthy()) {
    unit = unitArg;
  } else if (!jQuery["cssNumber"][propArg].truthy()) {
    unit = "px";
  }
  tween.unit = unit;

  JsValue current = tweenCur(tween);
  tween.start = current;
  tween.now = current;
}

export JsValue createTween(
  JsValue elem,
  JsValue options,
  JsValue prop,
  JsValue end,
  JsValue easingArg = null,
  JsValue unitArg = null
) {
  TweenView tween = JS.assume(objectCreate(tweenPrototype));
  initializeTween(tween, elem, options, prop, end, easingArg, unitArg);
  return tween;
}

export JsValue tweenRun(TweenView tween, float percent) {
  float eased = percent;
  AnimOptsView options = JS.assume(tween.options);
  JsValue durationRaw = options.duration;
  if (durationRaw.truthy()) {
    float duration = JS.number(durationRaw);
    JsValue easingFn = jQuery["easing"][tween.easing];
    eased = JS.number(easingFn(percent, duration * percent, 0.0, 1.0, duration));
  }
  tween.pos = eased;
  float start = JS.number(tween.start);
  float end = JS.number(tween.end);
  float now = (end - start) * eased + start;
  tween.now = now;

  JsValue step = options.step;
  if (step.truthy()) {
    JS.call(step, tween.elem, now, tween);
  }

  JsValue prop = tween.prop;
  JsValue hooks = tweenPropHooks[prop];
  if (!hooks.truthy()) {
    hooks = tweenPropHooks["_default"];
  }
  if (hooks["set"].truthy()) {
    JS.invoke(hooks, "set", tween);
  }
  return tween;
}

JsValue TweenInit(
  JsValue elem,
  JsValue options,
  JsValue prop,
  JsValue end,
  JsValue easingArg = null,
  JsValue unitArg = null
) {
  JsValue self = this;
  initializeTween(JS.assume(self), elem, options, prop, end, easingArg, unitArg);
  return self;
}

JsValue TweenCurMethod() {
  JsValue self = this;
  return tweenCur(JS.assume(self));
}

JsValue TweenRunMethod(JsValue percent) {
  JsValue self = this;
  return tweenRun(JS.assume(self), JS.number(percent));
}

float easingLinear(float p) {
  return p;
}

float easingSwing(float p) {
  return 0.5 - mathCos(p * mathPI()) / 2.0;
}

struct TweenGetSet {
  JsValue get;
  JsValue set;
}

struct TweenSetOnly {
  JsValue set;
}

struct TweenHooks {
  JsValue _default;
  JsValue scrollTop;
  JsValue scrollLeft;
}

struct TweenProto {
  JsValue constructor;
  JsValue init;
  JsValue cur;
  JsValue run;
}

struct EasingMap {
  JsValue linear;
  JsValue swing;
  string _default;
}

JsValue defaultHooks = TweenGetSet{tweenDefaultGet, tweenDefaultSet};
JsValue scrollHooks = TweenSetOnly{tweenScrollSet};
JsValue hooks = TweenHooks{defaultHooks, scrollHooks, scrollHooks};
tweenPropHooks = hooks;

JsValue factory = createTween;
JsValue initFn = TweenInit;
JsValue proto = TweenProto{factory, initFn, TweenCurMethod, TweenRunMethod};
tweenPrototype = proto;
factory["prototype"] = proto;
factory["propHooks"] = hooks;
initFn["prototype"] = proto;

jQuery["Tween"] = factory;
jQuery["easing"] = EasingMap{easingLinear, easingSwing, "swing"};
jQuery["fx"] = initFn;
jQuery["fx"]["step"] = JS.object();

export { jQuery, tweenPropHooks };
