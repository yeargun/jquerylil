import { support } from "./support";

JsValue thead = JS.array(1.0, "<table>", "</table>");
JsValue td = JS.array(3.0, "<table><tbody><tr>", "</tr></tbody></table>");

export JsValue wrapMap = JS.object(
  "thead", thead,
  "col", JS.array(2.0, "<table><colgroup>", "</colgroup></table>"),
  "tr", JS.array(2.0, "<table><tbody>", "</tbody></table>"),
  "td", td,
  "_default", JS.array(0.0, "", ""),
  "tbody", thead,
  "tfoot", thead,
  "colgroup", thead,
  "caption", thead,
  "th", td
);

if (!support.option) {
  JsValue option = JS.array(1.0, "<select multiple='multiple'>", "</select>");
  wrapMap["optgroup"] = option;
  wrapMap["option"] = option;
}
