import { emptyArray } from "../alloc.lil";
import { merge } from "../core";
import { nodeName } from "../core/nodeName";

export JsValue getAll(JsValue context, JsValue tag = null) {
  JsValue ret = emptyArray();
  if (context["getElementsByTagName"].truthy()) {
    ret = JS.invoke(context, "getElementsByTagName", JS.or(tag, "*"));
  } else if (context["querySelectorAll"].truthy()) {
    ret = JS.invoke(context, "querySelectorAll", JS.or(tag, "*"));
  }

  if (JS.isNullish(tag) || (tag.truthy() && nodeName(context, JS.assume(tag)))) {
    return merge(JS.array(context), ret);
  }
  return ret;
}
