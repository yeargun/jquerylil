import { emptyArray } from "../alloc.lil";
import { jQuery, merge, inArray } from "../core";
import { toType } from "../core/toType";
import { isAttached } from "../core/isAttached";
import { rtagName } from "./var/rtagName";
import { rscriptType } from "./var/rscriptType";
import { wrapMap } from "./wrapMap";
import { getAll } from "./getAll";
import { setGlobalEval } from "./setGlobalEval";

Regex rhtml = new Regex("<|&#?\\w+;", "");

export JsValue buildFragment(JsValue elems, JsValue context, JsValue scripts = false, JsValue selection = null, JsValue ignored = null) {
  JsValue fragment = JS.invoke(context, "createDocumentFragment");
  JsValue nodes = emptyArray();
  JsValue tmp = null;

  for (float i = 0.0; i < elems.length; i++) {
    JsValue elem = elems[i];

    if (elem.truthy() || JS.strictEqual(elem, 0.0)) {
      if (toType(elem) == "object") {
        merge(nodes, if (elem["nodeType"].truthy()) { JS.array(elem) } else { elem });
      } else if (!JS.regexTest(rhtml, elem)) {
        JS.invoke(nodes, "push", JS.invoke(context, "createTextNode", elem));
      } else {
        tmp = JS.or(tmp, JS.invoke(fragment, "appendChild", JS.invoke(context, "createElement", "div")));
        JsValue wrap = JS.or(wrapMap[JS.invoke(JS.or(JS.regexExec(rtagName, elem), JS.array("", ""))[1], "toLowerCase")], wrapMap["_default"]);
        tmp["innerHTML"] = JS.add(JS.add(wrap[1], JS.invoke(jQuery, "htmlPrefilter", elem)), wrap[2]);

        float depth = JS.assume(wrap[0]);
        while (depth > 0.0) {
          depth--;
          tmp = tmp["lastChild"];
        }

        merge(nodes, tmp["childNodes"]);
        tmp = fragment["firstChild"];
        tmp["textContent"] = "";
      }
    }
  }

  fragment["textContent"] = "";

  float i = 0.0;
  while (true) {
    JsValue elem = nodes[i];
    i++;
    if (!elem.truthy()) {
      break;
    }

    if (selection.truthy() && inArray(elem, selection) > -1.0) {
      if (ignored.truthy()) {
        JS.invoke(ignored, "push", elem);
      }
      continue;
    }

    bool attached = isAttached(elem);
    tmp = getAll(JS.invoke(fragment, "appendChild", elem), "script");

    if (attached) {
      setGlobalEval(tmp);
    }

    if (scripts.truthy()) {
      float j = 0.0;
      while (true) {
        JsValue script = tmp[j];
        j++;
        if (!script.truthy()) {
          break;
        }
        if (JS.regexTest(rscriptType, JS.or(script["type"], ""))) {
          JS.invoke(scripts, "push", script);
        }
      }
    }
  }

  return fragment;
}
