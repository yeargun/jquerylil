import { jQuery, globalEval } from "../core";
import { ajax } from "../ajax";
import { noop } from "../js-host.lil";

struct EvalUrlSettings {
  string url;
  string type;
  string dataType;
  bool cache;
  bool async;
  bool global;
  JsValue converters;
  JsValue dataFilter;
}

JsValue evalUrl(string url, JsValue options, JsValue doc) {
  return ajax(EvalUrlSettings{
    url,
    "GET",
    "script",
    true,
    false,
    false,
    JS.object("text script", noop),
    (JsValue response) => {
      globalEval(JS.assume(response), options, doc);
      return JS.undefined();
    }
  }, JS.undefined());
}

JS.set(jQuery, "_evalUrl", evalUrl);

export { evalUrl };
