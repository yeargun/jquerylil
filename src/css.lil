extern JsValue this;
extern JsValue arguments;
import { jQuery } from "./core";
import { access } from "./core/access";
import { camelCase } from "./core/camelCase";
import { nodeName } from "./core/nodeName";
import { rcssNum } from "./var/rcssNum";
import { rnumnonpx } from "./css/var/rnumnonpx";
import { rcustomProp } from "./css/var/rcustomProp";
import { cssExpand } from "./css/var/cssExpand";
import { getStyles } from "./css/var/getStyles";
import { swap } from "./css/var/swap";
import { isAttached } from "./core/isAttached";
import { rboxStyle } from "./css/var/rboxStyle";
import { rtrimCSS } from "./var/rtrimCSS";
import { addGetHookIf } from "./css/addGetHookIf";
import { support, boxSizingReliable, reliableTrDimensions, scrollboxSize, reliableMarginLeft, pixelBoxStyles } from "./css/support";
import { finalPropName } from "./css/finalPropName";
import {
  parseFloatValue,
  isFiniteValue,
  mathCeil,
  mathMax
} from "./js-host.lil";

Regex rdisplayswap = new Regex("^(none|table(?!-c[ea]).+)");

struct CssShow {
  string position;
  string visibility;
  string display;
}

struct CssNormalTransform {
  string letterSpacing;
  string fontWeight;
}

struct OpacityHook {
  JsValue get;
}

struct CssHooks {
  JsValue opacity;
}

struct DimensionHooks {
  JsValue get;
  JsValue set;
}

struct ExpandHook {
  JsValue expand;
}

struct CssNumber {
  bool animationIterationCount;
  bool aspectRatio;
  bool borderImageSlice;
  bool columnCount;
  bool flexGrow;
  bool flexShrink;
  bool fontWeight;
  bool gridArea;
  bool gridColumn;
  bool gridColumnEnd;
  bool gridColumnStart;
  bool gridRow;
  bool gridRowEnd;
  bool gridRowStart;
  bool lineHeight;
  bool opacity;
  bool order;
  bool orphans;
  bool scale;
  bool widows;
  bool zIndex;
  bool zoom;
  bool fillOpacity;
  bool floodOpacity;
  bool stopOpacity;
  bool strokeMiterlimit;
  bool strokeOpacity;
}

JsValue cssShow = CssShow{"absolute", "hidden", "block"};
// `swap` only reads its options, so one object serves every call.
JsValue marginZero = JS.object("marginLeft", 0.0);
JsValue cssNormalTransform = CssNormalTransform{"0", "400"};

// Reads a host value as the number (or string, or truth value) JavaScript would use
// where upstream uses it, without printing a conversion: `a - b` coerces both sides
// itself, and `parseFloat`/`exec`/`in` take any value.
float num(JsValue value) {
  return JS.assume(value);
}

string str(JsValue value) {
  return JS.assume(value);
}

bool truthy(JsValue value) {
  return value.truthy();
}

// The same four names, read as a host array so an index needs no default.
JsValue sides = JS.assume(cssExpand);

// `jQuery.fn`, shared by the css modules that add methods to it.
export JsValue fn = jQuery["fn"];

export JsValue cssNumber = CssNumber{
  true, true, true, true, true, true, true, true, true, true, true, true, true,
  true, true, true, true, true, true, true, true, true, true, true, true, true, true
};

export JsValue cssHooks = CssHooks{OpacityHook{(JsValue elem, JsValue computed) => {
  if (computed.truthy()) {
    JsValue ret = curCSS(elem, "opacity");
    if (JS.strictEqual(ret, "")) {
      return "1";
    }
    return ret;
  }
  return JS.undefined();
}}};

jQuery["cssHooks"] = cssHooks;
jQuery["cssNumber"] = cssNumber;
jQuery["cssProps"] = JS.object();

// curCSS and adjustCSS live here, not in css/curCSS.lil and css/adjustCSS.lil (which
// re-export them): they call `style` and `css`, and a call across an import cycle does
// not resolve, so upstream's direct calls need one module.
export JsValue curCSS(JsValue elem, string name, JsValue computed = JS.undefined()) {
  bool isCustomProp = rcustomProp.test(name);
  JsValue styleObj = elem["style"];
  JsValue ret = JS.undefined();

  computed = JS.or(computed, getStyles(elem));
  if (computed.truthy()) {
    ret = JS.or(JS.invoke(computed, "getPropertyValue", name), computed[name]);

    if (isCustomProp && ret.truthy()) {
      ret = JS.or(JS.stringReplace(JS.assume(ret), rtrimCSS, "$1"), JS.undefined());
    }

    if (JS.strictEqual(ret, "") && !isAttached(elem)) {
      ret = style(elem, name);
    }

    if (!pixelBoxStyles() && JS.regexTest(rnumnonpx, ret) && rboxStyle.test(name)) {
      JsValue width = styleObj["width"];
      JsValue minWidth = styleObj["minWidth"];
      JsValue maxWidth = styleObj["maxWidth"];

      styleObj["minWidth"] = ret;
      styleObj["maxWidth"] = ret;
      styleObj["width"] = ret;
      ret = computed["width"];

      styleObj["width"] = width;
      styleObj["minWidth"] = minWidth;
      styleObj["maxWidth"] = maxWidth;
    }
  }

  if (JS.isUndefined(ret)) {
    return ret;
  }
  return JS.string(ret);
}

export float adjustCSS(JsValue elem, string prop, JsValue valueParts, JsValue tween = JS.undefined()) {
  float adjusted = 0.0;
  float scale = 0.0 / 0.0;
  float approx = 0.0;
  func()->float currentValue = () => JS.number(if (tween.truthy()) { JS.invoke(tween, "cur") } else { css(elem, prop, "") });
  float initial = currentValue();
  string unit = JS.assume(JS.or(JS.and(valueParts, valueParts[3]), if (cssNumber[prop].truthy()) { "" } else { "px" }));
  JsValue initialInUnit = JS.and(
    JS.and(elem["nodeType"], JS.or(cssNumber[prop], JS.and(unit != "px", initial))),
    JS.regexExec(rcssNum, css(elem, prop))
  );

  if (initialInUnit.truthy() && !JS.strictEqual(initialInUnit[3], unit)) {
    initial = initial / 2.0;
    unit = JS.assume(JS.or(unit, initialInUnit[3]));
    approx = JS.assume(JS.or(initial, 1.0));

    for (float n = 20.0; n > 0.0; n--) {
      style(elem, prop, approx + unit);
      float prev = scale;
      scale = JS.assume(JS.or(currentValue() / initial, 0.5));
      approx = approx / scale;
      if ((1.0 - prev) * (1.0 - scale) <= 0.0) {
        break;
      }
    }

    approx = approx * 2.0;
    style(elem, prop, approx + unit);
    valueParts = JS.or(valueParts, JS.array());
  }

  if (valueParts.truthy()) {
    approx = JS.assume(JS.or(approx, JS.or(initial, 0.0)));
    if (valueParts[1].truthy()) {
      float sign = JS.assume(JS.add(valueParts[1], 1.0));
      float amount = JS.assume(valueParts[2]);
      adjusted = approx + sign * amount;
    } else {
      adjusted = JS.number(valueParts[2]);
    }
    if (tween.truthy()) {
      tween["unit"] = unit;
      tween["start"] = approx;
      tween["end"] = adjusted;
    }
  }
  return adjusted;
}

export JsValue style(JsValue elem, string name, JsValue value = JS.undefined(), JsValue extra = JS.undefined()) {
  if (!elem.truthy() || JS.strictEqual(elem["nodeType"], 3.0) || JS.strictEqual(elem["nodeType"], 8.0) || !elem["style"].truthy()) {
    return JS.undefined();
  }

  JsValue ret = JS.undefined();
  string origName = camelCase(name);
  bool isCustomProp = rcustomProp.test(name);
  JsValue styleObj = elem["style"];

  if (!isCustomProp) {
    name = finalPropName(origName);
  }
  JsValue hooks = JS.or(jQuery["cssHooks"][name], jQuery["cssHooks"][origName]);

  if (JS.isUndefined(value)) {
    if (hooks.truthy() && JS.in("get", hooks)) {
      ret = JS.invoke(hooks, "get", elem, false, extra);
      if (!JS.isUndefined(ret)) {
        return ret;
      }
    }
    return styleObj[name];
  }

  string type = JS.typeOf(value);
  if (type == "string") {
    ret = JS.regexExec(rcssNum, value);
    if (JS.and(ret, ret[1]).truthy()) {
      value = adjustCSS(elem, name, ret);
      type = "number";
    }
  }

  if (JS.isNullish(value) || !JS.strictEqual(value, value)) {
    return JS.undefined();
  }

  if (type == "number" && !isCustomProp) {
    value = JS.add(value, JS.or(JS.and(ret, ret[3]), if (cssNumber[origName].truthy()) { "" } else { "px" }));
  }

  if (!support.clearCloneStyle && JS.strictEqual(value, "") && name.indexOf("background") == 0) {
    styleObj[name] = "inherit";
  }

  // Without a setter `value` is already known to be neither null nor undefined.
  if (hooks.truthy() && JS.in("set", hooks)) {
    value = JS.invoke(hooks, "set", elem, value, extra);
  }
  if (!JS.isUndefined(value)) {
    if (isCustomProp) {
      JS.invoke(styleObj, "setProperty", name, value);
    } else {
      styleObj[name] = value;
    }
  }
  return JS.undefined();
}

export JsValue css(JsValue elem, string name, JsValue extra = JS.undefined(), JsValue styles = JS.undefined()) {
  JsValue val = JS.undefined();
  string origName = camelCase(name);

  if (!rcustomProp.test(name)) {
    name = finalPropName(origName);
  }
  JsValue hooks = JS.or(jQuery["cssHooks"][name], jQuery["cssHooks"][origName]);

  if (hooks.truthy() && JS.in("get", hooks)) {
    val = JS.invoke(hooks, "get", elem, true, extra);
  }
  if (JS.isUndefined(val)) {
    val = curCSS(elem, name, styles);
  }
  if (JS.strictEqual(val, "normal") && JS.in(name, cssNormalTransform)) {
    val = cssNormalTransform[name];
  }

  if (JS.strictEqual(extra, "") || extra.truthy()) {
    float n = parseFloatValue(JS.assume(val));
    if (JS.strictEqual(extra, true) || isFiniteValue(n)) {
      return JS.or(n, 0.0);
    }
  }
  return val;
}

jQuery["style"] = style;
jQuery["css"] = css;

string offsetName(string dimension) {
  return "offset" + dimension.charAt(0).toUpperCase() + dimension.slice(1);
}

// `css(elem, prop, true)` always answers `num || 0`, so its result is read as a number.
float boxModelAdjustment(JsValue elem, string dimension, JsValue box, bool isBorderBox, JsValue styles, float computedVal) {
  float extra = 0.0;
  float delta = 0.0;
  float marginDelta = 0.0;

  if (JS.strictEqual(box, if (isBorderBox) { "border" } else { "content" })) {
    return 0.0;
  }

  for (float i = if (dimension == "width") { 1.0 } else { 0.0 }; i < 4.0; i += 2.0) {
    JsValue side = sides[i];
    if (JS.strictEqual(box, "margin")) {
      marginDelta += num(css(elem, JS.assume(JS.add("margin", side)), true, styles));
    }

    if (!isBorderBox) {
      delta += num(css(elem, JS.assume(JS.add("padding", side)), true, styles));
      if (!JS.strictEqual(box, "padding")) {
        delta += num(css(elem, JS.assume(JS.add(JS.add("border", side), "Width")), true, styles));
      } else {
        extra += num(css(elem, JS.assume(JS.add(JS.add("border", side), "Width")), true, styles));
      }
    } else {
      if (JS.strictEqual(box, "content")) {
        delta -= num(css(elem, JS.assume(JS.add("padding", side)), true, styles));
      }
      if (!JS.strictEqual(box, "margin")) {
        delta -= num(css(elem, JS.assume(JS.add(JS.add("border", side), "Width")), true, styles));
      }
    }
  }

  if (!isBorderBox && computedVal >= 0.0) {
    delta += num(JS.or(mathMax(0.0, mathCeil(num(elem[offsetName(dimension)]) - computedVal - delta - extra - 0.5)), 0.0));
  }

  return delta + marginDelta;
}

JsValue setPositiveNumber(JsValue _elem, JsValue value, JsValue subtract) {
  JsValue matches = JS.regexExec(rcssNum, value);
  if (matches.truthy()) {
    return JS.add(mathMax(0.0, num(matches[2]) - num(JS.or(subtract, 0.0))), JS.or(matches[3], "px"));
  }
  return value;
}

string getWidthOrHeight(JsValue elem, string dimension, JsValue extra) {
  JsValue styles = getStyles(elem);
  bool isBorderBox = (!boxSizingReliable() || extra.truthy()) && JS.strictEqual(css(elem, "boxSizing", false, styles), "border-box");
  bool valueIsBorderBox = isBorderBox;
  JsValue val = curCSS(elem, dimension, styles);
  string offsetProp = offsetName(dimension);

  if (JS.regexTest(rnumnonpx, val)) {
    if (!extra.truthy()) {
      return JS.assume(val);
    }
    val = "auto";
  }

  if ((!boxSizingReliable() && isBorderBox ||
    !reliableTrDimensions() && nodeName(elem, "tr") ||
    JS.strictEqual(val, "auto") ||
    !truthy(parseFloatValue(JS.assume(val))) && JS.strictEqual(css(elem, "display", false, styles), "inline")) &&
    JS.invoke(elem, "getClientRects")["length"].truthy()) {
    isBorderBox = JS.strictEqual(css(elem, "boxSizing", false, styles), "border-box");
    valueIsBorderBox = JS.in(offsetProp, elem);
    if (valueIsBorderBox) {
      val = elem[offsetProp];
    }
  }

  float n = num(JS.or(parseFloatValue(JS.assume(val)), 0.0));
  return JS.string(n + boxModelAdjustment(elem, dimension, JS.or(extra, if (isBorderBox) { "border" } else { "content" }), valueIsBorderBox, styles, n)) + "px";
}

void dimensionHooks(string dimension) {
  cssHooks[dimension] = DimensionHooks{
    (JsValue elem, JsValue computed, JsValue extra) => {
      if (computed.truthy()) {
        if (JS.regexTest(rdisplayswap, css(elem, "display")) &&
          (!JS.invoke(elem, "getClientRects")["length"].truthy() || !JS.invoke(elem, "getBoundingClientRect")["width"].truthy())) {
          return swap(elem, cssShow, (JsValue e) => getWidthOrHeight(e, dimension, extra));
        }
        return getWidthOrHeight(elem, dimension, extra);
      }
      return JS.undefined();
    },
    (JsValue elem, JsValue value, JsValue extra) => {
      JsValue styles = getStyles(elem);
      bool scrollboxSizeBuggy = !scrollboxSize() && JS.strictEqual(styles["position"], "absolute");
      bool isBorderBox = (scrollboxSizeBuggy || extra.truthy()) && JS.strictEqual(css(elem, "boxSizing", false, styles), "border-box");
      float subtract = 0.0;
      if (extra.truthy()) {
        subtract = boxModelAdjustment(elem, dimension, extra, isBorderBox, styles, -1.0);
      }

      if (isBorderBox && scrollboxSizeBuggy) {
        subtract -= mathCeil(
          num(elem[offsetName(dimension)]) -
          parseFloatValue(JS.assume(styles[dimension])) -
          boxModelAdjustment(elem, dimension, "border", false, styles, -1.0) -
          0.5
        );
      }

      JsValue matches = JS.regexExec(rcssNum, value);
      if (JS.and(subtract, matches).truthy() && !JS.strictEqual(JS.or(matches[3], "px"), "px")) {
        elem["style"][dimension] = value;
        value = css(elem, dimension);
      }

      return setPositiveNumber(elem, value, subtract);
    }
  };
}

dimensionHooks("height");
dimensionHooks("width");

cssHooks["marginLeft"] = addGetHookIf(reliableMarginLeft, (JsValue elem, JsValue computed) => {
  if (computed.truthy()) {
    return JS.add(JS.or(
      parseFloatValue(JS.assume(curCSS(elem, "marginLeft"))),
      num(JS.invoke(elem, "getBoundingClientRect")["left"]) -
        num(swap(elem, marginZero, (JsValue e) => JS.invoke(e, "getBoundingClientRect")["left"]))
    ), "px");
  }
  return JS.undefined();
});

void expandHook(string prefix, string suffix) {
  JsValue hook = ExpandHook{(JsValue value) => {
    JsValue expanded = JS.object();
    JsValue parts = if (JS.typeOf(value) == "string") { JS.invoke(value, "split", " ") } else { JS.array(value) };
    for (float i = 0.0; i < 4.0; i++) {
      expanded[str(JS.add(JS.add(prefix, sides[i]), suffix))] = JS.or(JS.or(parts[i], parts[i - 2]), parts[0]);
    }
    return expanded;
  }};
  if (prefix != "margin") {
    hook["set"] = setPositiveNumber;
  }
  cssHooks[prefix + suffix] = hook;
}

expandHook("margin", "");
expandHook("padding", "");
expandHook("border", "Width");

JsValue fnCss(JsValue name, JsValue value) {
  return access(this, (JsValue elem, JsValue name, JsValue value) => {
    if (JS.isArray(name)) {
      JsValue styles = getStyles(elem);
      JsValue map = JS.object();
      float len = name.length;
      for (float i = 0.0; i < len; i++) {
        string key = JS.assume(name[i]);
        map[key] = css(elem, key, false, styles);
      }
      return map;
    }
    return if (JS.isUndefined(value)) { css(elem, JS.assume(name)) } else { style(elem, JS.assume(name), value) };
  }, name, value, arguments.length > 1.0, JS.undefined(), false);
}

fn["css"] = fnCss;

export { jQuery };
