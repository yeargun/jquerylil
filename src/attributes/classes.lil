extern JsValue arguments;
extern JsValue this;
import { jQuery, each, wrap } from "../core";
import { stripAndCollapse } from "../core/stripAndCollapse";
import { isFunction } from "../var/isFunction";
import { rnothtmlwhite } from "../var/rnothtmlwhite";
import { get as dataPrivGet, set as dataPrivSet } from "../data/var/dataPriv";

JsValue getClass(JsValue elem) {
  return JS.or(JS.and(elem["getAttribute"], JS.invoke(elem, "getAttribute", "class")), "");
}

JsValue classesToArray(JsValue value) {
  if (JS.isArray(value)) {
    return value;
  }
  if (value is string) {
    return JS.or(JS.stringMatch(value, rnothtmlwhite), JS.array());
  }
  return JS.array();
}

JsValue classOp(JsValue self, JsValue value, string method, func(string, JsValue)->string update) {
  if (isFunction(value)) {
    return each(self, (JsValue j, JsValue elem) => {
      JS.invoke(wrap(elem), method, JS.call(value, elem, j, getClass(elem)));
      return JS.undefined();
    });
  }

  JsValue classNames = classesToArray(value);
  if (classNames.length > 0.0) {
    return each(self, (JsValue _i, JsValue elem) => {
      JsValue curValue = getClass(elem);
      if (elem["nodeType"] == 1.0) {
        string cur = " " + stripAndCollapse(JS.assume(curValue)) + " ";
        for (float i = 0.0; i < classNames.length; i++) {
          cur = update(cur, classNames[i]);
        }
        string finalValue = stripAndCollapse(cur);
        if (curValue != finalValue) {
          JS.invoke(elem, "setAttribute", "class", finalValue);
        }
      }
      return JS.undefined();
    });
  }
  return self;
}

export JsValue addClass(JsValue value) {
  return classOp(this, value, "addClass", (string cur, JsValue className) => {
    if (cur.indexOf(" " + className + " ") < 0) {
      return cur + className + " ";
    }
    return cur;
  });
}

JsValue removeClass(JsValue value) {
  if (arguments.length == 0.0) {
    return JS.invoke(this, "attr", "class", "");
  }
  return classOp(this, value, "removeClass", (string cur, JsValue className) => {
    string needle = " " + className + " ";
    while (cur.indexOf(needle) > -1) {
      cur = JS.assume(JS.invoke(cur, "replace", needle, " "));
    }
    return cur;
  });
}

JsValue toggleClass(JsValue value, JsValue stateVal) {
  string type = JS.typeOf(value);
  bool isValidValue = type == "string" || JS.isArray(value);

  if (isFunction(value)) {
    return each(this, (JsValue i, JsValue elem) => {
      JS.invoke(wrap(elem), "toggleClass", JS.call(value, elem, i, getClass(elem), stateVal), stateVal);
      return JS.undefined();
    });
  }

  if (stateVal is bool && isValidValue) {
    if (stateVal) {
      return JS.invoke(this, "addClass", value);
    }
    return JS.invoke(this, "removeClass", value);
  }

  JsValue classNames = classesToArray(value);

  return each(this, (JsValue _i, JsValue elem) => {
    if (isValidValue) {
      JsValue self = wrap(elem);
      for (float i = 0.0; i < classNames.length; i++) {
        JsValue className = classNames[i];
        if (JS.invoke(self, "hasClass", className).truthy()) {
          JS.invoke(self, "removeClass", className);
        } else {
          JS.invoke(self, "addClass", className);
        }
      }
    } else if (JS.isUndefined(value) || type == "boolean") {
      JsValue className = getClass(elem);
      if (className.truthy()) {
        dataPrivSet(elem, "__className__", className);
      }
      if (elem["setAttribute"].truthy()) {
        JS.invoke(elem, "setAttribute", "class",
          if (className.truthy() || JS.strictEqual(value, false)) { "" } else { JS.or(dataPrivGet(elem, "__className__"), "") });
      }
    }
    return JS.undefined();
  });
}

JsValue hasClass(JsValue selector) {
  string className = " " + selector + " ";
  float i = 0.0;
  while (true) {
    JsValue elem = this[i];
    i++;
    if (!elem.truthy()) {
      break;
    }
    if (elem["nodeType"] == 1.0 && (" " + stripAndCollapse(JS.assume(getClass(elem))) + " ").indexOf(className) > -1) {
      return true;
    }
  }
  return false;
}

JS.invoke(jQuery["fn"], "extend", JS.object(
  "addClass", addClass,
  "removeClass", removeClass,
  "toggleClass", toggleClass,
  "hasClass", hasClass
));

export { jQuery };
