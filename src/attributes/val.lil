extern JsValue arguments;
extern JsValue this;
import { jQuery, each, map, text, makeArray, inArray, wrap } from "../core";
import { stripAndCollapse } from "../core/stripAndCollapse";
import { nodeName } from "../core/nodeName";
import { support } from "./support";
import { isFunction } from "../var/isFunction";
import { find } from "../selector";

Regex rreturn = new Regex("\\r", "g");

JsValue optionGet(JsValue elem) {
  JsValue val = JS.invoke(find, "attr", elem, "value");
  if (JS.isNullish(val)) {
    return stripAndCollapse(JS.assume(text(elem)));
  }
  return val;
}

JsValue valHooks = JS.object(
  "option", JS.object("get", optionGet),
  "select", JS.object(
    "get", (JsValue elem) => {
      JsValue options = elem["options"];
      float index = JS.assume(elem["selectedIndex"]);
      bool one = elem["type"] == "select-one";
      JsValue[] values = [];
      float max = if (one) { index + 1.0 } else { options.length };
      float i = if (index < 0.0) { max } else { if (one) { index } else { 0.0 } };

      for (; i < max; i++) {
        JsValue option = options[i];
        if ((option["selected"].truthy() || i == index) &&
            !option["disabled"].truthy() &&
            (!option["parentNode"]["disabled"].truthy() || !nodeName(option["parentNode"], "optgroup"))) {
          JsValue value = JS.invoke(wrap(option), "val");
          if (one) {
            return value;
          }
          values.push(value);
        }
      }
      if (one) {
        return null;
      }
      return values;
    },
    "set", (JsValue elem, JsValue value) => {
      JsValue options = elem["options"];
      JsValue values = makeArray(value);
      bool optionSet = false;
      float i = options.length;
      while (i > 0.0) {
        i--;
        JsValue option = options[i];
        bool selected = inArray(JS.invoke(valHooks["option"], "get", option), values) > -1.0;
        option["selected"] = selected;
        if (selected) {
          optionSet = true;
        }
      }
      if (!optionSet) {
        elem["selectedIndex"] = -1.0;
      }
      return values;
    }
  )
);

each(JS.array("radio", "checkbox"), (JsValue _i, JsValue type) => {
  JsValue hooks = JS.object("set", (JsValue elem, JsValue value) => {
    if (JS.isArray(value)) {
      bool checked = inArray(JS.invoke(wrap(elem), "val"), value) > -1.0;
      elem["checked"] = checked;
      return checked;
    }
    return JS.undefined();
  });
  valHooks[type] = hooks;
  if (!support.checkOn) {
    hooks["get"] = (JsValue elem) => {
      if (JS.strictEqual(JS.invoke(elem, "getAttribute", "value"), null)) {
        return "on";
      }
      return elem["value"];
    };
  }
  return JS.undefined();
});

JsValue hooksFor(JsValue elem) {
  return JS.or(valHooks[elem["type"]], valHooks[JS.invoke(elem["nodeName"], "toLowerCase")]);
}

export JsValue fnVal(JsValue value) {
  JsValue elem = this[0];

  if (arguments.length == 0.0) {
    if (elem.truthy()) {
      JsValue hooks = hooksFor(elem);
      if (hooks.truthy() && JS.in("get", hooks)) {
        JsValue ret = JS.invoke(hooks, "get", elem, "value");
        if (!JS.isUndefined(ret)) {
          return ret;
        }
      }
      JsValue ret = elem["value"];
      if (ret is string) {
        return JS.stringReplace(ret, rreturn, "");
      }
      if (JS.isNullish(ret)) {
        return "";
      }
      return ret;
    }
    return JS.undefined();
  }

  bool valueIsFunction = isFunction(value);

  return each(this, (JsValue i, JsValue el) => {
    if (el["nodeType"] != 1.0) {
      return JS.undefined();
    }

    JsValue val = value;
    if (valueIsFunction) {
      val = JS.call(value, el, i, JS.invoke(wrap(el), "val"));
    }

    if (JS.isNullish(val)) {
      val = "";
    } else if (val is float) {
      val = JS.add(val, "");
    } else if (JS.isArray(val)) {
      val = map(val, (JsValue v) => if (JS.isNullish(v)) { "" } else { JS.add(v, "") });
    }

    JsValue hooks = hooksFor(el);
    if (!hooks.truthy() || !JS.in("set", hooks) || JS.isUndefined(JS.invoke(hooks, "set", el, val, "value"))) {
      el["value"] = val;
    }
    return JS.undefined();
  });
}

jQuery["fn"]["val"] = fnVal;
jQuery["valHooks"] = valHooks;

export { jQuery };
