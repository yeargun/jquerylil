extern JsValue arguments;
extern JsValue this;
import { jQuery, each, isXMLDoc } from "../core";
import { access } from "../core/access";
import { support } from "./support";
import { find } from "../selector";
import { parseIntRadix } from "../js-host.lil";

Regex rfocusable = new Regex("^(?:input|select|textarea|button)$", "i");
Regex rclickable = new Regex("^(?:a|area)$", "i");

JsValue propFix = JS.object("for", "htmlFor", "class", "className");

JsValue propHooks = JS.object("tabIndex", JS.object("get", (JsValue elem) => {
  JsValue tabindex = JS.invoke(find, "attr", elem, "tabindex");
  if (tabindex.truthy()) {
    return parseIntRadix(JS.assume(tabindex), 10.0);
  }
  if (JS.regexTest(rfocusable, elem["nodeName"]) || (JS.regexTest(rclickable, elem["nodeName"]) && elem["href"].truthy())) {
    return 0.0;
  }
  return -1.0;
}));

if (!support.optSelected) {
  propHooks["selected"] = JS.object(
    "get", (JsValue elem) => {
      JsValue parent = elem["parentNode"];
      if (parent.truthy() && parent["parentNode"].truthy()) {
        parent["parentNode"]["selectedIndex"];
      }
      return null;
    },
    "set", (JsValue elem) => {
      JsValue parent = elem["parentNode"];
      if (parent.truthy()) {
        parent["selectedIndex"];
        if (parent["parentNode"].truthy()) {
          parent["parentNode"]["selectedIndex"];
        }
      }
      return JS.undefined();
    }
  );
}

export JsValue prop(JsValue elem, JsValue name, JsValue value) {
  JsValue nType = elem["nodeType"];
  if (nType == 3.0 || nType == 8.0 || nType == 2.0) {
    return JS.undefined();
  }

  JsValue hooks = null;
  if (nType != 1.0 || !isXMLDoc(elem)) {
    name = JS.or(propFix[name], name);
    hooks = propHooks[name];
  }

  if (!JS.isUndefined(value)) {
    if (hooks.truthy() && JS.in("set", hooks)) {
      JsValue ret = JS.invoke(hooks, "set", elem, value, name);
      if (!JS.isUndefined(ret)) {
        return ret;
      }
    }
    elem[name] = value;
    return value;
  }

  if (hooks.truthy() && JS.in("get", hooks)) {
    JsValue ret = JS.invoke(hooks, "get", elem, name);
    if (!JS.strictEqual(ret, null)) {
      return ret;
    }
  }
  return elem[name];
}

export JsValue fnProp(JsValue name, JsValue value) {
  return access(this, prop, name, value, arguments.length > 1.0, JS.undefined(), false);
}

export JsValue fnRemoveProp(JsValue name) {
  return each(this, (JsValue _i, JsValue elem) => {
    JS.delete(elem, JS.or(propFix[name], name));
    return JS.undefined();
  });
}

JS.invoke(jQuery["fn"], "extend", JS.object(
  "prop", fnProp,
  "removeProp", fnRemoveProp
));

JS.invoke(jQuery, "extend", JS.object(
  "prop", prop,
  "propHooks", propHooks,
  "propFix", propFix
));

each(JS.array("tabIndex", "readOnly", "maxLength", "cellSpacing", "cellPadding", "rowSpan", "colSpan", "useMap", "frameBorder", "contentEditable"), (JsValue _i, JsValue name) => {
  propFix[JS.invoke(name, "toLowerCase")] = name;
  return JS.undefined();
});

export { jQuery };
