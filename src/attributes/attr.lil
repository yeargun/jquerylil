extern JsValue arguments;
extern JsValue this;
import { jQuery, each, isXMLDoc } from "../core";
import { access } from "../core/access";
import { nodeName } from "../core/nodeName";
import { support } from "./support";
import { prop } from "./prop";
import { rnothtmlwhite } from "../var/rnothtmlwhite";
import { expr, find, boolAttrPattern } from "../selector";

JsValue removeAttr(JsValue elem, JsValue value) {
  JsValue attrNames = JS.and(value, JS.invoke(value, "match", rnothtmlwhite));
  if (attrNames.truthy() && elem["nodeType"] == 1.0) {
    for (float i = 0.0; i < attrNames.length; i++) {
      JS.invoke(elem, "removeAttribute", attrNames[i]);
    }
  }
  return JS.undefined();
}

JsValue attrHooks = JS.object("type", JS.object("set", (JsValue elem, JsValue value) => {
  if (!support.radioValue && value == "radio" && nodeName(elem, "input")) {
    JsValue val = elem["value"];
    JS.invoke(elem, "setAttribute", "type", value);
    if (val.truthy()) {
      elem["value"] = val;
    }
    return value;
  }
  return JS.undefined();
}));

JsValue boolHook = JS.object("set", (JsValue elem, JsValue value, JsValue name) => {
  if (JS.strictEqual(value, false)) {
    removeAttr(elem, name);
  } else {
    JS.invoke(elem, "setAttribute", name, name);
  }
  return name;
});

export JsValue attr(JsValue elem, JsValue name, JsValue value) {
  JsValue nType = elem["nodeType"];
  if (nType == 3.0 || nType == 8.0 || nType == 2.0) {
    return JS.undefined();
  }

  if (JS.isUndefined(elem["getAttribute"])) {
    return prop(elem, name, value);
  }

  JsValue hooks = null;
  if (nType != 1.0 || !isXMLDoc(elem)) {
    hooks = JS.or(attrHooks[JS.invoke(name, "toLowerCase")], JS.and(JS.regexTest(boolAttrPattern, name), boolHook));
  }

  if (!JS.isUndefined(value)) {
    if (JS.strictEqual(value, null)) {
      removeAttr(elem, name);
      return JS.undefined();
    }

    if (hooks.truthy() && JS.in("set", hooks)) {
      JsValue ret = JS.invoke(hooks, "set", elem, value, name);
      if (!JS.isUndefined(ret)) {
        return ret;
      }
    }

    JS.invoke(elem, "setAttribute", name, JS.add(value, ""));
    return value;
  }

  if (hooks.truthy() && JS.in("get", hooks)) {
    JsValue ret = JS.invoke(hooks, "get", elem, name);
    if (!JS.strictEqual(ret, null)) {
      return ret;
    }
  }

  JsValue ret = JS.invoke(find, "attr", elem, name);
  if (JS.isNullish(ret)) {
    return JS.undefined();
  }
  return ret;
}

export JsValue fnAttr(JsValue name, JsValue value) {
  return access(this, attr, name, value, arguments.length > 1.0, JS.undefined(), false);
}

JsValue fnRemoveAttr(JsValue name) {
  return each(this, (JsValue _i, JsValue elem) => removeAttr(elem, name));
}

JS.invoke(jQuery["fn"], "extend", JS.object(
  "attr", fnAttr,
  "removeAttr", fnRemoveAttr
));

JS.invoke(jQuery, "extend", JS.object(
  "attr", attr,
  "attrHooks", attrHooks,
  "removeAttr", removeAttr
));

JsValue attrHandle = expr["attrHandle"];

JsValue installBoolHandle(JsValue _i, JsValue name) {
  JsValue getter = JS.or(attrHandle[name], find["attr"]);

  attrHandle[name] = (JsValue elem, JsValue nameArg, JsValue isXML) => {
    JsValue ret = JS.undefined();
    JsValue lowercaseName = JS.invoke(nameArg, "toLowerCase");
    if (!isXML.truthy()) {
      JsValue handle = attrHandle[lowercaseName];
      attrHandle[lowercaseName] = ret;
      ret = if (JS.isNullish(getter(elem, nameArg, isXML))) { null } else { lowercaseName };
      attrHandle[lowercaseName] = handle;
    }
    return ret;
  };
  return JS.undefined();
}

each(JS.stringMatch(boolAttrPattern.source, new Regex("\\w+", "g")), installBoolHandle);

export { jQuery };
