import { jQuery, each } from "./core";
import { camelCase } from "./core/camelCase";
import {
  get as dataPrivGet,
  set as dataPrivSet,
  access as dataPrivAccess,
  remove as dataPrivRemove,
  hasData as dataPrivHasData
} from "./data/var/dataPriv";
import {
  get as dataUserGet,
  set as dataUserSet,
  access as dataUserAccess,
  remove as dataUserRemove,
  hasData as dataUserHasData
} from "./data/var/dataUser";


JsValue getData(string data) {
  return if (data == "true") {
    true
  } else {
    if (data == "false") {
      false
    } else {
      if (data == "null") {
        null
      } else {
        if (data == JS.add(JS.number(data), "")) {
          JS.number(data)
        } else {
          if (JS.regexTest(new Regex("^(?:\\{[\\w\\W]*\\}|\\[[\\w\\W]*\\])$"), data)) { JSON.parse(data) } else { data }
        }
      }
    }
  };
}

JsValue dataAttr(JsValue elem, string key, JsValue data = JS.undefined()) {
  if (JS.isUndefined(data) && elem["nodeType"] == 1.0) {
    data = JS.invoke(elem, "getAttribute", "data-" + JS.stringReplace(key, new Regex("[A-Z]", "g"), "-$&").toLowerCase());
    if (data is string) {
      try {
        data = getData(data);
      } catch {
      }
      dataUserSet(elem, key, data);
    } else {
      data = JS.undefined();
    }
  }
  return data;
}

jQuery["hasData"] = (JsValue elem) => {
  return dataUserHasData(elem) || dataPrivHasData(elem);
};

jQuery["data"] = dataUserAccess;
jQuery["removeData"] = dataUserRemove;
jQuery["_data"] = dataPrivAccess;
jQuery["_removeData"] = dataPrivRemove;

jQuery["fn"]["data"] = JS.methodRest((JsValue self, JsValue args) => {
  JsValue key = args[0];
  JsValue value = args[1];
  JsValue elem = self[0];

  if (JS.isUndefined(key)) {
    JsValue data = JS.undefined();
    if (self.length != 0.0) {
      data = dataUserGet(elem);
      if (elem["nodeType"] == 1.0 && !dataPrivGet(elem, "hasDataAttrs").truthy()) {
        JsValue attrs = elem["attributes"];
        float i = attrs.length;
        while (i > 0.0) {
          i--;
          if (attrs[i].truthy()) {
            string name = JS.assume(attrs[i]["name"]);
            if (name.indexOf("data-") == 0) {
              name = camelCase(name.slice(5));
              dataAttr(elem, name, data[name]);
            }
          }
        }
        dataPrivSet(elem, "hasDataAttrs", true);
      }
    }
    return data;
  }

  if (key.isObject()) {
    return each(self, (JsValue _i, JsValue el) => {
      dataUserSet(el, key);
      return JS.undefined();
    });
  }

  if (args.length > 1.0) {
    if (!JS.isUndefined(value)) {
      each(self, (JsValue _i, JsValue el) => {
        dataUserSet(el, key, value);
        return JS.undefined();
      });
    }
    return self;
  }

  if (elem.truthy()) {
    JsValue data = dataUserGet(elem, key);
    return if (JS.isUndefined(data)) { dataAttr(elem, JS.assume(key)) } else { data };
  }
  return JS.undefined();
});

jQuery["fn"]["removeData"] = JS.method1((JsValue self, JsValue key) => {
  return each(self, (JsValue _i, JsValue el) => {
    dataUserRemove(el, key);
    return JS.undefined();
  });
});

export { jQuery };
