extern JsValue Math;
import { jQuery } from "./core";
import { access } from "./core/access";
import { isWindow } from "./var/isWindow";
import { css, style, fn } from "./css";

void dimensionMethod(string name, string type, string defaultExtra, string funcName) {
  fn[funcName] = JS.methodRest((JsValue self, JsValue args) => {
    JsValue margin = args[0];
    bool chainable = args.length > 0.0 && (defaultExtra != "" || !(margin is bool));
    string extra = JS.assume(JS.or(defaultExtra, if (JS.strictEqual(margin, true) || JS.strictEqual(args[1], true)) { "margin" } else { "border" }));

    return access(self, (JsValue elem, JsValue _type, JsValue value) => {
      if (isWindow(elem)) {
        return if (defaultExtra == "") { elem["inner" + name] } else { elem["document"]["documentElement"]["client" + name] };
      }

      if (JS.strictEqual(elem["nodeType"], 9.0)) {
        JsValue doc = elem["documentElement"];
        return JS.invoke(Math, "max",
          elem["body"]["scroll" + name], doc["scroll" + name],
          elem["body"]["offset" + name], doc["offset" + name],
          doc["client" + name]
        );
      }

      return if (JS.isUndefined(value)) { css(elem, type, extra) } else { style(elem, type, value, extra) };
    }, type, if (chainable) { margin } else { JS.undefined() }, chainable, JS.undefined(), false);
  });
}

void dimensionMethods(string name) {
  string type = name.toLowerCase();
  dimensionMethod(name, type, "padding", "inner" + name);
  dimensionMethod(name, type, "content", type);
  dimensionMethod(name, type, "", "outer" + name);
}

dimensionMethods("Height");
dimensionMethods("Width");

export { jQuery };
