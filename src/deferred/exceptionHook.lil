import { jQuery } from "../deferred";
import { windowSelf } from "../js-host.lil";


jQuery["Deferred"]["exceptionHook"] = (JsValue error, JsValue asyncError) => {
  JsValue console = windowSelf()["console"];
  if (console.truthy() && console["warn"].truthy() && error.truthy() && JS.regexTest(new Regex("^(Eval|Internal|Range|Reference|Syntax|Type|URI)Error$"), error["name"])) {
    JS.invoke(console, "warn", JS.add("jQuery.Deferred exception: ", error["message"]), error["stack"], asyncError);
  }
};

export { jQuery };
