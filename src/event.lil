extern JsValue this;
import { jQuery, isEmptyObject, each, makeArray } from "./core";
import { document } from "./var/document";
import { documentElement } from "./var/documentElement";
import { rnothtmlwhite } from "./var/rnothtmlwhite";
import { rcheckableType } from "./var/rcheckableType";
import { isFunction } from "./var/isFunction";
import { isWindow } from "./var/isWindow";
import { acceptData } from "./data/var/acceptData";
import {
  get as dataPrivGet,
  set as dataPrivSet,
  remove as dataPrivRemove,
  hasData as dataPrivHasData
} from "./data/var/dataPriv";
import { nodeName } from "./core/nodeName";
import { needsContextPattern, findImpl, matchesSelectorImpl } from "./selector";
import { containsImpl } from "./selector/contains";
import {
  objectCreate,
  createNullProtoObject,
  dateNow,
  newRegexp,
  windowSelf,
  objectHasOwn
} from "./js-host.lil";

/*
 * Port of upstream event.js and event/trigger.js, written in upstream's shape: the
 * handleObj, the handler queue entries, and jQuery.Event are plain objects, and the
 * public jQuery.event functions take upstream's arguments. `document.documentMode`
 * (IE) branches are dropped; only the evergreen-browser path is kept. Event
 * properties (altKey, which, ...) are copied from the native event when the
 * jQuery.Event is created rather than installed as lazy prototype getters.
 */

Regex rtypenamespace = new Regex("^([^.]*)(?:\\.(.+)|)");
Regex rfocusMorph = new Regex("^(?:focusinfocus|focusoutblur)$");

JsValue returnTrue() {
  return true;
}

JsValue returnFalse() {
  return false;
}

JsValue global = JS.object();

JsValue checkableInput(JsValue el) {
  return JS.and(JS.and(JS.invoke(rcheckableType, "test", el["type"]), el["click"]), nodeName(el, "input"));
}

// Utilize native event to ensure correct state for checkable inputs. The unused `data`
// keeps upstream's arity (setup.length and trigger.length are 1).
JsValue clickSetup(JsValue data) {
  // Claim the first handler
  if (checkableInput(this).truthy()) {
    leverageNative(this, "click", true);
  }
  // Return false to allow normal processing in the caller
  return false;
}

JsValue clickTrigger(JsValue data) {
  // Force setup before triggering a click
  if (checkableInput(this).truthy()) {
    leverageNative(this, "click", false);
  }
  // Return non-false to allow normal event-path propagation
  return true;
}

JsValue specialEvents = object {
  load: object {
    // Prevent triggered image.load events from bubbling to window.load
    noBubble: true
  },
  click: object {
    setup: clickSetup,
    trigger: clickTrigger,
    // For cross-browser consistency, suppress native .click() on links
    // Also prevent it if we're currently inside a leveraged native-event stack
    _default: (JsValue event) => {
      JsValue target = event["target"];
      return JS.or(JS.and(checkableInput(target), dataPrivGet(target, "click")), nodeName(target, "a"));
    }
  },
  beforeunload: object {
    postDispatch: (JsValue event) => {
      // Support: Firefox 20+
      // Firefox doesn't alert if the returnValue field is not set.
      if (!JS.isUndefined(event["result"]) && event["originalEvent"].truthy()) {
        event["originalEvent"]["returnValue"] = event["result"];
      }
      return JS.undefined();
    }
  }
};

// Make sure that the handler has a unique ID, used to find/remove it later
JsValue guidOf(JsValue handler) {
  if (!handler["guid"].truthy()) {
    float guid = JS.assume(jQuery["guid"]);
    jQuery["guid"] = guid + 1.0;
    handler["guid"] = guid;
  }
  return handler["guid"];
}

JsValue on(JsValue elem, JsValue types, JsValue selector, JsValue data, JsValue fn, JsValue one = JS.undefined()) {
  // Types can be a map of types/handlers
  if (JS.typeOf(types) == "object") {
    // ( types-Object, selector, data )
    if (JS.typeOf(selector) != "string") {
      // ( types-Object, data )
      data = JS.or(data, selector);
      selector = JS.undefined();
    }
    for (string type in types) {
      on(elem, type, selector, data, types[type], one);
    }
    return elem;
  }

  if (JS.isNullish(data) && JS.isNullish(fn)) {
    // ( types, fn )
    fn = selector;
    data = JS.undefined();
    selector = JS.undefined();
  } else if (JS.isNullish(fn)) {
    fn = data;
    if (JS.typeOf(selector) == "string") {
      // ( types, selector, fn )
      data = JS.undefined();
    } else {
      // ( types, data, fn )
      data = selector;
      selector = JS.undefined();
    }
  }
  if (JS.isFalse(fn)) {
    fn = returnFalse;
  } else if (!fn.truthy()) {
    return elem;
  }

  if (one.truthy()) {
    JsValue origFn = fn;
    fn = JS.methodRest((JsValue self, JsValue args) => {
      // Can use an empty set, since event contains the info
      JS.invoke(jQuery(), "off", args[0]);
      return JS.apply(origFn, self, args);
    });
    // Use same guid so caller can remove using origFn
    fn["guid"] = guidOf(origFn);
  }
  return each(elem, JS.method0((JsValue el) => {
    add(el, types, fn, data, selector);
    return JS.undefined();
  }));
}

export void add(JsValue elem, JsValue types, JsValue handler, JsValue data = JS.undefined(), JsValue selector = JS.undefined()) {
  // Only attach events to objects that accept data
  if (!acceptData(elem)) {
    return;
  }
  JsValue elemData = dataPrivGet(elem);

  // Caller can pass in an object of custom data in lieu of the handler
  JsValue handleObjIn = JS.undefined();
  if (handler["handler"].truthy()) {
    handleObjIn = handler;
    handler = handleObjIn["handler"];
    selector = handleObjIn["selector"];
  }

  // Ensure that invalid selectors throw exceptions at attach time
  if (selector.truthy()) {
    matchesSelectorImpl(documentElement, JS.assume(selector));
  }

  guidOf(handler);

  // Init the element's event structure and main handler, if this is the first
  JsValue events = elemData["events"];
  if (!events.truthy()) {
    events = createNullProtoObject();
    elemData["events"] = events;
  }
  JsValue eventHandle = elemData["handle"];
  if (!eventHandle.truthy()) {
    eventHandle = JS.methodRest((JsValue self, JsValue args) => {
      // Discard the second event of a jQuery.event.trigger()
      return if (JS.strictEqual(jQuery["event"]["triggered"], args[0]["type"])) { JS.undefined() } else { dispatch(elem, args) };
    });
    elemData["handle"] = eventHandle;
  }

  // Handle multiple events separated by a space
  types = JS.or(JS.invoke(JS.or(types, ""), "match", rnothtmlwhite), [""]);
  float t = types.length;
  while (t > 0.0) {
    t = t - 1.0;
    JsValue tmp = JS.invoke(rtypenamespace, "exec", types[t]);
    JsValue type = tmp[1];
    JsValue origType = type;
    JsValue namespaces = JS.invoke(JS.invoke(JS.or(tmp[2], ""), "split", "."), "sort");

    // There *must* be a type, no attaching namespace-only handlers
    if (!type.truthy()) {
      continue;
    }

    // If event changes its type, use the special event handlers for the changed type
    JsValue special = JS.or(specialEvents[type], JS.object());

    // If selector defined, determine special event api type, otherwise given type
    type = JS.or(if (selector.truthy()) { special["delegateType"] } else { special["bindType"] }, type);

    // Update special based on newly reset type
    special = JS.or(specialEvents[type], JS.object());

    // handleObj is passed to all event handlers
    JsValue handleObj = JS.invoke(jQuery, "extend", object {
      type: type,
      origType: origType,
      data: data,
      handler: handler,
      guid: handler["guid"],
      selector: selector,
      needsContext: JS.and(selector, JS.invoke(needsContextPattern, "test", selector)),
      namespace: JS.invoke(namespaces, "join", ".")
    }, handleObjIn);

    // Init the event handler queue if we're the first
    JsValue handlers = events[type];
    if (!handlers.truthy()) {
      handlers = JS.array();
      events[type] = handlers;
      handlers["delegateCount"] = 0.0;

      // Only use addEventListener if the special events handler returns false
      if (!special["setup"].truthy() || JS.isFalse(JS.call(special["setup"], elem, data, namespaces, eventHandle))) {
        if (elem["addEventListener"].truthy()) {
          JS.invoke(elem, "addEventListener", type, eventHandle);
        }
      }
    }

    if (special["add"].truthy()) {
      JS.call(special["add"], elem, handleObj);
      if (!handleObj["handler"]["guid"].truthy()) {
        handleObj["handler"]["guid"] = handler["guid"];
      }
    }

    // Add to the element's handler list, delegates in front
    if (selector.truthy()) {
      float delegateCount = JS.assume(handlers["delegateCount"]);
      handlers["delegateCount"] = delegateCount + 1.0;
      JS.invoke(handlers, "splice", delegateCount, 0.0, handleObj);
    } else {
      JS.invoke(handlers, "push", handleObj);
    }

    // Keep track of which events have ever been used, for event optimization
    global[type] = true;
  }
}

// Detach an event or set of events from an element
export void remove(JsValue elem, JsValue types, JsValue handler = JS.undefined(), JsValue selector = JS.undefined(), JsValue mappedTypes = JS.undefined()) {
  if (!dataPrivHasData(elem)) {
    return;
  }
  JsValue elemData = dataPrivGet(elem);
  JsValue events = elemData["events"];
  if (!events.truthy()) {
    return;
  }

  // Once for each type.namespace in types; type may be omitted
  types = JS.or(JS.invoke(JS.or(types, ""), "match", rnothtmlwhite), [""]);
  float t = types.length;
  while (t > 0.0) {
    t = t - 1.0;
    JsValue tmp = JS.invoke(rtypenamespace, "exec", types[t]);
    JsValue type = tmp[1];
    JsValue origType = type;
    JsValue namespaces = JS.invoke(JS.invoke(JS.or(tmp[2], ""), "split", "."), "sort");

    // Unbind all events (on this namespace, if provided) for the element
    if (!type.truthy()) {
      for (string eventType in events) {
        remove(elem, JS.add(eventType, types[t]), handler, selector, true);
      }
      continue;
    }

    JsValue special = JS.or(specialEvents[type], JS.object());
    type = JS.or(if (selector.truthy()) { special["delegateType"] } else { special["bindType"] }, type);
    JsValue handlers = JS.or(events[type], JS.array());
    JsValue namespaceMatcher = JS.and(tmp[2], newRegexp("(^|\\.)" + JS.string(JS.invoke(namespaces, "join", "\\.(?:.*\\.|)")) + "(\\.|$)"));

    // Remove matching events
    float origCount = handlers.length;
    float j = origCount;
    while (j > 0.0) {
      j = j - 1.0;
      JsValue handleObj = handlers[j];

      if ((mappedTypes.truthy() || origType == handleObj["origType"]) &&
        (!handler.truthy() || handler["guid"] == handleObj["guid"]) &&
        (!namespaceMatcher.truthy() || JS.invoke(namespaceMatcher, "test", handleObj["namespace"]).truthy()) &&
        (!selector.truthy() || selector == handleObj["selector"] ||
          selector == "**" && handleObj["selector"].truthy())) {
        JS.invoke(handlers, "splice", j, 1.0);

        if (handleObj["selector"].truthy()) {
          float delegateCount = JS.assume(handlers["delegateCount"]);
          handlers["delegateCount"] = delegateCount - 1.0;
        }
        if (special["remove"].truthy()) {
          JS.call(special["remove"], elem, handleObj);
        }
      }
    }

    // Remove generic event handler if we removed something and no more handlers exist
    // (avoids potential for endless recursion during removal of special event handlers)
    if (origCount > 0.0 && handlers.length == 0.0) {
      if (!special["teardown"].truthy() || JS.isFalse(JS.call(special["teardown"], elem, namespaces, elemData["handle"]))) {
        removeEvent(elem, type, elemData["handle"]);
      }
      JS.delete(events, type);
    }
  }

  // Remove data and the expando if it's no longer used
  if (isEmptyObject(events)) {
    dataPrivRemove(elem, "handle events");
  }
}

JsValue dispatch(JsValue self, JsValue args) {
  // Make a writable jQuery.Event from the native event object
  JsValue event = fix(args[0]);
  JsValue handlers = JS.or(JS.or(dataPrivGet(self, "events"), JS.object())[event["type"]], JS.array());
  JsValue special = JS.or(specialEvents[event["type"]], JS.object());

  // Use the fix-ed jQuery.Event rather than the (read-only) native event
  args[0] = event;
  event["delegateTarget"] = self;

  // Call the preDispatch hook for the mapped type, and let it bail if desired
  if (special["preDispatch"].truthy() && JS.isFalse(JS.call(special["preDispatch"], self, event))) {
    return JS.undefined();
  }

  // Determine handlers
  JsValue handlerQueue = handlersImpl(self, event, handlers);

  // Run delegates first; they may want to stop propagation beneath us
  for (float i = 0.0; i < handlerQueue.length && !JS.invoke(event, "isPropagationStopped").truthy(); i++) {
    JsValue matched = handlerQueue[i];
    event["currentTarget"] = matched["elem"];

    for (float j = 0.0; j < matched["handlers"].length && !JS.invoke(event, "isImmediatePropagationStopped").truthy(); j++) {
      JsValue handleObj = matched["handlers"][j];

      // If the event is namespaced, then each handler is only invoked if it is
      // specially universal or its namespaces are a superset of the event's.
      if (!event["rnamespace"].truthy() || JS.isFalse(handleObj["namespace"]) ||
        JS.invoke(event["rnamespace"], "test", handleObj["namespace"]).truthy()) {
        event["handleObj"] = handleObj;
        event["data"] = handleObj["data"];

        JsValue ret = JS.apply(
          JS.or(JS.or(specialEvents[handleObj["origType"]], JS.object())["handle"], handleObj["handler"]),
          matched["elem"],
          args
        );

        if (!JS.isUndefined(ret)) {
          event["result"] = ret;
          if (JS.isFalse(ret)) {
            JS.invoke(event, "preventDefault");
            JS.invoke(event, "stopPropagation");
          }
        }
      }
    }
  }

  // Call the postDispatch hook for the mapped type
  if (special["postDispatch"].truthy()) {
    JS.call(special["postDispatch"], self, event);
  }

  return event["result"];
}

JsValue handlersImpl(JsValue self, JsValue event, JsValue handlers) {
  JsValue handlerQueue = JS.array();
  JsValue delegateCount = handlers["delegateCount"];
  JsValue cur = event["target"];

  // Find delegate handlers
  if (delegateCount.truthy() && cur["nodeType"].truthy() &&
    !(event["type"] == "click" && JS.greaterThanOrEqual(event["button"], 1.0))) {
    for (; cur != self; cur = JS.or(cur["parentNode"], self)) {
      // Don't check non-elements (trac-13208)
      // Don't process clicks on disabled elements (trac-6911, trac-8165, trac-11382, trac-11764)
      if (cur["nodeType"] == 1.0 && !(event["type"] == "click" && cur["disabled"] == true)) {
        JsValue matchedHandlers = JS.array();
        JsValue matchedSelectors = JS.object();
        for (float i = 0.0; JS.lessThan(i, delegateCount); i++) {
          JsValue handleObj = handlers[i];

          // Don't conflict with Object.prototype properties (trac-13203)
          JsValue sel = JS.add(handleObj["selector"], " ");

          if (JS.isUndefined(matchedSelectors[sel])) {
            matchedSelectors[sel] = if (handleObj["needsContext"].truthy()) {
              JS.greaterThan(JS.invoke(jQuery(sel, self), "index", cur), -1.0)
            } else {
              findImpl(sel, self, null, [cur])["length"]
            };
          }
          if (matchedSelectors[sel].truthy()) {
            JS.invoke(matchedHandlers, "push", handleObj);
          }
        }
        if (matchedHandlers.length > 0.0) {
          JS.invoke(handlerQueue, "push", object { elem: cur, handlers: matchedHandlers });
        }
      }
    }
  }

  // Add the remaining (directly-bound) handlers
  cur = self;
  if (JS.lessThan(delegateCount, handlers.length)) {
    JS.invoke(handlerQueue, "push", object { elem: cur, handlers: JS.invoke(handlers, "slice", delegateCount) });
  }

  return handlerQueue;
}

JsValue fix(JsValue originalEvent) {
  return if (originalEvent[jQuery["expando"]].truthy()) { originalEvent } else { Event(originalEvent, JS.undefined()) };
}

// Ensure the presence of an event listener that handles manually-triggered
// synthetic events by interrupting progress until reinvoked in response to
// *native* events that it fires directly, ensuring that state changes have
// already occurred before other listeners are invoked.
void leverageNative(JsValue el, string type, bool isSetup) {
  // Missing `isSetup` indicates a trigger call, which must force setup through jQuery.event.add
  if (!isSetup) {
    if (JS.isUndefined(dataPrivGet(el, type))) {
      add(el, type, returnTrue);
    }
    return;
  }

  // Register the controller as a special universal handler for all event namespaces
  dataPrivSet(el, type, false);
  add(el, type, object {
    namespace: false,
    handler: JS.methodRest((JsValue self, JsValue args) => {
      JsValue event = args[0];
      JsValue saved = dataPrivGet(self, type);
      // Upstream tests `event.isTrigger & 1`: isTrigger is 3 for .trigger() and 2 for
      // .triggerHandler() (undefined for native events), so `% 2` is the same test.
      if (JS.mod(event["isTrigger"], 2.0).truthy() && self[type].truthy()) {
        // Interrupt processing of the outer synthetic .trigger()ed event
        if (!saved.truthy()) {
          // Store arguments for use when handling the inner native event
          saved = makeArray(args);
          dataPrivSet(self, type, saved);

          // Trigger the native event and capture its result
          JS.invoke(self, type);
          JsValue result = dataPrivGet(self, type);
          dataPrivSet(self, type, false);

          if (saved != result) {
            // Cancel the outer synthetic event
            JS.invoke(event, "stopImmediatePropagation");
            JS.invoke(event, "preventDefault");
            return result;
          }

        // If this is an inner synthetic event for an event with a bubbling surrogate
        // (focus or blur), assume that the surrogate already propagated from triggering
        // the native event and prevent that from happening again here.
        } else if (JS.or(specialEvents[type], JS.object())["delegateType"].truthy()) {
          JS.invoke(event, "stopPropagation");
        }

      // If this is a native event triggered above, everything is now in order
      // Fire an inner synthetic event with the original arguments
      } else if (saved.truthy()) {
        // ...and capture the result
        dataPrivSet(self, type, trigger(saved[0], JS.invoke(saved, "slice", 1.0), self));

        // Abort handling of the native event by all jQuery handlers while allowing
        // native handlers on the same element to run.
        JS.invoke(event, "stopPropagation");
        event["isImmediatePropagationStopped"] = returnTrue;
      }
      return JS.undefined();
    })
  });
}

export void removeEvent(JsValue elem, JsValue type, JsValue handle) {
  // This "if" is needed for plain objects
  if (elem["removeEventListener"].truthy()) {
    JS.invoke(elem, "removeEventListener", type, handle);
  }
}

JsValue preventDefault() {
  JsValue e = this["originalEvent"];
  this["isDefaultPrevented"] = returnTrue;
  if (e.truthy() && !this["isSimulated"].truthy()) {
    JS.invoke(e, "preventDefault");
  }
  return JS.undefined();
}

JsValue stopPropagation() {
  JsValue e = this["originalEvent"];
  this["isPropagationStopped"] = returnTrue;
  if (e.truthy() && !this["isSimulated"].truthy()) {
    JS.invoke(e, "stopPropagation");
  }
  return JS.undefined();
}

JsValue stopImmediatePropagation() {
  JsValue e = this["originalEvent"];
  this["isImmediatePropagationStopped"] = returnTrue;
  if (e.truthy() && !this["isSimulated"].truthy()) {
    JS.invoke(e, "stopImmediatePropagation");
  }
  JS.invoke(this, "stopPropagation");
  return JS.undefined();
}

// jQuery.Event is based on DOM3 Events as specified by the ECMAScript Language Binding
JsValue eventPrototype = object {
  constructor: Event,
  isDefaultPrevented: returnFalse,
  isPropagationStopped: returnFalse,
  isImmediatePropagationStopped: returnFalse,
  isSimulated: false,
  preventDefault: preventDefault,
  stopPropagation: stopPropagation,
  stopImmediatePropagation: stopImmediatePropagation
};

// Includes all common event props including KeyEvent and MouseEvent specific props
JsValue eventProps = JS.invoke(
  "altKey bubbles cancelable changedTouches ctrlKey detail eventPhase metaKey pageX pageY " +
  "shiftKey view char code charCode key keyCode button buttons clientX clientY offsetX " +
  "offsetY pointerId pointerType screenX screenY targetTouches toElement touches which",
  "split",
  " "
);

// Allow instantiation without the 'new' keyword: the instance is created from the
// shared prototype either way.
export JsValue Event(JsValue src, JsValue props) {
  JsValue self = objectCreate(eventPrototype);

  // Event object
  if (JS.and(src, src["type"]).truthy()) {
    self["originalEvent"] = src;
    self["type"] = src["type"];

    // Events bubbling up the document may have been marked as prevented
    // by a handler lower down the tree; reflect the correct value.
    self["isDefaultPrevented"] = if (src["defaultPrevented"].truthy() ||
      JS.isUndefined(src["defaultPrevented"]) && JS.isFalse(src["returnValue"])) {
      returnTrue
    } else {
      returnFalse
    };

    // Target should not be a text node (trac-504, trac-13143)
    self["target"] = if (JS.and(src["target"], src["target"]["nodeType"]) == 3.0) {
      src["target"]["parentNode"]
    } else {
      src["target"]
    };

    self["currentTarget"] = src["currentTarget"];
    self["relatedTarget"] = src["relatedTarget"];

    for (float i = 0.0; i < eventProps.length; i++) {
      string name = JS.assume(eventProps[i]);
      if (JS.in(name, src)) {
        self[name] = src[name];
      }
    }

  // Event type
  } else {
    self["type"] = src;
  }

  // Put explicitly provided properties onto the event object
  if (props.truthy()) {
    JS.invoke(jQuery, "extend", self, props);
  }

  // Create a timestamp if incoming event doesn't have one
  self["timeStamp"] = JS.or(JS.and(src, src["timeStamp"]), dateNow());

  // Mark it as fixed
  self[jQuery["expando"]] = true;
  return self;
}

JsValue stopPropagationCallback(JsValue e) {
  JS.invoke(e, "stopPropagation");
  return JS.undefined();
}

export JsValue trigger(JsValue event, JsValue data = JS.undefined(), JsValue elem = JS.undefined(), JsValue onlyHandlers = JS.undefined()) {
  elem = JS.or(elem, document);
  JsValue eventPath = [elem];
  JsValue type = if (objectHasOwn(event, "type")) { event["type"] } else { event };
  JsValue namespaces = if (objectHasOwn(event, "namespace")) { JS.invoke(event["namespace"], "split", ".") } else { JS.array() };
  JsValue cur = elem;
  JsValue lastElement = elem;
  JsValue tmp = elem;

  // Don't do events on text and comment nodes
  if (elem["nodeType"] == 3.0 || elem["nodeType"] == 8.0) {
    return JS.undefined();
  }

  // focus/blur morphs to focusin/out; ensure we're not firing them right now
  if (JS.invoke(rfocusMorph, "test", JS.add(type, jQuery["event"]["triggered"])).truthy()) {
    return JS.undefined();
  }

  if (JS.greaterThan(JS.invoke(type, "indexOf", "."), -1.0)) {
    // Namespaced trigger; create a regexp to match event type in handle()
    namespaces = JS.invoke(type, "split", ".");
    type = JS.invoke(namespaces, "shift");
    JS.invoke(namespaces, "sort");
  }
  JsValue ontype = JS.and(JS.lessThan(JS.invoke(type, "indexOf", ":"), 0.0), JS.add("on", type));

  // Caller can pass in a jQuery.Event object, Object, or just an event type string
  if (!event[jQuery["expando"]].truthy()) {
    event = Event(type, JS.and(JS.typeOf(event) == "object", event));
  }

  // Trigger bitmask: & 1 for native handlers; & 2 for jQuery (always true)
  event["isTrigger"] = if (onlyHandlers.truthy()) { 2.0 } else { 3.0 };
  event["namespace"] = JS.invoke(namespaces, "join", ".");
  event["rnamespace"] = if (event["namespace"].truthy()) {
    newRegexp("(^|\\.)" + JS.string(JS.invoke(namespaces, "join", "\\.(?:.*\\.|)")) + "(\\.|$)")
  } else {
    null
  };

  // Clean up the event in case it is being reused
  event["result"] = JS.undefined();
  if (!event["target"].truthy()) {
    event["target"] = elem;
  }

  // Clone any incoming data and prepend the event, creating the handler arg list
  data = if (JS.isNullish(data)) { [event] } else { makeArray(data, [event]) };

  // Allow special events to draw outside the lines
  JsValue special = JS.or(specialEvents[type], JS.object());
  if (!onlyHandlers.truthy() && special["trigger"].truthy() && JS.isFalse(JS.apply(special["trigger"], elem, data))) {
    return JS.undefined();
  }

  // Determine event propagation path in advance, per W3C events spec (trac-9951)
  // Bubble up to document, then to window; watch for a global ownerDocument var (trac-9724)
  JsValue bubbleType = JS.undefined();
