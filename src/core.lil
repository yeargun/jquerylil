import { emptyArray } from "./alloc.lil";
import { arr } from "./var/arr";
import { ObjectFunctionString } from "./var/ObjectFunctionString";
import { support } from "./var/support";
import { class2type, toStringTag, hasOwn, fnToString } from "./var/class2type";
import { isFunction } from "./var/isFunction";
import { isWindow } from "./var/isWindow";
import { DOMEval } from "./core/DOMEval";
import {
  getPrototypeOf,
  mathRandom,
  noop
} from "./js-host.lil";

extern JsValue Error;
extern JsValue Symbol;

string version = "3.7.1";
export JsValue slice = arr["slice"];
JsValue push = arr["push"];

export JsValue jQuery = JS.method2((JsValue _self, JsValue selector, JsValue context) => {
  return JS.construct(jQuery["fn"]["init"], selector, context);
});

bool isArrayLike(JsValue obj) {
  JsValue length = JS.and(obj.truthy() && JS.in("length", obj), obj["length"]);
  return !isFunction(obj) && !isWindow(obj) &&
    (JS.isArray(obj) || JS.strictEqual(length, 0.0) ||
      (JS.typeOf(length) == "number" && JS.greaterThan(length, 0.0) && JS.in(JS.number(length) - 1.0, obj)));
}

export bool isPlainObject(JsValue obj) {
  if (!obj.truthy() || toStringTag(obj) != "[object Object]") {
    return false;
  }
  JsValue proto = getPrototypeOf(obj);
  if (!proto.truthy()) {
    return true;
  }
  JsValue Ctor = JS.and(JS.invoke(hasOwn, "call", proto, "constructor"), proto["constructor"]);
  return JS.typeOf(Ctor) == "function" && JS.invoke(fnToString, "call", Ctor) == ObjectFunctionString;
}

export bool isEmptyObject(JsValue obj) {
  for (string name in obj) {
    return false;
  }
  return true;
}

export JsValue each(JsValue obj, JsValue callback) {
  if (isArrayLike(obj)) {
    float length = obj.length;
    for (float i = 0.0; i < length; i++) {
      if (JS.isFalse(JS.call(callback, obj[i], i, obj[i]))) {
        break;
      }
    }
  } else {
    for (string key in obj) {
      if (JS.isFalse(JS.call(callback, obj[key], key, obj[key]))) {
        break;
      }
    }
  }
  return obj;
}

export JsValue text(JsValue elem) {
  JsValue ret = "";
  JsValue nodeType = elem["nodeType"];
  for (float i = 0.0; !nodeType.truthy() && elem[i].truthy(); i++) {
    ret = JS.add(ret, JS.invoke(jQuery, "text", elem[i]));
  }
  return if (nodeType == 1.0 || nodeType == 11.0) {
    elem["textContent"]
  } else {
    if (nodeType == 9.0) {
      elem["documentElement"]["textContent"]
    } else {
      if (nodeType == 3.0 || nodeType == 4.0) { elem["nodeValue"] } else { ret }
    }
  };
}

export JsValue merge(JsValue first, JsValue second) {
  float len = JS.number(second["length"]);
  float i = first.length;
  for (float j = 0.0; j < len; j++) {
    first[i + j] = second[j];
  }
  first["length"] = i + len;
  return first;
}

export JsValue makeArray(JsValue arrValue, JsValue results = JS.undefined()) {
  JsValue ret = JS.or(results, emptyArray());
  if (!JS.isNullish(arrValue)) {
    if (isArrayLike(JS.box(arrValue))) {
      merge(ret, if (arrValue is string) { JS.array(arrValue) } else { arrValue });
    } else {
      JS.invoke(push, "call", ret, arrValue);
    }
  }
  return ret;
}

export float inArray(JsValue elem, JsValue arrValue, JsValue i = JS.undefined()) {
  return if (JS.isNullish(arrValue)) { -1.0 } else { JS.assume(JS.invoke(arr["indexOf"], "call", arrValue, elem, i)) };
}

export bool isXMLDoc(JsValue elem) {
  JsValue namespace = JS.and(elem, elem["namespaceURI"]);
  JsValue docElem = JS.and(elem, JS.or(elem["ownerDocument"], elem)["documentElement"]);
  return !JS.invoke(new Regex("HTML$", "i"), "test", JS.or(namespace, JS.or(JS.and(docElem, docElem["nodeName"]), "HTML"))).truthy();
}

export JsValue grep(JsValue elems, JsValue callback, JsValue invert = JS.undefined()) {
  JsValue matches = emptyArray();
  float length = elems.length;
  bool callbackExpect = !invert.truthy();
  for (float i = 0.0; i < length; i++) {
    if (!callback(elems[i], i).truthy() != callbackExpect) {
      JS.invoke(matches, "push", elems[i]);
    }
  }
  return matches;
}

export JsValue map(JsValue elems, JsValue callback, JsValue arg = JS.undefined()) {
  JsValue ret = emptyArray();
  if (isArrayLike(elems)) {
    float length = elems.length;
    for (float i = 0.0; i < length; i++) {
      JsValue value = callback(elems[i], i, arg);
      if (!JS.isNullish(value)) {
        JS.invoke(ret, "push", value);
      }
    }
  } else {
    for (string key in elems) {
      JsValue value = callback(elems[key], key, arg);
      if (!JS.isNullish(value)) {
        JS.invoke(ret, "push", value);
      }
    }
  }
  return JS.invoke(arr["flat"], "call", ret);
}

JsValue extend = JS.methodRest((JsValue self, JsValue args) => {
  JsValue target = JS.or(args[0], JS.object());
  float i = 1.0;
  float length = args.length;
  bool deep = target is bool;

  if (deep) {
    target = JS.or(args[i], JS.object());
    i++;
  }

  if (JS.typeOf(target) != "object" && !isFunction(target)) {
    target = JS.object();
  }

  if (i == length) {
    target = self;
    i--;
  }

  for (; i < length; i++) {
    JsValue options = args[i];
    if (!JS.isNullish(options)) {
      for (string name in options) {
        JsValue copy = options[name];
        if (name != "__proto__" && !JS.strictEqual(target, copy)) {
          bool copyIsArray = JS.isArray(copy);
          if (deep && copy.truthy() && (copyIsArray || isPlainObject(copy))) {
            JsValue src = target[name];
            target[name] = JS.invoke(jQuery, "extend", true,
              if (copyIsArray && !JS.isArray(src)) { emptyArray() }
              else { if (!copyIsArray && !isPlainObject(src)) { JS.object() } else { src } },
              copy);
          } else if (!JS.isUndefined(copy)) {
            target[name] = copy;
          }
        }
      }
    }
  }

  return target;
});

export JsValue mergeObject(JsValue target, JsValue options, bool deep) {
  return JS.invoke(jQuery, "extend", deep, target, options);
}

export JsValue wrap(JsValue elem) {
  return jQuery(elem);
}

export JsValue wrap2(JsValue selector, JsValue context) {
  return jQuery(selector, context);
}

export void globalEval(JsValue code, JsValue options = JS.undefined(), JsValue doc = JS.undefined()) {
  DOMEval(code, JS.object("nonce", JS.and(options, options["nonce"])), doc);
}

void jqError(JsValue msg) {
  throw JS.construct(Error, msg);
}

struct JQueryFnCore {
  string jquery;
  JsValue constructor;
  float length;
  JsValue toArray;
  JsValue get;
  JsValue pushStack;
  JsValue each;
  JsValue map;
  JsValue slice;
  JsValue first;
  JsValue last;
  JsValue even;
  JsValue odd;
  JsValue eq;
  JsValue end;
  JsValue push;
  JsValue sort;
  JsValue splice;
  JsValue extend;
}

struct JQueryStatics {
  string expando;
  bool isReady;
  JsValue error;
  JsValue noop;
  JsValue isPlainObject;
  JsValue isEmptyObject;
  JsValue globalEval;
  JsValue each;
  JsValue text;
  JsValue makeArray;
  JsValue inArray;
  JsValue isXMLDoc;
  JsValue merge;
  JsValue grep;
  JsValue map;
  float guid;
  JsValue support;
}

JsValue jQueryFn = JQueryFnCore{
  version,
  jQuery,
  0.0,
  JS.method0((JsValue self) => JS.invoke(slice, "call", self)),
  JS.method1((JsValue self, JsValue num) => if (JS.isNullish(num)) {
    JS.invoke(slice, "call", self)
  } else {
    if (JS.lessThan(num, 0.0)) { self[JS.add(num, self["length"])] } else { self[num] }
  }),
  JS.method1((JsValue self, JsValue elems) => {
    JsValue ret = merge(self["constructor"](), elems);
    ret["prevObject"] = self;
    return ret;
  }),
  JS.method1(each),
  JS.method1((JsValue self, JsValue callback) => JS.invoke(self, "pushStack", map(self, (JsValue elem, JsValue i) => {
    return JS.call(callback, elem, i, elem);
  }))),
  JS.methodRest((JsValue self, JsValue args) => JS.invoke(self, "pushStack", JS.invoke(slice, "apply", self, args))),
  JS.method0((JsValue self) => JS.invoke(self, "eq", 0.0)),
  JS.method0((JsValue self) => JS.invoke(self, "eq", -1.0)),
  JS.method0((JsValue self) => JS.invoke(self, "pushStack", grep(self, (JsValue _elem, JsValue i) => {
    return JS.mod(JS.add(i, 1.0), 2.0);
  }))),
  JS.method0((JsValue self) => JS.invoke(self, "pushStack", grep(self, (JsValue _elem, JsValue i) => {
    return JS.mod(i, 2.0);
  }))),
  JS.method1((JsValue self, JsValue index) => {
    JsValue len = self["length"];
    JsValue j = JS.add(JS.number(index), if (JS.lessThan(index, 0.0)) { len } else { 0.0 });
    return JS.invoke(self, "pushStack", if (JS.greaterThanOrEqual(j, 0.0) && JS.lessThan(j, len)) { JS.array(self[j]) } else { emptyArray() });
  }),
  JS.method0((JsValue self) => JS.or(self["prevObject"], self["constructor"]())),
  push,
  arr["sort"],
  arr["splice"],
  extend
};
jQuery["fn"] = jQueryFn;
jQuery["prototype"] = jQueryFn;
jQuery["extend"] = extend;

JS.invoke(jQuery, "extend", JQueryStatics{
  "jQuery" + JS.stringReplace(version + mathRandom(), new Regex("\\D", "g"), ""),
  true,
  jqError,
  noop,
  isPlainObject,
  isEmptyObject,
  globalEval,
  each,
  text,
  makeArray,
  inArray,
  isXMLDoc,
  merge,
  grep,
  map,
  1.0,
  support
});

if (JS.typeOf(Symbol) == "function") {
  jQueryFn[Symbol["iterator"]] = arr[Symbol["iterator"]];
}

each(JS.stringSplit("Boolean Number String Function Array Date RegExp Object Error Symbol", " "), (JsValue _i, JsValue name) => {
  class2type[JS.add(JS.add("[object ", name), "]")] = JS.invoke(name, "toLowerCase");
  return JS.undefined();
});
