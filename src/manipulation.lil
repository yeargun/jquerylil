extern JsValue this;
extern JsValue arguments;
import { jQuery, isXMLDoc, each, merge, map, text, inArray, mergeObject, wrap } from "./core";
import { add, remove, removeEvent } from "./event";
import { filterImpl } from "./traversing/findFilter";
import { containsImpl } from "./selector/contains";
import { isAttached } from "./core/isAttached";
import { DOMEval } from "./core/DOMEval";
import { nodeName } from "./core/nodeName";
import { access } from "./core/access";
import { flat } from "./var/flat";
import { isFunction } from "./var/isFunction";
import { rcheckableType } from "./var/rcheckableType";
import { rtagName } from "./manipulation/var/rtagName";
import { rscriptType } from "./manipulation/var/rscriptType";
import { wrapMap } from "./manipulation/wrapMap";
import { getAll } from "./manipulation/getAll";
import { setGlobalEval } from "./manipulation/setGlobalEval";
import { buildFragment } from "./manipulation/buildFragment";
import { support } from "./manipulation/support";
import {
  get as dataPrivGet,
  access as dataPrivAccess,
  remove as dataPrivRemove,
  hasData as dataPrivHasData,
  expando as dataPrivExpando
} from "./data/var/dataPriv";
import {
  access as dataUserAccess,
  set as dataUserSet,
  hasData as dataUserHasData,
  expando as dataUserExpando
} from "./data/var/dataUser";
import { acceptData } from "./data/var/acceptData";

Regex rnoInnerhtml = new Regex("<script|<style|<link", "i");
Regex rchecked = new Regex("checked\\s*(?:[^=]|=\\s*.checked.)", "i");
Regex rcleanScript = new Regex("^\\s*<!\\[CDATA\\[|\\]\\]>\\s*$", "g");

JsValue fn = jQuery["fn"];

JsValue manipulationTarget(JsValue elem, JsValue content) {
  if (nodeName(elem, "table") && nodeName(if (content["nodeType"] != 11.0) { content } else { content["firstChild"] }, "tr")) {
    return JS.or(JS.invoke(wrap(elem), "children", "tbody")[0], elem);
  }
  return elem;
}

JsValue disableScript(JsValue elem) {
  elem["type"] = JS.add(JS.add(JS.strictNotEqual(JS.invoke(elem, "getAttribute", "type"), null), "/"), elem["type"]);
  return elem;
}

JsValue restoreScript(JsValue elem) {
  if (JS.stringSlice(JS.assume(JS.or(elem["type"], "")), 0.0, 5.0) == "true/") {
    elem["type"] = JS.stringSlice(JS.assume(elem["type"]), 5.0);
  } else {
    JS.invoke(elem, "removeAttribute", "type");
  }
  return elem;
}

void cloneCopyEvent(JsValue src, JsValue dest) {
  if (dest["nodeType"] == 1.0) {
    if (dataPrivHasData(src)) {
      JsValue events = dataPrivGet(src)["events"];
      if (events.truthy()) {
        dataPrivRemove(dest, "handle events");
        for (string type in events) {
          JsValue handlers = events[type];
          for (float i = 0.0; i < handlers.length; i++) {
            add(dest, type, handlers[i]);
          }
        }
      }
    }

    if (dataUserHasData(src)) {
      dataUserSet(dest, mergeObject(JS.object(), dataUserAccess(src), false));
    }
  }
}

void fixInput(JsValue src, JsValue dest) {
  JsValue nm = JS.invoke(dest["nodeName"], "toLowerCase");
  if (nm == "input" && JS.regexTest(rcheckableType, src["type"])) {
    dest["checked"] = src["checked"];
  } else if (nm == "input" || nm == "textarea") {
    dest["defaultValue"] = src["defaultValue"];
  }
}

export JsValue domManip(JsValue collection, JsValue argsIn, func(JsValue, JsValue)->void callback, JsValue ignored = null) {
  JsValue args = flat(argsIn);
  float l = collection.length;
  JsValue value = args[0];
  bool valueIsFunction = isFunction(value);

  if (valueIsFunction || (l > 1.0 && value is string && !support.checkClone && JS.regexTest(rchecked, value))) {
    return each(collection, (JsValue index, JsValue elem) => {
      JsValue self = JS.invoke(collection, "eq", index);
      if (valueIsFunction) {
        args[0] = JS.call(value, elem, index, JS.invoke(self, "html"));
      }
      domManip(self, args, callback, ignored);
      return JS.undefined();
    });
  }

  if (l > 0.0) {
    JsValue fragment = buildFragment(args, collection[0]["ownerDocument"], false, collection, ignored);
    JsValue first = fragment["firstChild"];

    if (fragment["childNodes"]["length"] == 1.0) {
      fragment = first;
    }

    if (first.truthy() || ignored.truthy()) {
      JsValue scripts = map(getAll(fragment, "script"), disableScript);
      float hasScripts = scripts.length;

      for (float i = 0.0; i < l; i++) {
        JsValue node = fragment;
        if (i != l - 1.0) {
          node = clone(node, true, true);
          if (hasScripts > 0.0) {
            merge(scripts, getAll(node, "script"));
          }
        }
        callback(collection[i], node);
      }

      if (hasScripts > 0.0) {
        JsValue doc = scripts[hasScripts - 1.0]["ownerDocument"];
        map(scripts, restoreScript);

        for (float i = 0.0; i < hasScripts; i++) {
          JsValue node = scripts[i];
          JsValue type = JS.or(node["type"], "");
          if (JS.regexTest(rscriptType, type) &&
              !dataPrivAccess(node, "globalEval").truthy() &&
              containsImpl(doc, node)) {
            if (node["src"].truthy() && JS.invoke(type, "toLowerCase") != "module") {
              if (jQuery["_evalUrl"].truthy() && !node["noModule"].truthy()) {
                JS.invoke(jQuery, "_evalUrl", node["src"], JS.object("nonce", JS.or(node["nonce"], JS.invoke(node, "getAttribute", "nonce"))), doc);
              }
            } else {
              DOMEval(JS.stringReplace(JS.assume(node["textContent"]), rcleanScript, ""), node, doc);
            }
          }
        }
      }
    }
  }

  return collection;
}

JsValue removeElems(JsValue elem, JsValue selector, bool keepData) {
  JsValue nodes = elem;
  if (selector.truthy()) {
    nodes = filterImpl(selector, elem, false);
  }

  float i = 0.0;
  while (true) {
    JsValue node = nodes[i];
    i++;
    if (JS.isNullish(node)) {
      break;
    }

    if (!keepData && node["nodeType"] == 1.0) {
      cleanData(getAll(node));
    }

    if (node["parentNode"].truthy()) {
      if (keepData && isAttached(node)) {
        setGlobalEval(getAll(node, "script"));
      }
      JS.invoke(node["parentNode"], "removeChild", node);
    }
  }

  return elem;
}

export JsValue htmlPrefilter(JsValue html) {
  return html;
}

export JsValue clone(JsValue elem, JsValue dataAndEvents, JsValue deepDataAndEvents) {
  JsValue cloned = JS.invoke(elem, "cloneNode", true);
  bool inPage = isAttached(elem);
  JsValue srcElements = null;
  JsValue destElements = null;

  if (!support.noCloneChecked && (elem["nodeType"] == 1.0 || elem["nodeType"] == 11.0) && !isXMLDoc(elem)) {
    destElements = getAll(cloned);
    srcElements = getAll(elem);
    for (float i = 0.0; i < srcElements.length; i++) {
      fixInput(srcElements[i], destElements[i]);
    }
  }

  if (dataAndEvents.truthy()) {
    if (deepDataAndEvents.truthy()) {
      srcElements = JS.or(srcElements, getAll(elem));
      destElements = JS.or(destElements, getAll(cloned));
      for (float i = 0.0; i < srcElements.length; i++) {
        cloneCopyEvent(srcElements[i], destElements[i]);
      }
    } else {
      cloneCopyEvent(elem, cloned);
    }
  }

  destElements = getAll(cloned, "script");
  if (destElements.length > 0.0) {
    setGlobalEval(destElements, JS.and(!inPage, getAll(elem, "script")));
  }

  return cloned;
}

export void cleanData(JsValue elems) {
  JsValue special = jQuery["event"]["special"];
  float i = 0.0;
  while (true) {
    JsValue elem = elems[i];
    i++;
    if (JS.isUndefined(elem)) {
      break;
    }

    if (acceptData(elem)) {
      JsValue data = elem[dataPrivExpando];
      if (data.truthy()) {
        JsValue events = data["events"];
        if (events.truthy()) {
          for (string type in events) {
            if (special[type].truthy()) {
              remove(elem, type);
            } else {
              removeEvent(elem, type, data["handle"]);
            }
          }
        }
        elem[dataPrivExpando] = JS.undefined();
      }
      if (elem[dataUserExpando].truthy()) {
        elem[dataUserExpando] = JS.undefined();
      }
    }
  }
}

JS.invoke(jQuery, "extend", JS.object(
  "htmlPrefilter", htmlPrefilter,
  "clone", clone,
  "cleanData", cleanData
));

JsValue fnDetach(JsValue selector) {
  return removeElems(this, selector, true);
}

export JsValue fnRemove(JsValue selector) {
  return removeElems(this, selector, false);
}

bool isContainer(JsValue elem) {
  JsValue nt = elem["nodeType"];
  return nt == 1.0 || nt == 11.0 || nt == 9.0;
}

JsValue textAccess(JsValue value) {
  if (JS.isUndefined(value)) {
    return text(this);
  }
  return each(JS.invoke(this, "empty"), (JsValue _i, JsValue elem) => {
    if (isContainer(elem)) {
      elem["textContent"] = value;
    }
    return JS.undefined();
  });
}

JsValue fnText(JsValue value) {
  return access(this, textAccess, null, value, arguments.length > 0.0, null, false);
}

export JsValue fnAppend() {
  return domManip(this, arguments, (JsValue target, JsValue elem) => {
    if (isContainer(target)) {
      JS.invoke(manipulationTarget(target, elem), "appendChild", elem);
    }
  });
}

export JsValue fnPrepend() {
  return domManip(this, arguments, (JsValue target, JsValue elem) => {
    if (isContainer(target)) {
      JsValue dest = manipulationTarget(target, elem);
      JS.invoke(dest, "insertBefore", elem, dest["firstChild"]);
    }
  });
}

export JsValue fnBefore() {
  return domManip(this, arguments, (JsValue target, JsValue elem) => {
    if (target["parentNode"].truthy()) {
      JS.invoke(target["parentNode"], "insertBefore", elem, target);
    }
  });
}

export JsValue fnAfter() {
  return domManip(this, arguments, (JsValue target, JsValue elem) => {
    if (target["parentNode"].truthy()) {
      JS.invoke(target["parentNode"], "insertBefore", elem, target["nextSibling"]);
    }
  });
}

JsValue fnEmpty() {
  float i = 0.0;
  while (true) {
    JsValue elem = this[i];
    i++;
    if (JS.isNullish(elem)) {
      break;
    }
    if (elem["nodeType"] == 1.0) {
      cleanData(getAll(elem, false));
      elem["textContent"] = "";
    }
  }
  return this;
}

export JsValue fnClone(JsValue dataAndEvents, JsValue deepDataAndEvents) {
  JsValue deep = deepDataAndEvents;
  if (JS.isNullish(deep)) {
    deep = dataAndEvents;
  }
  return JS.invoke(this, "map", (JsValue _i, JsValue elem) => clone(elem, dataAndEvents, deep));
}

JsValue htmlAccess(JsValue value) {
  JsValue self = this;
  JsValue elem = JS.or(self[0], JS.object());

  if (JS.isUndefined(value) && elem["nodeType"] == 1.0) {
    return elem["innerHTML"];
  }

  if (value is string && !JS.regexTest(rnoInnerhtml, value) &&
      !wrapMap[JS.invoke(JS.or(JS.regexExec(rtagName, value), JS.array("", ""))[1], "toLowerCase")].truthy()) {
    value = JS.invoke(jQuery, "htmlPrefilter", value);
    try {
      for (float i = 0.0; i < self.length; i++) {
        elem = JS.or(self[i], JS.object());
        if (elem["nodeType"] == 1.0) {
          cleanData(getAll(elem, false));
          elem["innerHTML"] = value;
        }
      }
      elem = 0.0;
    } catch {
    }
  }

  if (elem.truthy()) {
    JS.invoke(JS.invoke(self, "empty"), "append", value);
  }
  return JS.undefined();
}

export JsValue fnHtml(JsValue value) {
  return access(this, htmlAccess, null, value, arguments.length > 0.0, null, false);
}

export JsValue fnReplaceWith() {
  JsValue[] ignored = [];
  return domManip(this, arguments, (JsValue target, JsValue elem) => {
    JsValue parent = target["parentNode"];
    if (inArray(target, ignored) < 0.0) {
      cleanData(getAll(target));
      if (parent.truthy()) {
        JS.invoke(parent, "replaceChild", elem, target);
      }
    }
  }, ignored);
}

JS.invoke(fn, "extend", JS.object(
  "detach", fnDetach,
  "remove", fnRemove,
  "text", fnText,
  "append", fnAppend,
  "prepend", fnPrepend,
  "before", fnBefore,
  "after", fnAfter,
  "empty", fnEmpty,
  "clone", fnClone,
  "html", fnHtml,
  "replaceWith", fnReplaceWith
));

each(JS.object(
  "appendTo", "append",
  "prependTo", "prepend",
  "insertBefore", "before",
  "insertAfter", "after",
  "replaceAll", "replaceWith"
), (JsValue name, JsValue original) => {
  fn[name] = JS.method1((JsValue self, JsValue selector) => {
    JsValue[] ret = [];
    JsValue insert = wrap(selector);
    float last = insert.length - 1.0;
    for (float i = 0.0; i <= last; i++) {
      JsValue elems = self;
      if (i != last) {
        elems = JS.invoke(self, "clone", true);
      }
      JS.invoke(wrap(insert[i]), JS.assume(original), elems);
      merge(ret, elems);
    }
    return JS.invoke(self, "pushStack", ret);
  });
  return JS.undefined();
});

export { jQuery };
