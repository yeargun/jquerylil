extern JsValue this;
extern JsValue arguments;
import { jQuery, each, makeArray } from "./core";
import {
  get as dataPrivGet,
  access as dataPrivAccess,
  remove as dataPrivRemove
} from "./data/var/dataPriv";
import { Deferred } from "./deferred";

struct QueueHooks {
  JsValue empty;
}

// View of the hooks bag queueHooks() allocates (QueueHooks above, kept in dataPriv):
// effects.lil, delay.lil and user queue callbacks write `unqueued` and `stop` on it.
// The port owns the allocation, so reads are typed field reads (finer/hypotheses/042).
export extern class QueueHooksView {
  JsValue empty;
  JsValue unqueued;
  JsValue stop;
}

export JsValue queueStatic(JsValue elem, JsValue type, JsValue data) {
  if (elem.truthy()) {
    string key = JS.or(type, "fx") + "queue";
    JsValue queue = dataPrivGet(elem, key);

    // Speed up dequeue by getting out quickly if this is just a lookup
    if (data.truthy()) {
      if (!queue.truthy() || JS.isArray(data)) {
        queue = dataPrivAccess(elem, key, makeArray(data));
      } else {
        JS.invoke(queue, "push", data);
      }
    }
    return JS.or(queue, JS.array());
  }
  return JS.undefined();
}

export JsValue dequeueStatic(JsValue elem, JsValue type) {
  type = JS.or(type, "fx");
  JsValue queue = queueStatic(elem, type, JS.undefined());
  float startLength = queue.length;
  JsValue fn = JS.invoke(queue, "shift");
  QueueHooksView hooks = JS.assume(queueHooks(elem, type));

  // If the fx queue is dequeued, always remove the progress sentinel
  if (fn == "inprogress") {
    fn = JS.invoke(queue, "shift");
    startLength--;
  }

  if (fn.truthy()) {
    // Add a progress sentinel to prevent the fx queue from being
    // automatically dequeued
    if (type == "fx") {
      JS.invoke(queue, "unshift", "inprogress");
    }

    // Clear up the last queue stop function
    JS.delete(hooks, "stop");
    JS.call(fn, elem, () => dequeueStatic(elem, type), hooks);
  }

  if (startLength == 0.0) {
    JS.invoke(hooks.empty, "fire");
  }
  return JS.undefined();
}

// Not public - generate a queueHooks object, or return the current one
export JsValue queueHooks(JsValue elem, JsValue type) {
  string key = type + "queueHooks";
  JsValue cleanup = () => {
    dataPrivRemove(elem, [type + "queue", key]);
  };
  return JS.or(dataPrivGet(elem, key), dataPrivAccess(elem, key, QueueHooks{
    JS.invoke(JS.invoke(jQuery, "Callbacks", "once memory"), "add", cleanup)
  }));
}

JsValue fnQueue(JsValue type, JsValue data) {
  float setter = 2.0;

  if (!(type is string)) {
    data = type;
    type = "fx";
    setter--;
  }

  if (arguments.length < setter) {
    return queueStatic(this[0], type, JS.undefined());
  }

  JsValue enqueue = (JsValue _i, JsValue el) => {
    JsValue queue = queueStatic(el, type, data);

    // Ensure a hooks for this queue
    queueHooks(el, type);

    if (type == "fx" && queue[0] != "inprogress") {
      dequeueStatic(el, type);
    }
  };
  return if (JS.isUndefined(data)) { this } else { each(this, enqueue) };
}

JsValue fnDequeue(JsValue type) {
  return each(this, (JsValue _i, JsValue el) => dequeueStatic(el, type));
}

JsValue fnClearQueue(JsValue type) {
  return JS.invoke(this, "queue", JS.or(type, "fx"), JS.array());
}

// Get a promise resolved when queues of a certain type
// are emptied (fx is the type by default)
JsValue fnPromise(JsValue type, JsValue obj) {
  float count = 1.0;
  JsValue defer = Deferred();
  JsValue elements = this;
  float i = elements.length;
  JsValue resolve = () => {
    count--;
    if (count == 0.0) {
      JS.invoke(defer, "resolveWith", elements, [elements]);
    }
  };

  if (!(type is string)) {
    obj = type;
    type = 0.0;
  }
  type = JS.or(type, "fx");

  while (i > 0.0) {
    i--;
    JsValue tmp = dataPrivGet(elements[i], type + "queueHooks");
    if (tmp.truthy() && tmp["empty"].truthy()) {
      count++;
      JS.invoke(tmp["empty"], "add", resolve);
    }
  }
  resolve();
  return JS.invoke(defer, "promise", obj);
}

jQuery["queue"] = queueStatic;
jQuery["dequeue"] = dequeueStatic;

jQuery["_queueHooks"] = queueHooks;

JsValue fn = jQuery["fn"];
fn["queue"] = fnQueue;
fn["dequeue"] = fnDequeue;
fn["clearQueue"] = fnClearQueue;
fn["promise"] = fnPromise;

export { jQuery };
