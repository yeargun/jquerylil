import { document } from "../var/document";
import { documentElement } from "../var/documentElement";
import { support } from "../var/support";
import {
  windowSelf,
  parseFloatValue,
  parseIntRadix,
  mathRound
} from "../js-host.lil";

JsValue container = JS.invoke(document, "createElement", "div");
JsValue div = JS.invoke(document, "createElement", "div");

// Each answer is written by the first test run and read only after it.
JsValue pixelPositionVal = JS.undefined();
JsValue boxSizingReliableVal = JS.undefined();
JsValue scrollboxSizeVal = JS.undefined();
JsValue pixelBoxStylesVal = JS.undefined();
JsValue reliableMarginLeftVal = JS.undefined();
JsValue reliableTrDimensionsVal = JS.undefined();

float roundPixelMeasures(JsValue measure) {
  return mathRound(parseFloatValue(JS.assume(measure)));
}

void computeStyleTests() {
  if (!div.truthy()) {
    return;
  }

  container["style"]["cssText"] = "position:absolute;left:-11111px;width:60px;margin-top:1px;padding:0;border:0";
  div["style"]["cssText"] = "position:relative;display:block;box-sizing:border-box;overflow:scroll;margin:auto;border:1px;padding:1px;width:60%;top:1%";
  JS.invoke(JS.invoke(documentElement, "appendChild", container), "appendChild", div);

  JsValue divStyle = JS.invoke(windowSelf(), "getComputedStyle", div);
  pixelPositionVal = !JS.strictEqual(divStyle["top"], "1%");
  reliableMarginLeftVal = roundPixelMeasures(divStyle["marginLeft"]) == 12.0;

  div["style"]["right"] = "60%";
  pixelBoxStylesVal = roundPixelMeasures(divStyle["right"]) == 36.0;
  boxSizingReliableVal = roundPixelMeasures(divStyle["width"]) == 36.0;

  div["style"]["position"] = "absolute";
  scrollboxSizeVal = mathRound(JS.number(div["offsetWidth"]) / 3.0) == 12.0;

  JS.invoke(documentElement, "removeChild", container);
  div = null;
}

export bool boxSizingReliable() {
  computeStyleTests();
  return JS.assume(boxSizingReliableVal);
}

export bool pixelBoxStyles() {
  computeStyleTests();
  return JS.assume(pixelBoxStylesVal);
}

export bool pixelPosition() {
  computeStyleTests();
  return JS.assume(pixelPositionVal);
}

export bool reliableMarginLeft() {
  computeStyleTests();
  return JS.assume(reliableMarginLeftVal);
}

export bool scrollboxSize() {
  computeStyleTests();
  return JS.assume(scrollboxSizeVal);
}

export bool reliableTrDimensions() {
  if (JS.isNullish(reliableTrDimensionsVal)) {
    JsValue table = JS.invoke(document, "createElement", "table");
    JsValue tr = JS.invoke(document, "createElement", "tr");
    JsValue trChild = JS.invoke(document, "createElement", "div");

    table["style"]["cssText"] = "position:absolute;left:-11111px;border-collapse:separate";
    tr["style"]["cssText"] = "box-sizing:content-box;border:1px solid";
    tr["style"]["height"] = "1px";
    trChild["style"]["height"] = "9px";
    trChild["style"]["display"] = "block";

    JS.invoke(JS.invoke(JS.invoke(documentElement, "appendChild", table), "appendChild", tr), "appendChild", trChild);

    JsValue trStyle = JS.invoke(windowSelf(), "getComputedStyle", tr);
    reliableTrDimensionsVal = JS.strictEqual(
      parseIntRadix(JS.assume(trStyle["height"]), 10.0) +
        parseIntRadix(JS.assume(trStyle["borderTopWidth"]), 10.0) +
        parseIntRadix(JS.assume(trStyle["borderBottomWidth"]), 10.0),
      tr["offsetHeight"]
    );

    JS.invoke(documentElement, "removeChild", table);
  }
  return JS.assume(reliableTrDimensionsVal);
}

if (div["style"].truthy()) {
  div["style"]["backgroundClip"] = "content-box";
  JS.invoke(div, "cloneNode", true)["style"]["backgroundClip"] = "";
  support.clearCloneStyle = JS.strictEqual(div["style"]["backgroundClip"], "content-box");

  support.boxSizingReliable = boxSizingReliable;
  support.pixelBoxStyles = pixelBoxStyles;
  support.pixelPosition = pixelPosition;
  support.reliableMarginLeft = reliableMarginLeft;
  support.scrollboxSize = scrollboxSize;
  support.reliableTrDimensions = reliableTrDimensions;
}

export { support };
