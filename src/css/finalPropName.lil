import { document } from "../var/document";
import { jQuery } from "../core";

JsValue cssPrefixes = JS.array("Webkit", "Moz", "ms");
JsValue emptyStyle = JS.invoke(document, "createElement", "div")["style"];
JsValue vendorProps = JS.object();

export string finalPropName(string name) {
  JsValue final = JS.or(jQuery["cssProps"][name], vendorProps[name]);
  if (final.truthy()) {
    return JS.assume(final);
  }
  if (JS.in(name, emptyStyle)) {
    return name;
  }

  string capName = name.charAt(0).toUpperCase() + name.slice(1);
  string resolved = name;
  float i = cssPrefixes.length;
  while (i > 0.0) {
    i--;
    string prefixed = JS.assume(JS.add(cssPrefixes[i], capName));
    if (JS.in(prefixed, emptyStyle)) {
      resolved = prefixed;
      break;
    }
  }
  vendorProps[name] = resolved;
  return resolved;
}
