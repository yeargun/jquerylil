extern JsValue this;
import { jQuery, each, wrap } from "../core";
import { get as dataPrivGet, set as dataPrivSet } from "../data/var/dataPriv";
import { css, fn } from "../css";
import { isHiddenWithinTree } from "./var/isHiddenWithinTree";

JsValue defaultDisplayMap = JS.object();

JsValue getDefaultDisplay(JsValue elem) {
  JsValue doc = elem["ownerDocument"];
  string nodeName = JS.assume(elem["nodeName"]);
  JsValue display = defaultDisplayMap[nodeName];

  if (display.truthy()) {
    return display;
  }

  JsValue temp = JS.invoke(doc["body"], "appendChild", JS.invoke(doc, "createElement", nodeName));
  display = css(temp, "display");
  JS.invoke(temp["parentNode"], "removeChild", temp);

  if (JS.strictEqual(display, "none")) {
    display = "block";
  }
  defaultDisplayMap[nodeName] = display;
  return display;
}

JsValue showHide(JsValue elements, bool show) {
  JsValue values = JS.array();
  float length = elements.length;

  for (float index = 0.0; index < length; index++) {
    JsValue elem = elements[index];
    JsValue style = elem["style"];
    if (!style.truthy()) {
      continue;
    }

    JsValue display = style["display"];
    if (show) {
      if (JS.strictEqual(display, "none")) {
        values[index] = JS.or(dataPrivGet(elem, "display"), null);
        if (!values[index].truthy()) {
          style["display"] = "";
        }
      }
      if (JS.strictEqual(style["display"], "") && isHiddenWithinTree(elem)) {
        values[index] = getDefaultDisplay(elem);
      }
    } else if (!JS.strictEqual(display, "none")) {
      values[index] = "none";
      dataPrivSet(elem, "display", display);
    }
  }

  for (float index = 0.0; index < length; index++) {
    if (!JS.isNullish(values[index])) {
      elements[index]["style"]["display"] = values[index];
    }
  }

  return elements;
}

JsValue fnShow() {
  return showHide(this, true);
}

JsValue fnHide() {
  return showHide(this, false);
}

JsValue fnToggle(JsValue state) {
  if (state is bool) {
    return JS.invoke(this, if (state) { "show" } else { "hide" });
  }

  return each(this, (JsValue _i, JsValue el) => {
    JS.invoke(wrap(el), if (isHiddenWithinTree(el)) { "show" } else { "hide" });
    return JS.undefined();
  });
}

fn["show"] = fnShow;
fn["hide"] = fnHide;
fn["toggle"] = fnToggle;

export { jQuery, showHide, getDefaultDisplay };
