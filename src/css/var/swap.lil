export JsValue swap(JsValue elem, JsValue options, func(JsValue)->JsValue callback) {
  JsValue style = elem["style"];
  JsValue old = JS.object();

  for (string name in options) {
    old[name] = style[name];
    style[name] = options[name];
  }

  JsValue ret = callback(elem);

  for (string name in options) {
    style[name] = old[name];
  }

  return ret;
}
