import { isAttached } from "../../core/isAttached";
import { css } from "../../css";

// Upstream's (elem, el): `.filter(isHiddenWithinTree)` passes (index, elem).
export bool isHiddenWithinTree(JsValue elemArg, JsValue elArg = null) {
  JsValue elem = JS.or(elArg, elemArg);
  JsValue display = elem["style"]["display"];
  return JS.strictEqual(display, "none") ||
    JS.strictEqual(display, "") && isAttached(elem) && JS.strictEqual(css(elem, "display"), "none");
}
