import { jQuery } from "../core";
import { expr } from "../selector";

bool visible(JsValue elem) {
  return JS.or(JS.or(elem["offsetWidth"], elem["offsetHeight"]), JS.invoke(elem, "getClientRects")["length"]).truthy();
}

JsValue pseudos = expr["pseudos"];
pseudos["hidden"] = (JsValue elem) => !JS.invoke(pseudos, "visible", elem).truthy();
pseudos["visible"] = visible;

export { jQuery };
