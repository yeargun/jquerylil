extern JsValue this;
import { jQuery, each, wrap, wrap2 } from "./core";
import { isFunction } from "./var/isFunction";

JsValue fnWrapAll(JsValue html) {
  JsValue self = this;
  JsValue first = self[0];
  if (first.truthy()) {
    if (isFunction(html)) {
      html = JS.call(html, first);
    }

    JsValue wrapper = JS.invoke(JS.invoke(wrap2(html, first["ownerDocument"]), "eq", 0.0), "clone", true);

    if (first["parentNode"].truthy()) {
      JS.invoke(wrapper, "insertBefore", first);
    }

    JS.invoke(JS.invoke(wrapper, "map", (JsValue _i, JsValue elem) => {
      JsValue inner = elem;
      while (inner["firstElementChild"].truthy()) {
        inner = inner["firstElementChild"];
      }
      return inner;
    }), "append", self);
  }

  return self;
}

JsValue fnWrapInner(JsValue html) {
  if (isFunction(html)) {
    return each(this, (JsValue i, JsValue elem) => {
      JS.invoke(wrap(elem), "wrapInner", JS.call(html, elem, i));
      return JS.undefined();
    });
  }

  return each(this, (JsValue _i, JsValue elem) => {
    JsValue self = wrap(elem);
    JsValue contents = JS.invoke(self, "contents");
    if (contents.length > 0.0) {
      JS.invoke(contents, "wrapAll", html);
    } else {
      JS.invoke(self, "append", html);
    }
    return JS.undefined();
  });
}

JsValue fnWrap(JsValue html) {
  bool htmlIsFunction = isFunction(html);
  return each(this, (JsValue i, JsValue elem) => {
    JS.invoke(wrap(elem), "wrapAll", if (htmlIsFunction) { JS.call(html, elem, i) } else { html });
    return JS.undefined();
  });
}

JsValue unwrapOne() {
  JS.invoke(wrap(this), "replaceWith", this["childNodes"]);
  return JS.undefined();
}

JsValue fnUnwrap(JsValue selector) {
  JS.invoke(JS.invoke(JS.invoke(this, "parent", selector), "not", "body"), "each", unwrapOne);
  return this;
}

JS.invoke(jQuery["fn"], "extend", JS.object(
  "wrapAll", fnWrapAll,
  "wrapInner", fnWrapInner,
  "wrap", fnWrap,
  "unwrap", fnUnwrap
));

export { jQuery };
