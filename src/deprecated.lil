extern JsValue arguments;
extern JsValue this;
extern JsValue Array;
extern JsValue JSON;
extern JsValue Date;
extern bool isNaN(float value);
extern float parseFloat(JsValue value);
import { jQuery } from "./core";
import { nodeName } from "./core/nodeName";
import { camelCase } from "./core/camelCase";
import { toType } from "./core/toType";
import { isFunction } from "./var/isFunction";
import { isWindow } from "./var/isWindow";
import { arr } from "./var/arr";

Regex rtrim = new Regex("^[\\s\\uFEFF\\xA0]+|([^\\s\\uFEFF\\xA0])[\\s\\uFEFF\\xA0]+$", "g");

JsValue proxy(JsValue fn, JsValue context) {
  if (context is string) {
    JsValue tmp = fn[context];
    context = fn;
    fn = tmp;
  }

  if (!isFunction(fn)) {
    return JS.undefined();
  }

  JsValue args = JS.invoke(arr["slice"], "call", arguments, 2.0);
  JsValue proxied = JS.methodRest((JsValue self, JsValue callArgs) => {
    return JS.apply(fn, JS.or(context, self), JS.invoke(args, "concat", JS.invoke(arr["slice"], "call", callArgs)));
  });

  if (!fn["guid"].truthy()) {
    JsValue guid = jQuery["guid"];
    jQuery["guid"] = JS.add(guid, 1.0);
    fn["guid"] = guid;
  }
  proxied["guid"] = fn["guid"];
  return proxied;
}

jQuery["proxy"] = proxy;

jQuery["holdReady"] = (JsValue hold) => {
  if (hold.truthy()) {
    jQuery["readyWait"] = JS.add(jQuery["readyWait"], 1.0);
  } else {
    JS.invoke(jQuery, "ready", true);
  }
  return JS.undefined();
};

jQuery["isArray"] = Array["isArray"];
jQuery["parseJSON"] = JSON["parse"];
jQuery["nodeName"] = nodeName;
jQuery["isFunction"] = isFunction;
jQuery["isWindow"] = isWindow;
jQuery["camelCase"] = camelCase;
jQuery["type"] = toType;
jQuery["now"] = Date["now"];

jQuery["isNumeric"] = (JsValue obj) => {
  string type = toType(obj);
  return (type == "number" || type == "string") && !isNaN(JS.number(obj) - parseFloat(obj));
};

jQuery["trim"] = (JsValue text) => {
  if (JS.isNullish(text)) {
    return "";
  }
  return JS.stringReplace(JS.string(text), rtrim, "$1");
};

export { jQuery };
