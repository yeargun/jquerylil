extern JsValue this;
import { jQuery, each, map, mergeObject, isEmptyObject } from "./core";
import { camelCase } from "./core/camelCase";
import { document } from "./var/document";
import { isFunction } from "./var/isFunction";
import { rcssNum } from "./var/rcssNum";
import { rnothtmlwhite } from "./var/rnothtmlwhite";
import { cssExpand } from "./css/var/cssExpand";
import { isHiddenWithinTree } from "./css/var/isHiddenWithinTree";
import { adjustCSS } from "./css/adjustCSS";
import {
  get as dataPrivGet,
  access as dataPrivAccess,
  remove as dataPrivRemove
} from "./data/var/dataPriv";
import { showHide } from "./css/showHide";
import { css, style } from "./css";
import { AnimOptsView, TweenView } from "./effects/Tween";
import { Deferred } from "./deferred";
import { queueStatic, dequeueStatic, queueHooks, QueueHooksView } from "./queue";
import {
  dateNow,
  mathMax,
  scheduleTimeoutMs,
  requestAnimationFrameOrNull
} from "./js-host.lil";

struct OpacityAnim {
  JsValue opacity;
}

struct AnimOptsSeed {
  JsValue specialEasing;
  JsValue easing;
}

struct AnimationFacade {
  JsValue elem;
  JsValue props;
  JsValue opts;
  JsValue originalProperties;
  JsValue originalOptions;
  float startTime;
  JsValue duration;
  JsValue tweens;
  JsValue createTween;
  JsValue stop;
}

struct FxShowInit {
  JsValue display;
}

struct SpeedOpt {
  JsValue complete;
  JsValue duration;
  JsValue easing;
}

struct FxSpeeds {
  float slow;
  float fast;
  float _default;
}

struct EffectShortcuts {
  JsValue slideDown;
  JsValue slideUp;
  JsValue slideToggle;
  JsValue fadeIn;
  JsValue fadeOut;
  JsValue fadeToggle;
}

float? fxNow = null;
bool inProgress = false;
Regex rfxtypes = new Regex("^(?:toggle|show|hide)$");
Regex rrun = new Regex("queueHooks$");

JsValue fx = jQuery["fx"];
JsValue timers = JS.array();
JsValue tweeners = JS.object("*", [defaultTweener]);
JsValue prefilters = [defaultPrefilter];

void schedule() {
  if (inProgress) {
    if (!(document["hidden"] == false && requestAnimationFrameOrNull(schedule).truthy())) {
      scheduleTimeoutMs(schedule, JS.number(fx["interval"]));
    }
    JS.invoke(fx, "tick");
  }
}

// Animations created synchronously will run synchronously
float createFxNow() {
  scheduleTimeoutMs(() => {
    fxNow = null;
  }, 0.0);
  float now = dateNow();
  fxNow = now;
  return now;
}

// Generate parameters to create a standard animation
JsValue genFx(JsValue type, bool includeWidth) {
  JsValue attrs = JS.object("height", type);

  // If we include width, step value is 1 to do all cssExpand values,
  // otherwise step value is 2 to skip over Left and Right
  // Upstream writes `attrs.margin* = attrs.padding* = type` and `attrs.opacity = attrs.width =
  // type`, so padding and width are created first; the key order drives the order styles are
  // set and restored, which the CSSOM can observe.
  for (int i = 0; i < 4; i += if (includeWidth) { 1 } else { 2 }) {
    JsValue which = cssExpand[i];
    attrs["padding" + which] = type;
    attrs["margin" + which] = type;
  }

  if (includeWidth) {
    attrs["width"] = type;
    attrs["opacity"] = type;
  }

  return attrs;
}

JsValue createTween(JsValue value, JsValue prop, JsValue animation) {
  JsValue collection = JS.invoke(JS.or(tweeners[prop], JS.array()), "concat", tweeners["*"]);
  for (float index = 0.0; index < collection.length; index++) {
    JsValue tween = JS.call(collection[index], animation, prop, value);
    if (tween.truthy()) {
      // We're done with this property
      return tween;
    }
  }
  return JS.undefined();
}

JsValue defaultTweener(JsValue prop, JsValue value) {
  TweenView tween = JS.assume(JS.invoke(this, "createTween", prop, value));
  adjustCSS(tween.elem, JS.assume(prop), JS.regexExec(rcssNum, JS.assume(value)), tween);
  return tween;
}

void defaultPrefilter(JsValue elem, JsValue props, AnimOptsView opts) {
  JsValue anim = this;
  bool isBox = JS.in("width", props) || JS.in("height", props);
  JsValue orig = JS.object();
  JsValue elemStyle = elem["style"];
  JsValue hidden = JS.and(elem["nodeType"], isHiddenWithinTree(elem));
  JsValue dataShow = dataPrivGet(elem, "fxshow");
  bool toggle = false;

  // Queue-skipping animations hijack the fx hooks
  if (!opts.queue.truthy()) {
    QueueHooksView hooks = JS.assume(queueHooks(elem, "fx"));
    if (JS.isNullish(hooks.unqueued)) {
      hooks.unqueued = 0.0;
      JsValue oldfire = hooks.empty["fire"];
      hooks.empty["fire"] = () => {
        if (!hooks.unqueued.truthy()) {
          oldfire();
        }
      };
    }
    hooks.unqueued = JS.number(hooks.unqueued) + 1.0;

    JS.invoke(anim, "always", () => {
      // Ensure the complete handler is called before this completes
      JS.invoke(anim, "always", () => {
        hooks.unqueued = JS.number(hooks.unqueued) - 1.0;
        if (queueStatic(elem, "fx", JS.undefined()).length == 0.0) {
          JS.invoke(hooks.empty, "fire");
        }
      });
    });
  }

  // Detect show/hide animations
  for (string prop in props) {
    JsValue value = props[prop];
    if (JS.regexTest(rfxtypes, JS.assume(value))) {
      JS.delete(props, prop);
      toggle = toggle || value == "toggle";
      if (value == if (hidden.truthy()) { "hide" } else { "show" }) {
        // Pretend to be hidden if this is a "show" and
        // there is still data from a stopped show/hide
        if (value == "show" && dataShow.truthy() && !JS.isUndefined(dataShow[prop])) {
          hidden = true;

        // Ignore all other no-op show/hide data
        } else {
          continue;
        }
      }
      orig[prop] = JS.or(JS.and(dataShow, dataShow[prop]), style(elem, prop));
    }
  }

  // Bail out if this is a no-op like .hide().hide()
  bool propTweenBool = !isEmptyObject(props);
  if (!propTweenBool && isEmptyObject(orig)) {
    return;
  }

  JsValue restoreDisplay = JS.undefined();

  // Restrict "overflow" and "display" styles during box animations
  if (isBox && elem["nodeType"] == 1.0) {
    // Support: IE <=9 - 11, Edge 12 - 15
    // Record all 3 overflow attributes because IE does not infer the shorthand
    // from identically-valued overflowX and overflowY and Edge just mirrors
    // the overflowX value there.
    opts.overflow = [elemStyle["overflow"], elemStyle["overflowX"], elemStyle["overflowY"]];

    // Identify a display type, preferring old show/hide data over the CSS cascade
    restoreDisplay = JS.and(dataShow, dataShow["display"]);
    if (JS.isNullish(restoreDisplay)) {
      restoreDisplay = dataPrivGet(elem, "display");
    }
    JsValue display = css(elem, "display");
    if (display == "none") {
      if (restoreDisplay.truthy()) {
        display = restoreDisplay;
      } else {
        // Get nonempty value(s) by temporarily forcing visibility
        showHide([elem], true);
        restoreDisplay = JS.or(elemStyle["display"], restoreDisplay);
        display = css(elem, "display");
        showHide([elem], false);
      }
    }

    // Animate inline elements as inline-block
    if (display == "inline" || display == "inline-block" && !JS.isNullish(restoreDisplay)) {
      if (css(elem, "float") == "none") {
        // Restore the original display value at the end of pure show/hide animations
        if (!propTweenBool) {
          JS.invoke(anim, "done", () => {
            elemStyle["display"] = restoreDisplay;
          });
          if (JS.isNullish(restoreDisplay)) {
            display = elemStyle["display"];
            restoreDisplay = if (display == "none") { "" } else { display };
          }
        }
        elemStyle["display"] = "inline-block";
      }
    }
  }

  if (opts.overflow.truthy()) {
    elemStyle["overflow"] = "hidden";
    JS.invoke(anim, "always", () => {
      elemStyle["overflow"] = opts.overflow[0];
      elemStyle["overflowX"] = opts.overflow[1];
      elemStyle["overflowY"] = opts.overflow[2];
    });
  }

  // Implement show/hide animations
  JsValue propTween = false;
  for (string prop in orig) {
    // General show/hide setup for this element animation
    if (!propTween.truthy()) {
      if (dataShow.truthy()) {
        if (JS.in("hidden", dataShow)) {
          hidden = dataShow["hidden"];
        }
      } else {
        dataShow = dataPrivAccess(elem, "fxshow", FxShowInit{restoreDisplay});
      }

      // Store hidden/visible for toggle so `.stop().toggle()` "reverses"
      if (toggle) {
        dataShow["hidden"] = !hidden.truthy();
      }

      // Show elements before animating them
      if (hidden.truthy()) {
        showHide([elem], true);
      }

      JS.invoke(anim, "done", () => {
        // The final step of a "hide" animation is actually hiding the element
        if (!hidden.truthy()) {
          showHide([elem], false);
        }
        dataPrivRemove(elem, "fxshow");
        for (string key in orig) {
          style(elem, key, orig[key]);
        }
      });
    }

    // Per-property setup
    propTween = createTween(if (hidden.truthy()) { dataShow[prop] } else { 0.0 }, prop, anim);
    if (!JS.in(prop, dataShow)) {
      dataShow[prop] = propTween["start"];
      if (hidden.truthy()) {
        propTween["end"] = propTween["start"];
        propTween["start"] = 0.0;
      }
    }
  }
}

JsValue Animation(JsValue elem, JsValue properties, JsValue options) {
  bool stopped = false;
  JsValue tweens = JS.array();
  AnimOptsView opts = JS.assume(mergeObject(AnimOptsSeed{JS.object(), jQuery["easing"]["_default"]}, options, true));
  JsValue props = mergeObject(JS.object(), properties, false);
  float startTime = fxNow ?? createFxNow();
  // The raw option value, exactly as upstream stores it on the animation. It is typed as a
  // number only so `startTime + duration - now` and `remaining / duration || 0` print as the
  // same JavaScript operators upstream uses (a string duration concatenates there too).
  float duration = JS.assume(options["duration"]);
  JsValue deferred = Deferred();
  JsValue animation = JS.undefined();

  JsValue tick = () => {
    if (stopped) {
      return false;
    }
    float remaining = mathMax(0.0, startTime + duration - (fxNow ?? createFxNow()));

    // Support: Android 2.3 only
    // Archaic crash bug won't allow us to use `1 - ( 0.5 || 0 )` (trac-12497)
    float temp = JS.assume(JS.or(remaining / duration, 0.0));
    float percent = 1.0 - temp;
    float length = tweens.length;

    for (float index = 0.0; index < length; index++) {
      JS.invoke(tweens[index], "run", percent);
    }

    JS.invoke(deferred, "notifyWith", elem, [animation, percent, remaining]);

    // If there's more to do, yield
    if (percent < 1.0 && length != 0.0) {
      return remaining;
    }

    // If this was an empty animation, synthesize a final progress notification
    if (length == 0.0) {
      JS.invoke(deferred, "notifyWith", elem, [animation, 1.0, 0.0]);
    }

    // Resolve the animation and report its conclusion
    JS.invoke(deferred, "resolveWith", elem, [animation]);
    return false;
  };

  JS.invoke(deferred, "always", () => {
    // Don't match elem in the :animated selector
    JS.delete(tick, "elem");
  });

  animation = AnimationFacade{
    elem,
    props,
    opts,
    properties,
    options,
    startTime,
    duration,
    tweens,
    (JsValue prop, JsValue end) => {
      JsValue tween = JS.invoke(jQuery, "Tween", elem, opts, prop, end, JS.or(opts.specialEasing[prop], opts.easing));
      JS.invoke(tweens, "push", tween);
      return tween;
    },
    JS.method1((JsValue self, JsValue gotoEnd) => {
      if (!stopped) {
        stopped = true;
        if (gotoEnd.truthy()) {
          // If we are going to the end, we want to run all the tweens
          // otherwise we skip this part
          for (float index = 0.0; index < tweens.length; index++) {
            JS.invoke(tweens[index], "run", 1.0);
          }
          // Resolve when we played the last frame; otherwise, reject
          JS.invoke(deferred, "notifyWith", elem, [animation, 1.0, 0.0]);
          JS.invoke(deferred, "resolveWith", elem, [animation, gotoEnd]);
        } else {
          JS.invoke(deferred, "rejectWith", elem, [animation, gotoEnd]);
        }
      }
      return self;
    })
  };
  JS.invoke(deferred, "promise", animation);

  // camelCase, specialEasing and expand cssHook pass
  JsValue specialEasing = opts.specialEasing;
  for (string index in props) {
    string name = camelCase(index);
    JsValue easing = specialEasing[name];
    JsValue value = props[index];
    if (JS.isArray(value)) {
      easing = value[1];
      value = value[0];
      props[index] = value;
    }

    if (index != name) {
      props[name] = value;
      JS.delete(props, index);
    }

    JsValue hooks = jQuery["cssHooks"][name];
    if (hooks.truthy() && JS.in("expand", hooks)) {
      value = JS.invoke(hooks, "expand", value);
      JS.delete(props, name);

      // Not quite $.extend, this won't overwrite existing keys.
      for (string key in value) {
        if (!JS.in(key, props)) {
          props[key] = value[key];
          specialEasing[key] = easing;
        }
      }
    } else {
      specialEasing[name] = easing;
    }
  }

  float length = prefilters.length;
  for (float index = 0.0; index < length; index++) {
    JsValue result = JS.call(prefilters[index], animation, elem, props, opts);
    if (result.truthy()) {
      if (isFunction(result["stop"])) {
        QueueHooksView stopHooks = JS.assume(queueHooks(elem, opts.queue));
        stopHooks.stop = JS.invoke(result["stop"], "bind", result);
      }
      return result;
    }
  }

  map(props, createTween, animation);

  if (isFunction(opts.start)) {
    JS.call(opts.start, elem, animation);
  }

  // Attach callbacks from options
  JS.invoke(JS.invoke(JS.invoke(JS.invoke(animation, "progress", opts.progress),
    "done", opts.done, opts.complete), "fail", opts.fail), "always", opts.always);

  tick["elem"] = elem;
  tick["anim"] = animation;
  tick["queue"] = opts.queue;
  JS.invoke(fx, "timer", tick);

  return animation;
}

void animationTweener(JsValue props, JsValue callback) {
  if (isFunction(props)) {
    callback = props;
    props = ["*"];
  } else {
    props = JS.invoke(props, "match", rnothtmlwhite);
  }

  for (float index = 0.0; index < props.length; index++) {
    JsValue prop = props[index];
    tweeners[prop] = JS.or(tweeners[prop], JS.array());
    JS.invoke(tweeners[prop], "unshift", callback);
  }
}

void animationPrefilter(JsValue callback, JsValue prepend) {
  if (prepend.truthy()) {
    JS.invoke(prefilters, "unshift", callback);
  } else {
    JS.invoke(prefilters, "push", callback);
  }
}

JsValue speedOpt(JsValue speedArg, JsValue easing, JsValue fn) {
  return SpeedOpt{
    JS.or(JS.or(fn, easing), JS.and(isFunction(speedArg), speedArg)),
    speedArg,
    JS.or(JS.and(fn, easing), JS.and(JS.and(easing, !isFunction(easing)), easing))
  };
}

JsValue speed(JsValue speedArg, JsValue easing, JsValue fn) {
  JsValue opt = if (speedArg.truthy() && JS.typeOf(speedArg) == "object") {
    mergeObject(JS.object(), speedArg, false)
  } else {
    speedOpt(speedArg, easing, fn)
  };
  // Go to the end state if fx are off
  if (fx["off"].truthy()) {
    opt["duration"] = 0.0;
  } else if (JS.typeOf(opt["duration"]) != "number") {
    JsValue speeds = fx["speeds"];
    opt["duration"] = if (JS.in(opt["duration"], speeds)) { speeds[opt["duration"]] } else { speeds["_default"] };
  }

  // Normalize opt.queue - true/undefined/null -> "fx"
  if (JS.isNullish(opt["queue"]) || opt["queue"] == true) {
    opt["queue"] = "fx";
  }

  // Queueing
  opt["old"] = opt["complete"];

  opt["complete"] = JS.method0((JsValue self) => {
    if (isFunction(opt["old"])) {
      JS.call(opt["old"], self);
    }
    if (opt["queue"].truthy()) {
      dequeueStatic(self, opt["queue"]);
    }
    return JS.undefined();
  });

  return opt;
}

JsValue fnFadeTo(JsValue speedArg, JsValue to, JsValue easing, JsValue callback) {
  // Show any hidden elements after setting opacity to 0,
  // then animate to the value specified
  return JS.invoke(JS.invoke(JS.invoke(JS.invoke(JS.invoke(this, "filter", isHiddenWithinTree),
    "css", "opacity", 0.0), "show"), "end"), "animate", OpacityAnim{to}, speedArg, easing, callback);
}

JsValue fnAnimate(JsValue prop, JsValue speedArg, JsValue easing, JsValue callback) {
  bool empty = isEmptyObject(prop);
  AnimOptsView optall = JS.assume(speed(speedArg, easing, callback));
  JsValue doAnimation = JS.method0((JsValue self) => {
    // Operate on a copy of prop so per-property easing won't be lost
    JsValue anim = Animation(self, mergeObject(JS.object(), prop, false), optall);

    // Empty animations, or finishing resolves immediately
    if (empty || dataPrivGet(self, "finish").truthy()) {
      JS.invoke(anim, "stop", true);
    }
    return JS.undefined();
  });

  doAnimation["finish"] = doAnimation;

  return if (empty || optall.queue == false) {
    each(this, doAnimation)
  } else {
    JS.invoke(this, "queue", optall.queue, doAnimation)
  };
}

void stopQueue(JsValue hooks, JsValue gotoEnd) {
  JsValue stop = hooks["stop"];
  JS.delete(hooks, "stop");
  stop(gotoEnd);
}

JsValue fnStop(JsValue type, JsValue clearQueue, JsValue gotoEnd) {
  if (!(type is string)) {
    gotoEnd = clearQueue;
    clearQueue = type;
    type = JS.undefined();
  }
  if (clearQueue.truthy()) {
    JS.invoke(this, "queue", JS.or(type, "fx"), JS.array());
  }

  return each(this, (JsValue _i, JsValue el) => {
    bool dequeue = true;
    JsValue data = dataPrivGet(el);

    if (JS.isNullish(type)) {
      for (string index in data) {
        if (data[index].truthy() && data[index]["stop"].truthy() && JS.regexTest(rrun, index)) {
          stopQueue(data[index], gotoEnd);
        }
      }
    } else {
      JsValue hooks = data[type + "queueHooks"];
      if (hooks.truthy() && hooks["stop"].truthy()) {
        stopQueue(hooks, gotoEnd);
      }
    }

    float index = timers.length;
    while (index > 0.0) {
      index--;
      JsValue timer = timers[index];
      if (timer["elem"] == el && (JS.isNullish(type) || timer["queue"] == type)) {
        JS.invoke(timer["anim"], "stop", gotoEnd);
        dequeue = false;
        JS.invoke(timers, "splice", index, 1.0);
      }
    }

    // Start the next in the queue if the last step wasn't forced.
    // Timers currently will call their complete callbacks, which
    // will dequeue but only if they were gotoEnd.
    if (dequeue || !gotoEnd.truthy()) {
      dequeueStatic(el, type);
    }
  });
}

JsValue fnFinish(JsValue type) {
  if (type != false) {
    type = JS.or(type, "fx");
  }
  return each(this, (JsValue _i, JsValue el) => {
    JsValue data = dataPrivGet(el);
    JsValue queue = data[type + "queue"];
    JsValue hooks = data[type + "queueHooks"];
    float length = if (queue.truthy()) { queue.length } else { 0.0 };

    // Enable finishing flag on private data
    data["finish"] = true;

    // Empty the queue first
    queueStatic(el, type, JS.array());

    if (hooks.truthy() && hooks["stop"].truthy()) {
      JS.call(hooks["stop"], el, true);
    }

    // Look for any active animations, and finish them
    float index = timers.length;
    while (index > 0.0) {
      index--;
      JsValue timer = timers[index];
      if (timer["elem"] == el && timer["queue"] == type) {
        JS.invoke(timer["anim"], "stop", true);
        JS.invoke(timers, "splice", index, 1.0);
      }
    }

    // Look for any animations in the old queue and finish them
    for (index = 0.0; index < length; index++) {
      if (queue[index].truthy() && queue[index]["finish"].truthy()) {
        JS.call(queue[index]["finish"], el);
      }
    }

    // Turn off finishing flag
    JS.delete(data, "finish");
  });
}

JsValue animationFn = Animation;
animationFn["tweeners"] = tweeners;
animationFn["tweener"] = animationTweener;
animationFn["prefilters"] = prefilters;
animationFn["prefilter"] = animationPrefilter;
jQuery["Animation"] = animationFn;

jQuery["speed"] = speed;

JsValue fn = jQuery["fn"];
fn["fadeTo"] = fnFadeTo;
fn["animate"] = fnAnimate;
fn["stop"] = fnStop;
fn["finish"] = fnFinish;

each(["toggle", "show", "hide"], (JsValue _i, JsValue name) => {
  JsValue cssFn = fn[name];
  fn[name] = JS.method3((JsValue self, JsValue speedArg, JsValue easing, JsValue callback) => {
    return if (JS.isNullish(speedArg) || speedArg is bool) {
      JS.call(cssFn, self, speedArg)
    } else {
      JS.invoke(self, "animate", genFx(name, true), speedArg, easing, callback)
    };
  });
});

// Generate shortcuts for custom animations
each(EffectShortcuts{
  genFx("show", false),
  genFx("hide", false),
  genFx("toggle", false),
  OpacityAnim{"show"},
  OpacityAnim{"hide"},
  OpacityAnim{"toggle"}
}, (JsValue name, JsValue props) => {
  fn[name] = JS.method3((JsValue self, JsValue speedArg, JsValue easing, JsValue callback) => {
    return JS.invoke(self, "animate", props, speedArg, easing, callback);
  });
});

jQuery["timers"] = timers;

fx["tick"] = () => {
  fxNow = dateNow();

  for (float i = 0.0; i < timers.length; i++) {
    JsValue timer = timers[i];

    // Run the timer and safely remove it when done (allowing for external removal)
    if (!timer().truthy() && timers[i] == timer) {
      JS.invoke(timers, "splice", i, 1.0);
      i--;
    }
  }

  if (timers.length == 0.0) {
    JS.invoke(fx, "stop");
  }
  fxNow = null;
};

fx["timer"] = (JsValue timer) => {
  JS.invoke(timers, "push", timer);
  JS.invoke(fx, "start");
};

fx["interval"] = 13.0;
fx["start"] = () => {
  if (!inProgress) {
    inProgress = true;
    schedule();
  }
};

fx["stop"] = () => {
  inProgress = false;
};

fx["speeds"] = FxSpeeds{600.0, 200.0, 400.0};

export { jQuery };
