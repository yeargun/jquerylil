import { jQuery, map } from "../core";
import { newDOMParser } from "../js-host.lil";

JsValue textContentOf = (JsValue el) => el["textContent"];

export JsValue parseXML(JsValue data) {
  if (!data.truthy() || !(data is string)) {
    return null;
  }
  JsValue xml = JS.undefined();
  try {
    xml = JS.invoke(newDOMParser(), "parseFromString", data, "text/xml");
  } catch {
  }
  JsValue parserErrorElem = JS.and(xml, JS.invoke(xml, "getElementsByTagName", "parsererror")[0]);
  if (!xml.truthy() || parserErrorElem.truthy()) {
    JS.invoke(jQuery, "error", JS.add("Invalid XML: ", if (parserErrorElem.truthy()) {
      JS.invoke(map(parserErrorElem["childNodes"], textContentOf), "join", "\n")
    } else {
      data
    }));
  }
  return xml;
}

jQuery["parseXML"] = parseXML;

export { jQuery };
