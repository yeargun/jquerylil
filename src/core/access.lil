import { wrap } from "../core";
import { toType } from "./toType";
import { isFunction } from "../var/isFunction";

export JsValue access(
  JsValue elems,
  JsValue fn,
  JsValue key,
  JsValue value,
  bool chainable,
  JsValue emptyGet,
  bool raw
) {
  float len = elems.length;
  bool bulk = JS.isNullish(key);

  if (toType(key) == "object") {
    chainable = true;
    for (string prop in key) {
      access(elems, fn, prop, key[prop], true, emptyGet, raw);
    }
  } else if (!JS.isUndefined(value)) {
    chainable = true;
    if (!isFunction(value)) {
      raw = true;
    }
    if (bulk) {
      if (raw) {
        JS.call(fn, elems, value);
        fn = null;
      } else {
        JsValue bulkFn = fn;
        fn = (JsValue elem, JsValue _key, JsValue val) => {
          return JS.call(bulkFn, wrap(elem), val);
        };
      }
    }
    if (fn.truthy()) {
      for (float i = 0.0; i < len; i++) {
        fn(elems[i], key, if (raw) { value } else { JS.call(value, elems[i], i, fn(elems[i], key)) });
      }
    }
  }

  return if (chainable) {
    elems
  } else {
    if (bulk) {
      JS.call(fn, elems)
    } else {
      if (len != 0.0) { fn(elems[0], key) } else { emptyGet }
    }
  };
}
