import { class2type, toStringTag } from "../var/class2type";

export string toType(JsValue obj) {
  return if (JS.isNullish(obj)) {
    JS.string(obj)
  } else {
    if (JS.typeOf(obj) == "object" || JS.typeOf(obj) == "function") {
      JS.assume(JS.or(class2type[toStringTag(obj)], "object"))
    } else {
      JS.typeOf(obj)
    }
  };
}
