import { emptyArray } from "../alloc.lil";
import { jQuery, merge } from "../core";
import { document } from "../var/document";
import { rsingleTag } from "./var/rsingleTag";
import { buildFragment } from "../manipulation/buildFragment";
import { support } from "./support";

export JsValue parseHTML(JsValue data, JsValue context = JS.undefined(), JsValue keepScripts = JS.undefined()) {
  if (!(data is string)) {
    return emptyArray();
  }
  if (context is bool) {
    keepScripts = context;
    context = false;
  }

  if (!context.truthy()) {
    if (support.createHTMLDocument) {
      context = JS.invoke(document["implementation"], "createHTMLDocument", "");
      JsValue base = JS.invoke(context, "createElement", "base");
      base["href"] = document["location"]["href"];
      JS.invoke(context["head"], "appendChild", base);
    } else {
      context = document;
    }
  }

  JsValue parsed = JS.regexExec(rsingleTag, data);
  JsValue scripts = JS.and(!keepScripts.truthy(), emptyArray());

  if (parsed.truthy()) {
    return JS.array(JS.invoke(context, "createElement", parsed[1]));
  }

  parsed = buildFragment(JS.array(data), context, scripts);

  if (JS.and(scripts, scripts["length"]).truthy()) {
    JS.invoke(jQuery(scripts), "remove");
  }

  return merge(emptyArray(), parsed["childNodes"]);
}

jQuery["parseHTML"] = parseHTML;

export { jQuery };
