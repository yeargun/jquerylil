import { jQuery, merge, isPlainObject, makeArray } from "../core";
import { document } from "../var/document";
import { isFunction } from "../var/isFunction";
import { rsingleTag } from "./var/rsingleTag";

JsValue rootjQuery = null;

JsValue fn = jQuery["fn"];
fn["init"] = JS.method2((JsValue self, JsValue selector, JsValue context) => {
  if (!selector.truthy()) {
    return self;
  }

  if (JS.typeOf(selector) == "string") {
    JsValue quick = if (selector[0] == "<" && selector[selector.length - 1.0] == ">" && selector.length >= 3.0) {
      JS.array(null, selector)
    } else {
      JS.invoke(new Regex("^(?:\\s*(<[\\w\\W]+>)[^>]*|#([\\w-]+))$"), "exec", selector)
    };

    if (quick.truthy() && (quick[1].truthy() || !context.truthy())) {
      if (quick[1].truthy()) {
        if (JS.and(context, context["jquery"]).truthy()) {
          context = context[0];
        }
        merge(self, JS.invoke(jQuery, "parseHTML", quick[1],
          if (JS.and(context, context["nodeType"]).truthy()) { JS.or(context["ownerDocument"], context) } else { document },
          true));
        if (JS.invoke(rsingleTag, "test", quick[1]).truthy() && isPlainObject(context)) {
          for (string key in context) {
            if (isFunction(self[key])) {
              JS.invoke(self, key, context[key]);
            } else {
              JS.invoke(self, "attr", key, context[key]);
            }
          }
        }
        return self;
      }
      JsValue elem = JS.invoke(document, "getElementById", quick[2]);
      if (elem.truthy()) {
        self[0] = elem;
        self["length"] = 1.0;
      }
      return self;
    }

    return if (!context.truthy() || context["jquery"].truthy()) {
      JS.invoke(JS.or(context, rootjQuery), "find", selector)
    } else {
      JS.invoke(JS.invoke(self, "constructor", context), "find", selector)
    };
  }

  if (selector["nodeType"].truthy()) {
    self[0] = selector;
    self["length"] = 1.0;
    return self;
  }

  if (isFunction(selector)) {
    return if (JS.isUndefined(rootjQuery["ready"])) {
      JS.call(selector, JS.undefined(), jQuery)
    } else {
      JS.invoke(rootjQuery, "ready", selector)
    };
  }

  return makeArray(selector, self);
});
fn["init"]["prototype"] = fn;

rootjQuery = jQuery(document);

export { jQuery };
