import { jQuery } from "../core";
import { Deferred } from "../deferred";
import { document } from "../var/document";
import "./readyException";
import {
  windowSelf,
  addEventListener,
  removeEventListener,
  scheduleTimeout
} from "../js-host.lil";

JsValue readyList = Deferred();

jQuery["fn"]["ready"] = JS.method1((JsValue self, JsValue fn) => {
  JS.invoke(JS.invoke(readyList, "then", fn), "catch", (JsValue error) => {
    JS.invoke(jQuery, "readyException", error);
  });
  return self;
});
jQuery["isReady"] = false;
jQuery["readyWait"] = 1.0;

jQuery["ready"] = (JsValue wait) => {
  bool release = JS.strictEqual(wait, true);
  if (!release) {
    if (jQuery["isReady"].truthy()) {
      return;
    }
    jQuery["isReady"] = true;
  }
  float remaining = JS.number(jQuery["readyWait"]) - 1.0;
  jQuery["readyWait"] = remaining;
  JsValue left = remaining;
  if (if (release) { left.truthy() } else { remaining > 0.0 }) {
    return;
  }
  jQuery["isReady"] = true;
  JS.invoke(readyList, "resolveWith", document, JS.array(jQuery));
};

jQuery["ready"]["then"] = readyList["then"];

void completed() {
  removeEventListener(document, "DOMContentLoaded", completed);
  removeEventListener(windowSelf(), "load", completed);
  JS.invoke(jQuery, "ready");
}

JsValue readyState = document["readyState"];
if (readyState == "complete" || (readyState != "loading" && !document["documentElement"]["doScroll"].truthy())) {
  scheduleTimeout(jQuery["ready"]);
} else {
  addEventListener(document, "DOMContentLoaded", completed);
  addEventListener(windowSelf(), "load", completed);
}

export { jQuery };
