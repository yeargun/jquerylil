struct ComposedRoot {
  bool composed;
}

JsValue composedRoot = ComposedRoot{true};

export bool isAttached(JsValue elem) {
  JsValue doc = JS.and(elem, elem["ownerDocument"]);
  return (doc.truthy() && JS.invoke(doc, "contains", elem).truthy()) ||
    (elem.truthy() && elem["getRootNode"].truthy() && JS.invoke(elem, "getRootNode", composedRoot) == doc);
}
