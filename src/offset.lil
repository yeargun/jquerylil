extern JsValue arguments;
extern JsValue this;
import { jQuery, each, wrap } from "./core";
import { access } from "./core/access";
import { documentElement } from "./var/documentElement";
import { isFunction } from "./var/isFunction";
import { isWindow } from "./var/isWindow";
import { rnumnonpx } from "./css/var/rnumnonpx";
import { curCSS } from "./css/curCSS";
import { addGetHookIf } from "./css/addGetHookIf";
import { pixelPosition } from "./css/support";
import { css, cssHooks, fn } from "./css";
import { parseFloatValue } from "./js-host.lil";

struct OffsetHooks {
  JsValue setOffset;
}

struct OffsetCoords {
  JsValue top;
  JsValue left;
}

float num(JsValue value) {
  return JS.assume(value);
}

string str(JsValue value) {
  return JS.assume(value);
}

void setOffset(JsValue elem, JsValue options, JsValue i) {
  JsValue position = css(elem, "position");
  JsValue curElem = wrap(elem);
  JsValue props = JS.object();
  JsValue curTop = JS.undefined();
  JsValue curLeft = JS.undefined();

  if (JS.strictEqual(position, "static")) {
    elem["style"]["position"] = "relative";
  }

  JsValue curOffset = JS.invoke(curElem, "offset");
  JsValue curCSSTop = css(elem, "top");
  JsValue curCSSLeft = css(elem, "left");

  if ((JS.strictEqual(position, "absolute") || JS.strictEqual(position, "fixed")) &&
    str(JS.add(curCSSTop, curCSSLeft)).indexOf("auto") > -1) {
    JsValue curPosition = JS.invoke(curElem, "position");
    curTop = curPosition["top"];
    curLeft = curPosition["left"];
  } else {
    curTop = JS.or(parseFloatValue(JS.assume(curCSSTop)), 0.0);
    curLeft = JS.or(parseFloatValue(JS.assume(curCSSLeft)), 0.0);
  }

  if (isFunction(options)) {
    options = JS.call(options, elem, i, OffsetCoords{curOffset["top"], curOffset["left"]});
  }

  if (!JS.isNullish(options["top"])) {
    props["top"] = num(options["top"]) - num(curOffset["top"]) + num(curTop);
  }
  if (!JS.isNullish(options["left"])) {
    props["left"] = num(options["left"]) - num(curOffset["left"]) + num(curLeft);
  }

  if (JS.in("using", options)) {
    JS.call(options["using"], elem, props);
  } else {
    JS.invoke(curElem, "css", props);
  }
}

jQuery["offset"] = OffsetHooks{setOffset};

JsValue fnOffset(JsValue options) {
  if (arguments.length > 0.0) {
    if (JS.isUndefined(options)) {
      return this;
    }
    return each(this, (JsValue i, JsValue elem) => {
      setOffset(elem, options, i);
      return JS.undefined();
    });
  }

  JsValue elem = this[0];
  if (!elem.truthy()) {
    return JS.undefined();
  }
  if (!JS.invoke(elem, "getClientRects")["length"].truthy()) {
    return OffsetCoords{0.0, 0.0};
  }

  JsValue rect = JS.invoke(elem, "getBoundingClientRect");
  JsValue win = elem["ownerDocument"]["defaultView"];
  return OffsetCoords{
    JS.add(rect["top"], win["pageYOffset"]),
    JS.add(rect["left"], win["pageXOffset"])
  };
}

JsValue fnPosition() {
  JsValue elem = this[0];
  if (!elem.truthy()) {
    return JS.undefined();
  }

  JsValue offset = JS.undefined();
  JsValue parentOffset = OffsetCoords{0.0, 0.0};

  if (JS.strictEqual(css(elem, "position"), "fixed")) {
    offset = JS.invoke(elem, "getBoundingClientRect");
  } else {
    offset = JS.invoke(this, "offset");

    JsValue doc = elem["ownerDocument"];
    JsValue offsetParent = JS.or(elem["offsetParent"], doc["documentElement"]);
    while (offsetParent.truthy() &&
      (offsetParent == doc["body"] || offsetParent == doc["documentElement"]) &&
      JS.strictEqual(css(offsetParent, "position"), "static")) {
      offsetParent = offsetParent["parentNode"];
    }
    if (offsetParent.truthy() && offsetParent != elem && JS.strictEqual(offsetParent["nodeType"], 1.0)) {
      parentOffset = JS.invoke(wrap(offsetParent), "offset");
      parentOffset["top"] = JS.add(parentOffset["top"], css(offsetParent, "borderTopWidth", true));
      parentOffset["left"] = JS.add(parentOffset["left"], css(offsetParent, "borderLeftWidth", true));
    }
  }

  return OffsetCoords{
    num(offset["top"]) - num(parentOffset["top"]) - num(css(elem, "marginTop", true)),
    num(offset["left"]) - num(parentOffset["left"]) - num(css(elem, "marginLeft", true))
  };
}

JsValue fnOffsetParent() {
  return JS.invoke(this, "map", (JsValue _i, JsValue elem) => {
    JsValue offsetParent = elem["offsetParent"];
    while (offsetParent.truthy() && JS.strictEqual(css(offsetParent, "position"), "static")) {
      offsetParent = offsetParent["offsetParent"];
    }
    return JS.or(offsetParent, documentElement);
  });
}

fn["offset"] = fnOffset;
fn["position"] = fnPosition;
fn["offsetParent"] = fnOffsetParent;

void scrollMethod(string method, string prop) {
  bool top = prop == "pageYOffset";
  fn[method] = JS.methodRest((JsValue self, JsValue args) => {
    return access(self, (JsValue elem, JsValue _method, JsValue val) => {
      JsValue win = JS.undefined();
      if (isWindow(elem)) {
        win = elem;
      } else if (JS.strictEqual(elem["nodeType"], 9.0)) {
        win = elem["defaultView"];
      }

      if (JS.isUndefined(val)) {
        return if (win.truthy()) { win[prop] } else { elem[method] };
      }

      if (win.truthy()) {
        JS.invoke(win, "scrollTo",
          if (top) { win["pageXOffset"] } else { val },
          if (top) { val } else { win["pageYOffset"] });
      } else {
        elem[method] = val;
      }
      return JS.undefined();
    }, method, args[0], args.length > 0.0, JS.undefined(), false);
  });
}

scrollMethod("scrollLeft", "pageXOffset");
scrollMethod("scrollTop", "pageYOffset");

void edgeHook(string prop) {
  cssHooks[prop] = addGetHookIf(pixelPosition, (JsValue elem, JsValue computed) => {
    if (computed.truthy()) {
      computed = curCSS(elem, prop);
      return if (JS.regexTest(rnumnonpx, computed)) { JS.add(JS.invoke(wrap(elem), "position")[prop], "px") } else { computed };
    }
    return JS.undefined();
  });
}

edgeHook("top");
edgeHook("left");

export { jQuery };
