extern JsValue this;
import { jQuery, isPlainObject, makeArray, each, map, wrap } from "./core";
import { toType } from "./core/toType";
import { rcheckableType } from "./var/rcheckableType";
import { isFunction } from "./var/isFunction";
import { prop } from "./attributes/prop";

Regex rbracket = new Regex("\\[\\]$");
Regex rCRLF = new Regex("\\r?\\n", "g");
Regex rsubmitterTypes = new Regex("^(?:submit|button|image|reset|file)$", "i");
Regex rsubmittable = new Regex("^(?:input|select|textarea|keygen)", "i");

void buildParams(JsValue prefix, JsValue obj, JsValue traditional, JsValue add) {
  if (JS.isArray(obj)) {
    each(obj, (JsValue i, JsValue v) => {
      if (traditional.truthy() || JS.invoke(rbracket, "test", prefix).truthy()) {
        add(prefix, v);
      } else {
        buildParams(
          JS.add(JS.add(JS.add(prefix, "["), if (JS.typeOf(v) == "object" && !JS.isNullish(v)) { i } else { "" }), "]"),
          v,
          traditional,
          add
        );
      }
      return JS.undefined();
    });
  } else if (!traditional.truthy() && toType(obj) == "object") {
    for (string name in obj) {
      buildParams(JS.add(JS.add(JS.add(prefix, "["), name), "]"), obj[name], traditional, add);
    }
  } else {
    add(prefix, obj);
  }
}

export JsValue param(JsValue a, JsValue traditional) {
  string[] s = [];
  JsValue add = (JsValue key, JsValue valueOrFunction) => {
    JsValue value = if (isFunction(valueOrFunction)) { valueOrFunction() } else { valueOrFunction };
    s.push(JS.encodeURIComponent(JS.assume(key)) + "=" + JS.encodeURIComponent(JS.assume(if (JS.isNullish(value)) { "" } else { value })));
    return JS.undefined();
  };

  if (JS.isNullish(a)) {
    return "";
  }

  if (JS.isArray(a) || (a["jquery"].truthy() && !isPlainObject(a))) {
    each(a, (JsValue _i, JsValue elem) => {
      add(elem["name"], elem["value"]);
      return JS.undefined();
    });
  } else {
    for (string prefix in a) {
      buildParams(prefix, a[prefix], traditional, add);
    }
  }

  return s.join("&");
}

jQuery["param"] = param;

JsValue fnSerialize() {
  return param(JS.invoke(this, "serializeArray"), JS.undefined());
}

JsValue serializeValue = (JsValue _i, JsValue elem) => {
  JsValue val = JS.invoke(wrap(elem), "val");
  if (JS.isNullish(val)) {
    return null;
  }
  if (JS.isArray(val)) {
    return map(val, (JsValue v, JsValue _j, JsValue _arg) => object { name: elem["name"], value: JS.invoke(v, "replace", rCRLF, "\r\n") });
  }
  return object { name: elem["name"], value: JS.invoke(val, "replace", rCRLF, "\r\n") };
};

JsValue fnSerializeArray() {
  JsValue elems = JS.invoke(JS.invoke(this, "map", (JsValue _i, JsValue elem) => {
    JsValue elements = prop(elem, "elements", JS.undefined());
    return if (elements.truthy()) { makeArray(elements) } else { elem };
  }), "filter", (JsValue _i, JsValue elem) => {
    JsValue type = elem["type"];
    return JS.and(
      JS.and(
        JS.and(
          JS.and(elem["name"], !JS.invoke(wrap(elem), "is", ":disabled").truthy()),
          JS.invoke(rsubmittable, "test", elem["nodeName"])
        ),
        !JS.invoke(rsubmitterTypes, "test", type).truthy()
      ),
      JS.or(elem["checked"], !JS.invoke(rcheckableType, "test", type).truthy())
    );
  });
  return JS.invoke(JS.invoke(elems, "map", serializeValue), "get");
}

JsValue fn = jQuery["fn"];
fn["serialize"] = fnSerialize;
fn["serializeArray"] = fnSerializeArray;

export { jQuery };
