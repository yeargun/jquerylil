{
  "name": "@itslil/jquery",
  "version": "3.7.1",
  "description": "jQuery 3.7.1 reimplemented in LilScript. Drop-in ESM/CJS/UMD runtime.",
  "keywords": [
    "jquery",
    "dom",
    "ajax",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/jquerylil/",
  "bugs": "https://github.com/yeargun/jquerylil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/jquerylil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/jquery.cjs",
  "module": "./dist/jquery.esm.js",
  "types": "./dist/jquery.d.ts",
  "unpkg": "./dist/jquery.umd.js",
  "jsdelivr": "./dist/jquery.umd.js",
  "exports": {
    ".": {
      "types": "./dist/jquery.d.ts",
      "import": "./dist/jquery.esm.js",
      "require": "./dist/jquery.cjs",
      "default": "./dist/jquery.esm.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "dist/jquery.esm.js",
    "dist/jquery.cjs",
    "dist/jquery.umd.js",
    "dist/jquery.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "node --test test/compat.test.mjs",
    "bench": "node scripts/bench.mjs",
    "measure": "node scripts/measure.mjs",
    "record": "node scripts/record-compiler-run.mjs",
    "examples": "node examples/serve.mjs",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:names": "node scripts/audit-names.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "node --test test/compat.test.mjs && npm run check:names && npm run check:pack && npm run check:site"
  },
  "devDependencies": {
    "@types/jquery": "^3.5.33",
    "esbuild": "^0.25.8",
    "jquery": "3.7.1",
    "jsdom": "^26.1.0",
    "vite": "^6.4.3"
  }
}
